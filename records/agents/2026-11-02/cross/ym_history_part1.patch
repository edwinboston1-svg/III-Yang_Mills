@@ -0,0 +1,381 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage A5 (second landing): THE INFINITE-VOLUME WILSON LOOP EXISTS.
+
+  The lattice is any set of links E with plaquettes P, each plaquette a finite set of links; nothing is finite.
+  The Wilson expectation on a finite box Λ ⊆ P is written in the combinatorial form the character expansion gave
+  (Griffiths.lean, `expect_eq_Wc`): surfaces inside Λ bounded by A over closed surfaces inside Λ.  Three facts carry
+  it to infinity: a coupling of zero is an absent plaquette, so the box's expectation is the bigger box's at the
+  cut couplings (THE RESTRICTION); the finite box is a finite configuration model, where Griffiths II made every
+  expectation nondecreasing in every coupling (THE BRIDGE and THE MONOTONICITY); and a nondecreasing sequence
+  bounded by one converges to its supremum (THE LIMIT).  Hence W_∞(A) = sup_Λ W_Λ(A) exists and every exhausting
+  sequence of boxes reaches it: Mechanism S, the first half, proved for III's Z₂ weights.  No sorry, no axiom.
+-/
+import Mathlib
+import Aperanton.Griffiths
+
+open Finset Filter Topology
+
+set_option maxHeartbeats 800000
+
+namespace Aperanton
+
+variable {E : Type*} {P : Type*} [DecidableEq E] [DecidableEq P]
+
+/-- the indicator of a plaquette's finite link set -/
+def toInd (plaqF : P → Finset E) : P → E → Bool := fun p e => decide (e ∈ plaqF p)
+
+/-- the links touched by a box of plaquettes -/
+def linksOf (plaqF : P → Finset E) (Λ : Finset P) : Finset E := Λ.biUnion plaqF
+
+/-- the boundary of a set of plaquettes on any lattice: the links covered an odd number of times -/
+def bdL (plaq : P → E → Bool) (t : Finset P) : E → Bool :=
+  fun e => decide (Odd (t.filter (fun p => plaq p e = true)).card)
+
+/-- on a finite lattice the two boundaries are one definition -/
+theorem bdL_eq_bd [Fintype E] [Fintype P] (plaq : P → E → Bool) (t : Finset P) : bdL plaq t = bd plaq t := rfl
+
+open Classical in
+/-- THE WILSON EXPECTATION ON A BOX, combinatorial form: surfaces bounded by A over closed surfaces, inside Λ -/
+noncomputable def WcL (plaq : P → E → Bool) (y : P → ℝ) (Λ : Finset P) (A : E → Bool) : ℝ :=
+  (∑ t ∈ Λ.powerset, if bdL plaq t = A then ∏ p ∈ t, y p else 0)
+    / (∑ t ∈ Λ.powerset, if bdL plaq t = (fun _ => false) then ∏ p ∈ t, y p else 0)
+
+/-- the couplings cut to a box -/
+def cut (y : P → ℝ) (Λ : Finset P) : P → ℝ := fun p => if p ∈ Λ then y p else 0
+
+theorem cut_nonneg (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (Λ : Finset P) : ∀ p, 0 ≤ cut y Λ p := by
+  intro p; unfold cut; split_ifs; · exact hy0 p
+  · exact le_rfl
+
+theorem cut_le (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (Λ : Finset P) : ∀ p, cut y Λ p ≤ y p := by
+  intro p; unfold cut; split_ifs; · exact le_rfl
+  · exact hy0 p
+
+theorem cut_zero_outside (y : P → ℝ) (Λ : Finset P) : ∀ p, p ∉ Λ → cut y Λ p = 0 := by
+  intro p hp; simp [cut, hp]
+
+/-- THE RESTRICTION: couplings vanishing outside the smaller box make the bigger box's expectation the smaller's -/
+theorem WcL_restrict (plaq : P → E → Bool) (y : P → ℝ) {Λ Λ' : Finset P} (h : Λ ⊆ Λ')
+    (hy : ∀ p, p ∉ Λ → y p = 0) (A : E → Bool) : WcL plaq y Λ' A = WcL plaq y Λ A := by
+  classical
+  unfold WcL
+  have key : ∀ B : E → Bool,
+      (∑ t ∈ Λ'.powerset, if bdL plaq t = B then ∏ p ∈ t, y p else 0)
+        = ∑ t ∈ Λ.powerset, if bdL plaq t = B then ∏ p ∈ t, y p else 0 := by
+    intro B
+    symm
+    apply Finset.sum_subset (Finset.powerset_mono.mpr h)
+    intro t ht hnot
+    rw [Finset.mem_powerset] at ht hnot
+    obtain ⟨p, hp, hpΛ⟩ : ∃ p ∈ t, p ∉ Λ := by
+      by_contra hc
+      push Not at hc
+      exact hnot (fun p hp => hc p hp)
+    have hz : ∏ q ∈ t, y q = 0 := Finset.prod_eq_zero hp (hy p hpΛ)
+    rw [hz]
+    simp
+  rw [key A, key (fun _ => false)]
+
+/-- cutting the couplings to the box changes nothing on the box -/
+theorem WcL_cut (plaq : P → E → Bool) (y : P → ℝ) (Λ : Finset P) (A : E → Bool) :
+    WcL plaq (cut y Λ) Λ A = WcL plaq y Λ A := by
+  classical
+  unfold WcL
+  have key : ∀ t ∈ Λ.powerset, ∏ p ∈ t, cut y Λ p = ∏ p ∈ t, y p := by
+    intro t ht
+    apply Finset.prod_congr rfl
+    intro p hp
+    simp [cut, Finset.mem_powerset.mp ht hp]
+  have h2 : ∀ B : E → Bool,
+      (∑ t ∈ Λ.powerset, if bdL plaq t = B then ∏ p ∈ t, cut y Λ p else 0)
+        = ∑ t ∈ Λ.powerset, if bdL plaq t = B then ∏ p ∈ t, y p else 0 := by
+    intro B
+    apply Finset.sum_congr rfl
+    intro t ht
+    rw [key t ht]
+  rw [h2 A, h2 (fun _ => false)]
+
+/-- a surface inside the box has its boundary inside the box's links -/
+theorem bdL_subset_links (plaqF : P → Finset E) {Λ : Finset P} {t : Finset P} (ht : t ⊆ Λ) (e : E)
+    (he : e ∉ linksOf plaqF Λ) : bdL (toInd plaqF) t e = false := by
+  unfold bdL
+  have hf : t.filter (fun p => toInd plaqF p e = true) = ∅ := by
+    apply Finset.filter_eq_empty_iff.mpr
+    intro p hp hpe
+    apply he
+    unfold linksOf
+    rw [Finset.mem_biUnion]
+    exact ⟨p, ht hp, by simpa [toInd] using hpe⟩
+  rw [hf]
+  simp
+
+/-- a box too small for the loop carries no surface bounded by it: the expectation is zero -/
+theorem WcL_eq_zero_of_not_subset (plaqF : P → Finset E) (y : P → ℝ) (Λ : Finset P) (A : E → Bool)
+    (hA : ¬ ∀ e, A e = true → e ∈ linksOf plaqF Λ) : WcL (toInd plaqF) y Λ A = 0 := by
+  classical
+  unfold WcL
+  push Not at hA
+  obtain ⟨e, he, heΛ⟩ := hA
+  have key : ∀ t ∈ Λ.powerset, (if bdL (toInd plaqF) t = A then ∏ p ∈ t, y p else 0) = 0 := by
+    intro t ht
+    rw [if_neg]
+    intro hb
+    have := congrFun hb e
+    rw [bdL_subset_links plaqF (Finset.mem_powerset.mp ht) e heΛ] at this
+    rw [he] at this
+    exact Bool.false_ne_true this
+  rw [Finset.sum_eq_zero key, zero_div]
+
+/-- THE BRIDGE: the box's combinatorial expectation is the configuration expectation of the finite model on the
+box's own plaquettes and links -/
+theorem WcL_eq_Wc (plaqF : P → Finset E) (y : P → ℝ) (Λ : Finset P) (A : E → Bool)
+    (hA : ∀ e, A e = true → e ∈ linksOf plaqF Λ) :
+    WcL (toInd plaqF) y Λ A
+      = Wc (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) (fun p => y p.1) Finset.univ
+          (fun e => A e.1) := by
+  classical
+  unfold WcL Wc
+  -- the boundary of a surface read on the box's links agrees with the lattice boundary
+  have hbd : ∀ (t₀ : Finset ↥Λ) (e : ↥(linksOf plaqF Λ)),
+      bd (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) t₀ e
+        = bdL (toInd plaqF) (t₀.map (Function.Embedding.subtype _)) e.1 := by
+    intro t₀ e
+    simp only [bd, bdL, Finset.filter_map, Finset.card_map]
+    rfl
+  have hmem : ∀ t₀ : Finset ↥Λ, t₀.map (Function.Embedding.subtype _) ⊆ Λ := by
+    intro t₀ p hp
+    rw [Finset.mem_map] at hp
+    obtain ⟨q, -, rfl⟩ := hp
+    exact q.2
+  have hiff : ∀ t₀ : Finset ↥Λ,
+      (bdL (toInd plaqF) (t₀.map (Function.Embedding.subtype _)) = A
+        ↔ bd (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) t₀ = fun e => A e.1) := by
+    intro t₀
+    constructor
+    · intro h
+      funext e
+      rw [hbd, h]
+    · intro h
+      funext e
+      by_cases he : e ∈ linksOf plaqF Λ
+      · have := congrFun h ⟨e, he⟩
+        rw [hbd] at this
+        exact this
+      · rw [bdL_subset_links plaqF (hmem t₀) e he]
+        by_contra hc
+        have : A e = true := by
+          rcases Bool.eq_false_or_eq_true (A e) with h1 | h1
+          · exact h1
+          · exact absurd h1.symm hc
+        exact he (hA e this)
+  -- the two sums correspond under t ↦ t.subtype, t₀ ↦ t₀.map
+  have hleft : ∀ t ∈ Λ.powerset, (t.subtype (· ∈ Λ)).map (Function.Embedding.subtype _) = t := by
+    intro t ht
+    rw [Finset.subtype_map]
+    exact Finset.filter_true_of_mem (fun p hp => Finset.mem_powerset.mp ht hp)
+  have hright : ∀ t₀ : Finset ↥Λ, (t₀.map (Function.Embedding.subtype _)).subtype (· ∈ Λ) = t₀ := by
+    intro t₀
+    ext x
+    rw [Finset.mem_subtype]
+    exact Finset.mem_map' _
+  have hprod : ∀ t ∈ Λ.powerset, ∏ p ∈ t.subtype (· ∈ Λ), y p.1 = ∏ p ∈ t, y p := by
+    intro t ht
+    conv_rhs => rw [← hleft t ht]
+    rw [Finset.prod_map]
+    rfl
+  have key : ∀ B : E → Bool, (∀ e, B e = true → e ∈ linksOf plaqF Λ) →
+      (∑ t ∈ Λ.powerset, if bdL (toInd plaqF) t = B then ∏ p ∈ t, y p else 0)
+        = ∑ t₀ ∈ (Finset.univ : Finset ↥Λ).powerset,
+            if bd (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) t₀ = (fun e => B e.1)
+            then ∏ p ∈ t₀, y p.1 else 0 := by
+    intro B hB
+    have hiffB : ∀ t₀ : Finset ↥Λ,
+        (bdL (toInd plaqF) (t₀.map (Function.Embedding.subtype _)) = B
+          ↔ bd (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) t₀ = fun e => B e.1) := by
+      intro t₀
+      constructor
+      · intro h
+        funext e
+        rw [hbd, h]
+      · intro h
+        funext e
+        by_cases he : e ∈ linksOf plaqF Λ
+        · have := congrFun h ⟨e, he⟩
+          rw [hbd] at this
+          exact this
+        · rw [bdL_subset_links plaqF (hmem t₀) e he]
+          by_contra hc
+          have : B e = true := by
+            rcases Bool.eq_false_or_eq_true (B e) with h1 | h1
+            · exact h1
+            · exact absurd h1.symm hc
+          exact he (hB e this)
+    refine Finset.sum_bij' (fun t _ => t.subtype (· ∈ Λ)) (fun t₀ _ => t₀.map (Function.Embedding.subtype _))
+      (fun t _ => Finset.mem_powerset.mpr (Finset.subset_univ _))
+      (fun t₀ _ => Finset.mem_powerset.mpr (hmem t₀)) (fun t ht => hleft t ht) (fun t₀ _ => hright t₀) ?_
+    intro t ht
+    have hb := hiffB (t.subtype (· ∈ Λ))
+    rw [hleft t ht] at hb
+    by_cases h : bdL (toInd plaqF) t = B
+    · rw [if_pos h, if_pos (hb.mp h), hprod t ht]
+    · rw [if_neg h, if_neg (fun h' => h (hb.mpr h'))]
+  rw [key A hA, key (fun _ => false) (fun e he => absurd he Bool.false_ne_true)]
+
+/-- the box expectation is nonnegative: every term of both sums is, and the denominator's empty term is one -/
+theorem WcL_nonneg (plaq : P → E → Bool) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (Λ : Finset P) (A : E → Bool) :
+    0 ≤ WcL plaq y Λ A := by
+  classical
+  unfold WcL
+  apply div_nonneg
+  · apply Finset.sum_nonneg
+    intro t _
+    split_ifs
+    · exact Finset.prod_nonneg (fun p _ => hy0 p)
+    · exact le_rfl
+  · apply Finset.sum_nonneg
+    intro t _
+    split_ifs
+    · exact Finset.prod_nonneg (fun p _ => hy0 p)
+    · exact le_rfl
+
+/-- THE BRIDGE TO THE EXPECTATION: the box expectation is the finite model's configuration expectation -/
+theorem WcL_eq_expect (plaqF : P → Finset E) (y : P → ℝ) (Λ : Finset P) (A : E → Bool)
+    (hA : ∀ e, A e = true → e ∈ linksOf plaqF Λ) :
+    WcL (toInd plaqF) y Λ A
+      = expect (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) (fun p => y p.1) (fun e => A e.1) := by
+  rw [expect_eq_Wc]
+  exact WcL_eq_Wc plaqF y Λ A hA
+
+/-- the box expectation is at most one (through the bridge: it is a configuration expectation) -/
+theorem WcL_le_one (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    (Λ : Finset P) (A : E → Bool) : WcL (toInd plaqF) y Λ A ≤ 1 := by
+  by_cases hA : ∀ e, A e = true → e ∈ linksOf plaqF Λ
+  · rw [WcL_eq_expect plaqF y Λ A hA]
+    exact expect_le_one (fun (p : ↥Λ) (e : ↥(linksOf plaqF Λ)) => toInd plaqF p.1 e.1) (fun p => y p.1)
+      (fun (p : ↥Λ) => hy0 p.1) (fun (p : ↥Λ) => hy1 p.1) (fun e => A e.1)
+  · rw [WcL_eq_zero_of_not_subset plaqF y Λ A hA]
+    exact zero_le_one
+
+theorem linksOf_mono (plaqF : P → Finset E) {Λ Λ' : Finset P} (h : Λ ⊆ Λ') :
+    linksOf plaqF Λ ⊆ linksOf plaqF Λ' := Finset.biUnion_subset_biUnion_of_subset_left _ h
+
+/-- THE MONOTONICITY IN THE BOX: a loop inside a box has a larger expectation in every larger box -/
+theorem WcL_mono_box (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    {Λ Λ' : Finset P} (h : Λ ⊆ Λ') (A : E → Bool) (hA : ∀ e, A e = true → e ∈ linksOf plaqF Λ) :
+    WcL (toInd plaqF) y Λ A ≤ WcL (toInd plaqF) y Λ' A := by
+  have hA' : ∀ e, A e = true → e ∈ linksOf plaqF Λ' := fun e he => linksOf_mono plaqF h (hA e he)
+  have h1 : WcL (toInd plaqF) y Λ A = WcL (toInd plaqF) (cut y Λ) Λ' A := by
+    rw [WcL_restrict (toInd plaqF) (cut y Λ) h (cut_zero_outside y Λ) A, WcL_cut]
+  have h2 := WcL_eq_expect plaqF (cut y Λ) Λ' A hA'
+  have h3 := WcL_eq_expect plaqF y Λ' A hA'
+  have h4 := expect_mono (fun (p : ↥Λ') (e : ↥(linksOf plaqF Λ')) => toInd plaqF p.1 e.1)
+    (fun (p : ↥Λ') => cut y Λ p.1) (fun (p : ↥Λ') => y p.1) (fun (p : ↥Λ') => cut_nonneg y hy0 Λ p.1)
+    (fun (p : ↥Λ') => cut_le y hy0 Λ p.1) (fun (p : ↥Λ') => hy1 p.1) (fun e => A e.1)
+  rw [h1, h2, h3]
+  exact h4
+
+/-- THE INFINITE-VOLUME WILSON EXPECTATION: the supremum over every finite box -/
+noncomputable def Winf (plaqF : P → Finset E) (y : P → ℝ) (A : E → Bool) : ℝ :=
+  ⨆ Λ : Finset P, WcL (toInd plaqF) y Λ A
+
+theorem bddAbove_WcL (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    (A : E → Bool) : BddAbove (Set.range fun Λ : Finset P => WcL (toInd plaqF) y Λ A) := by
+  refine ⟨1, ?_⟩
+  rintro _ ⟨Λ, rfl⟩
+  exact WcL_le_one plaqF y hy0 hy1 Λ A
+
+theorem WcL_le_Winf (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    (Λ : Finset P) (A : E → Bool) : WcL (toInd plaqF) y Λ A ≤ Winf plaqF y A :=
+  le_ciSup (bddAbove_WcL plaqF y hy0 hy1 A) Λ
+
+/-- THE INFINITE-VOLUME LIMIT EXISTS: along every exhausting nondecreasing sequence of boxes the Wilson
+expectation converges, to the supremum over all boxes -- Mechanism S, first half -/
+theorem Winf_tendsto (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    (Λ : ℕ → Finset P) (hmono : Monotone Λ) (hex : ∀ S : Finset P, ∃ n, S ⊆ Λ n) (A : E → Bool)
+    (hA : ∀ e, A e = true → e ∈ linksOf plaqF (Λ 0)) :
+    Tendsto (fun n => WcL (toInd plaqF) y (Λ n) A) atTop (𝓝 (Winf plaqF y A)) := by
+  have hAn : ∀ n, ∀ e, A e = true → e ∈ linksOf plaqF (Λ n) :=
+    fun n e he => linksOf_mono plaqF (hmono (Nat.zero_le n)) (hA e he)
+  have hm : Monotone (fun n => WcL (toInd plaqF) y (Λ n) A) :=
+    fun m n hmn => WcL_mono_box plaqF y hy0 hy1 (hmono hmn) A (hAn m)
+  have hb : BddAbove (Set.range fun n => WcL (toInd plaqF) y (Λ n) A) := by
+    refine ⟨1, ?_⟩
+    rintro _ ⟨n, rfl⟩
+    exact WcL_le_one plaqF y hy0 hy1 (Λ n) A
+  have hlim := tendsto_atTop_ciSup hm hb
+  have hsup : (⨆ n, WcL (toInd plaqF) y (Λ n) A) = Winf plaqF y A := by
+    apply le_antisymm
+    · exact ciSup_le (fun n => WcL_le_Winf plaqF y hy0 hy1 (Λ n) A)
+    · apply ciSup_le
+      intro S
+      by_cases hS : ∀ e, A e = true → e ∈ linksOf plaqF S
+      · obtain ⟨n, hn⟩ := hex S
+        exact le_trans (WcL_mono_box plaqF y hy0 hy1 hn A hS) (le_ciSup hb n)
+      · rw [WcL_eq_zero_of_not_subset plaqF y S A hS]
+        exact le_trans (WcL_nonneg _ y hy0 (Λ 0) A) (le_ciSup hb 0)
+  rw [hsup] at hlim
+  exact hlim
+
+/-- the boundary of an inserted plaquette: the plaquette's links xor the old boundary -/
+theorem bdL_insert (plaq : P → E → Bool) (p : P) (t : Finset P) (hp : p ∉ t) :
+    bdL plaq (insert p t) = fun e => xor (plaq p e) (bdL plaq t e) := by
+  funext e
+  simp only [bdL]
+  by_cases h : plaq p e = true
+  · have hp' : p ∉ t.filter (fun q => plaq q e = true) := fun h' => hp (Finset.mem_filter.mp h').1
+    rw [Finset.filter_insert, if_pos h, Finset.card_insert_of_notMem hp', h, Bool.true_xor, ← decide_not,
+      decide_eq_decide]
+    exact Nat.odd_add_one
+  · rw [Finset.filter_insert, if_neg h]
+    simp [h]
+
+/-- the boundary of a disjoint union is the xor of the boundaries -/
+theorem bdL_union (plaq : P → E → Bool) (s t : Finset P) (hst : Disjoint s t) :
+    bdL plaq (s ∪ t) = fun e => xor (bdL plaq s e) (bdL plaq t e) := by
+  induction t using Finset.induction_on with
+  | empty =>
+    funext e
+    simp [bdL]
+  | @insert p t hp ih =>
+    have hps : p ∉ s := fun h => Finset.disjoint_left.mp hst h (Finset.mem_insert_self p t)
+    have hst' : Disjoint s t := Finset.disjoint_of_subset_right (Finset.subset_insert p t) hst
+    have hpu : p ∉ s ∪ t := by
+      rw [Finset.mem_union]; push Not; exact ⟨hps, hp⟩
+    rw [Finset.union_insert, bdL_insert plaq p (s ∪ t) hpu, ih hst', bdL_insert plaq p t hp]
+    funext e
+    rcases Bool.eq_false_or_eq_true (plaq p e) with h1 | h1 <;>
+      rcases Bool.eq_false_or_eq_true (bdL plaq s e) with h2 | h2 <;>
+      rcases Bool.eq_false_or_eq_true (bdL plaq t e) with h3 | h3 <;> simp [h1, h2, h3]
+
+/-- the support of an xor lies in the union of the supports -/
+theorem xor_support {A B : E → Bool} {S : Finset E} (hA : ∀ e, A e = true → e ∈ S) (hB : ∀ e, B e = true → e ∈ S) :
+    ∀ e, xor (A e) (B e) = true → e ∈ S := by
+  intro e he
+  rcases Bool.eq_false_or_eq_true (A e) with h1 | h1
+  · exact hA e h1
+  · rcases Bool.eq_false_or_eq_true (B e) with h2 | h2
+    · exact hB e h2
+    · rw [h1, h2] at he; exact absurd he (by decide)
+
+/-- GRIFFITHS II IN THE LIMIT: W_∞(A) W_∞(B) ≤ W_∞(A ⊕ B) -/
+theorem Winf_mul_le (plaqF : P → Finset E) (y : P → ℝ) (hy0 : ∀ p, 0 ≤ y p) (hy1 : ∀ p, y p ≤ 1)
+    (Λ : ℕ → Finset P) (hmono : Monotone Λ) (hex : ∀ S : Finset P, ∃ n, S ⊆ Λ n) (A B : E → Bool)
+    (hA : ∀ e, A e = true → e ∈ linksOf plaqF (Λ 0)) (hB : ∀ e, B e = true → e ∈ linksOf plaqF (Λ 0)) :
+    Winf plaqF y A * Winf plaqF y B ≤ Winf plaqF y (fun e => xor (A e) (B e)) := by
+  have hAB : ∀ e, xor (A e) (B e) = true → e ∈ linksOf plaqF (Λ 0) := xor_support hA hB
+  have ta := Winf_tendsto plaqF y hy0 hy1 Λ hmono hex A hA
+  have tb := Winf_tendsto plaqF y hy0 hy1 Λ hmono hex B hB
+  have tab := Winf_tendsto plaqF y hy0 hy1 Λ hmono hex _ hAB
+  refine le_of_tendsto_of_tendsto' (ta.mul tb) tab (fun n => ?_)
+  have hAn : ∀ e, A e = true → e ∈ linksOf plaqF (Λ n) :=
+    fun e he => linksOf_mono plaqF (hmono (Nat.zero_le n)) (hA e he)
+  have hBn : ∀ e, B e = true → e ∈ linksOf plaqF (Λ n) :=
+    fun e he => linksOf_mono plaqF (hmono (Nat.zero_le n)) (hB e he)
+  have hABn : ∀ e, xor (A e) (B e) = true → e ∈ linksOf plaqF (Λ n) := xor_support hAn hBn
+  rw [WcL_eq_expect plaqF y (Λ n) A hAn, WcL_eq_expect plaqF y (Λ n) B hBn,
+    WcL_eq_expect plaqF y (Λ n) (fun e => xor (A e) (B e)) hABn]
+  exact griffiths_two_expect (fun (p : ↥(Λ n)) (e : ↥(linksOf plaqF (Λ n))) => toInd plaqF p.1 e.1)
+    (fun (p : ↥(Λ n)) => y p.1) (fun (p : ↥(Λ n)) => hy0 p.1) (fun (p : ↥(Λ n)) => hy1 p.1)
+    (fun e => A e.1) (fun e => B e.1)
+
+end Aperanton
diff --git a/kernel/aperanton/Aperanton/LinearAction.lean b/kernel/aperanton/Aperanton/LinearAction.lean
new file mode 100644
index 0000000..2382b2e
--- /dev/null
+++ b/kernel/aperanton/Aperanton/LinearAction.lean
@@ -0,0 +1,214 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage A8f: THE LINEAR ACTION -- the representation-theoretic hypotheses of the lattice
+  theorem discharged from a real orthogonal representation, with no Fourier theory.
+
+  GaugeAction.lean's lattice theorem asks, for a general finite group, that the Wilson loop's class matrix
+  X(a, b) = χ(a b⁻¹) be positive semidefinite and kill the constants, and that the link weight's kernel
+  k(a, b) = w(a b⁻¹) be positive semidefinite and positive.  For a REAL ORTHOGONAL representation ρ (ρ(ab) = ρ(a) ρ(b),
+  ρ(a) ρ(a)ᵀ = 1, ρ(1) = 1) all of this is finite linear algebra: ρ(b⁻¹) = ρ(b)ᵀ, so χ(a b⁻¹) = tr(ρ(a) ρ(b)ᵀ) is THE
+  GRAM MATRIX of the vectors ρ(a) ∈ ℝ^{d×d} (`classMat_posSemidef`); the sum P = Σ_g ρ(g) sends every vector to an
+  invariant one, so when ρ has no nonzero invariant vector P = 0 and the class matrix kills the constants
+  (`classMat_mulVec_one`); |χ(g)| ≤ d since the diagonal of an orthogonal matrix lies in [−1, 1] (`abs_char_le`); and
+  THE LINEAR ACTION w(g) = C + χ(g) with C > d is a positive class function whose link kernel C·J + X is positive
+  semidefinite and positive (`linearKernel_posSemidef`, `linearKernel_pos`).  WHAT THE LINEAR ACTION DOES NOT GIVE: W(1) > 0.  Its kernel
+  C·J + X is positive semidefinite, not positive definite, and the loop's one-step correlation ⟨F Ω, M F Ω⟩ is a sum of
+  squared overlaps with products of ρ's coefficients along the endpoint's links -- EXACTLY ZERO when the loop's
+  representation is absent from those short tensor products, and then the lattice theorem says nothing about that
+  loop.  Cite it "for loops with W(1) > 0"; W(1) is a number to compute per instance.  The complex unitary representations
+  enter through their realifications (a d-dimensional unitary representation is a 2d-dimensional orthogonal one with
+  character 2 Re χ), so the real parts of all characters are covered.  No sorry, no axiom.
+-/
+import Mathlib
+import Aperanton.XTransfer
+import Aperanton.GaugeAction
+
+open Matrix
+
+namespace Aperanton
+
+section Orthogonal
+
+variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {d : ℕ}
+
+/-- a real orthogonal representation: multiplicative, unital, orthogonal -/
+structure OrthRep (G : Type*) [Group G] (d : ℕ) where
+  ρ : G → Matrix (Fin d) (Fin d) ℝ
+  map_mul : ∀ a b, ρ (a * b) = ρ a * ρ b
+  map_one : ρ 1 = 1
+  orth : ∀ a, ρ a * (ρ a)ᵀ = 1
+
+/-- the character -/
+def OrthRep.char (R : OrthRep G d) (g : G) : ℝ := (R.ρ g).trace
+
+/-- the inverse is represented by the transpose -/
+theorem OrthRep.map_inv (R : OrthRep G d) (b : G) : R.ρ b⁻¹ = (R.ρ b)ᵀ := by
+  have h1 : R.ρ b * R.ρ b⁻¹ = 1 := by rw [← R.map_mul, mul_inv_cancel, R.map_one]
+  have e1 : (R.ρ b)⁻¹ = R.ρ b⁻¹ := Matrix.inv_eq_right_inv h1
+  have e2 : (R.ρ b)⁻¹ = (R.ρ b)ᵀ := Matrix.inv_eq_right_inv (R.orth b)
+  rw [← e1, e2]
+
+/-- the transpose is a left inverse too -/
+theorem OrthRep.orth' (R : OrthRep G d) (x : G) : (R.ρ x)ᵀ * R.ρ x = 1 := by
+  rw [← R.map_inv, ← R.map_mul, inv_mul_cancel, R.map_one]
+
+/-- the class matrix of the character, χ(a b⁻¹) = tr(ρ(a) ρ(b)ᵀ) -/
+def classMat (R : OrthRep G d) : Matrix G G ℝ := fun a b => R.char (a * b⁻¹)
+
+theorem classMat_eq_trace (R : OrthRep G d) (a b : G) : classMat R a b = (R.ρ a * (R.ρ b)ᵀ).trace := by
+  simp only [classMat, OrthRep.char, R.map_mul, R.map_inv]
+
+/-- THE CLASS MATRIX IS THE GRAM MATRIX OF THE REPRESENTATION MATRICES: χ(a b⁻¹) = Σ_{ij} ρ(a)_{ij} ρ(b)_{ij} -/
+theorem classMat_eq_gram (R : OrthRep G d) (a b : G) :
+    classMat R a b = ∑ p : Fin d × Fin d, R.ρ a p.1 p.2 * R.ρ b p.1 p.2 := by
+  rw [classMat_eq_trace]
+  simp only [Matrix.trace, Matrix.diag, mul_apply, transpose_apply]
+  rw [Fintype.sum_prod_type]
+
+/-- THE CLASS MATRIX IS POSITIVE SEMIDEFINITE -/
+theorem classMat_posSemidef (R : OrthRep G d) : (classMat R).PosSemidef :=
+  posSemidef_of_gram (classMat R) (fun p : Fin d × Fin d => fun a => R.ρ a p.1 p.2) (classMat_eq_gram R)
+
+/-- the averaging operator Σ_g ρ(g) sends every vector to an invariant one -/
+theorem sum_rep_invariant (R : OrthRep G d) (h : G) (u : Fin d → ℝ) :
+    R.ρ h *ᵥ ((∑ g, R.ρ g) *ᵥ u) = (∑ g, R.ρ g) *ᵥ u := by
+  rw [mulVec_mulVec, Finset.mul_sum]
+  congr 1
+  rw [show (∑ g, R.ρ h * R.ρ g) = ∑ g, R.ρ (h * g) from Finset.sum_congr rfl fun g _ => (R.map_mul h g).symm]
+  exact Equiv.sum_comp (Equiv.mulLeft h) R.ρ
+
+/-- WITH NO NONZERO INVARIANT VECTOR, THE AVERAGE OF THE REPRESENTATION VANISHES -/
+theorem sum_rep_eq_zero (R : OrthRep G d) (hinv : ∀ u : Fin d → ℝ, (∀ h, R.ρ h *ᵥ u = u) → u = 0) :
+    (∑ g, R.ρ g) = 0 := by
+  apply Matrix.ext
+  intro i j
+  have hcol : (∑ g, R.ρ g) *ᵥ Pi.single j 1 = 0 :=
+    hinv _ (fun h => sum_rep_invariant R h _)
+  have := congrFun hcol i
+  simpa [mulVec, dotProduct, Pi.single_apply] using this
+
+/-- THE CLASS MATRIX KILLS THE CONSTANTS when ρ has no nonzero invariant vector -/
+theorem classMat_mulVec_one (R : OrthRep G d) (hinv : ∀ u : Fin d → ℝ, (∀ h, R.ρ h *ᵥ u = u) → u = 0) :
+    classMat R *ᵥ (fun _ => (1 : ℝ)) = 0 := by
+  funext a
+  simp only [mulVec, dotProduct, mul_one, Pi.zero_apply]
+  simp only [classMat_eq_trace]
+  rw [← Matrix.trace_sum, ← Finset.mul_sum, ← Matrix.transpose_sum, sum_rep_eq_zero R hinv]
+  simp
+
+/-- the diagonal of an orthogonal matrix lies in [−1, 1], so |χ(g)| ≤ d -/
+theorem abs_char_le (R : OrthRep G d) (g : G) : |R.char g| ≤ d := by
+  have hrow : ∀ i, R.ρ g i i * R.ρ g i i ≤ 1 := by
+    intro i
+    have h := congrFun (congrFun (R.orth g) i) i
+    rw [mul_apply, one_apply_eq] at h
+    rw [← h]
+    have : R.ρ g i i * (R.ρ g)ᵀ i i = R.ρ g i i * R.ρ g i i := by rw [transpose_apply]
+    rw [← this]
+    exact Finset.single_le_sum (f := fun j => R.ρ g i j * (R.ρ g)ᵀ j i)
+      (fun j _ => by rw [transpose_apply]; exact mul_self_nonneg _) (Finset.mem_univ i)
+  have hbound : ∀ i, |R.ρ g i i| ≤ 1 := fun i => by
+    have := sq_le_sq.mp (show (R.ρ g i i) ^ 2 ≤ (1 : ℝ) ^ 2 by rw [one_pow, sq]; exact hrow i)
+    rwa [abs_one] at this
+  calc |R.char g| = |∑ i, R.ρ g i i| := rfl
+    _ ≤ ∑ i, |R.ρ g i i| := Finset.abs_sum_le_sum_abs _ _
+    _ ≤ ∑ i : Fin d, (1 : ℝ) := Finset.sum_le_sum fun i _ => hbound i
+    _ = d := by simp
+
+/-- THE LINEAR ACTION: w(g) = C + χ(g) -/
+def linearW (R : OrthRep G d) (C : ℝ) (g : G) : ℝ := C + R.char g
+
+theorem linearW_classFn (R : OrthRep G d) (C : ℝ) : IsClassFn (linearW R C) := by
+  intro x y
+  simp only [linearW, OrthRep.char, R.map_mul, R.map_inv]
+  congr 1
+  rw [Matrix.trace_mul_comm, ← mul_assoc, R.orth', one_mul]
+
+theorem linearW_pos (R : OrthRep G d) (C : ℝ) (hC : (d : ℝ) < C) (g : G) : 0 < linearW R C g := by
+  have := abs_char_le R g
+  have := neg_abs_le (R.char g)
+  simp only [linearW]
+  linarith
+
+/-- the link kernel of the linear action is C·J + the class matrix -/
+theorem linearKernel_eq (R : OrthRep G d) (C : ℝ) :
+    linkKernel (linearW R C) = Matrix.of (fun _ _ => C) + classMat R := by
+  ext a b
+  simp [linkKernel, linearW, classMat, OrthRep.char]
+
+/-- the all-C matrix is positive semidefinite for C ≥ 0 -/
+theorem constMat_posSemidef (C : ℝ) (hC : 0 ≤ C) : (Matrix.of (fun _ _ : G => C)).PosSemidef :=
+  posSemidef_of_gram (Matrix.of (fun _ _ : G => C)) (fun _ : Unit => fun _ => Real.sqrt C)
+    (fun a b => by simp [Real.mul_self_sqrt hC])
+
+/-- THE LINK KERNEL OF THE LINEAR ACTION IS POSITIVE SEMIDEFINITE for C ≥ 0 -/
+theorem linearKernel_posSemidef (R : OrthRep G d) (C : ℝ) (hC : 0 ≤ C) :
+    (linkKernel (linearW R C)).PosSemidef := by
+  rw [linearKernel_eq]
+  exact (constMat_posSemidef C hC).add (classMat_posSemidef R)
+
+/-- THE LINK KERNEL OF THE LINEAR ACTION IS POSITIVE for C > d -/
+theorem linearKernel_pos (R : OrthRep G d) (C : ℝ) (hC : (d : ℝ) < C) (a b : G) :
+    0 < linkKernel (linearW R C) a b :=
+  linearW_pos R C hC _
+
+end Orthogonal
+
+section LinearLattice
+
+variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {V L : Type*} [DecidableEq V] [Fintype L]
+  [DecidableEq L]
+
+/-- THE LATTICE THEOREM FOR THE LINEAR ACTION, every representation-theoretic hypothesis discharged: for a finite
+group G with real orthogonal representations R' (the in-plane plaquette weight C' + χ_{R'}), R (the x-plaquette weight
+C + χ_R, C > d) and σ (the loop's, with no nonzero invariant vector), on any finite cross-section of square plaquettes
+and any T-line leaving a vertex once, the class matrix of σ has a Gram factorisation φ such that, for every unit Perron
+vector Ω of the transfer matrix, the nonabelian Wilson loop of the x-transfer model converges at every R to
+Σ_j ⟨F_j Ω, M^R F_j Ω⟩ / λ₀^R, and once that sum is positive at R = 1 its static potential is at least the sector's
+gap -/
+theorem linear_lattice_potential_gap {d d' e : ℕ} (Λ : Lat V L) {ι : Type*} [Fintype ι] (sq : ι → Square Λ)
+    (R' : OrthRep G d') (C' : ℝ) (hC' : (d' : ℝ) < C') (R : OrthRep G d) (C : ℝ) (hC : (d : ℝ) < C)
+    (σ : OrthRep G e) (hσ : ∀ u : Fin e → ℝ, (∀ h, σ.ρ h *ᵥ u = u) → u = 0)
+    (ℓ₀ : L) (rest : List L) (v : V) (hsrc : Λ.src ℓ₀ = v) (htgt0 : Λ.tgt ℓ₀ ≠ v)
+    (hsrc' : ∀ ℓ ∈ rest, Λ.src ℓ ≠ v) (htgt' : ∀ ℓ ∈ rest, Λ.tgt ℓ ≠ v) :
+    ∃ φ : G → G → ℝ, (∀ x y, classMat σ x y = ∑ j, φ j x * φ j y) ∧
+      ∀ Ω : (L → G) → ℝ,
+        transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))) *ᵥ Ω =
+          lamMax (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))))
+            (transfer_posSemidef (plaqWeight sq (linearW R' C')) _
+              (tensorKernel_posSemidef (linkKernel (linearW R C)) (linearKernel_posSemidef R C (by linarith [hC, (Nat.cast_nonneg d : (0:ℝ) ≤ d)])))).1 • Ω →
+        Ω ⬝ᵥ Ω = 1 →
+        (∀ Rr : ℕ, Filter.Tendsto (fun a : ℕ =>
+            slabLoop (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C)))
+              (fun c c' => classMat σ (lineHol (ℓ₀ :: rest) c) (lineHol (ℓ₀ :: rest) c')) a Rr /
+            slabZ (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))) (a + 1) Rr)
+          Filter.atTop
+          (nhds (∑ j, (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω) ⬝ᵥ
+              (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))) ^ Rr *ᵥ
+                (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω)) /
+            lamMax (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))))
+              (transfer_posSemidef (plaqWeight sq (linearW R' C')) _
+                (tensorKernel_posSemidef (linkKernel (linearW R C)) (linearKernel_posSemidef R C (by linarith [hC, (Nat.cast_nonneg d : (0:ℝ) ≤ d)])))).1 ^ Rr))) ∧
+        (0 < ∑ j, (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω) ⬝ᵥ
+            (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))) *ᵥ
+              (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω)) →
+          ∃ s : ℝ, 0 < s ∧ Filter.Tendsto (fun Rr : ℕ =>
+            Real.log (lamMax (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))))
+              (transfer_posSemidef (plaqWeight sq (linearW R' C')) _
+                (tensorKernel_posSemidef (linkKernel (linearW R C)) (linearKernel_posSemidef R C (by linarith [hC, (Nat.cast_nonneg d : (0:ℝ) ≤ d)])))).1) -
+            Real.log (∑ j, (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω) ⬝ᵥ
+              (transfer (plaqWeight sq (linearW R' C')) (tensorKernel (linkKernel (linearW R C))) ^ Rr *ᵥ
+                (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω))) / Rr) Filter.atTop (nhds s)) := by
+  have hC0 : (0 : ℝ) ≤ C := by linarith [hC, (Nat.cast_nonneg d : (0:ℝ) ≤ d)]
+  obtain ⟨φ, hφ⟩ := exists_gram (classMat σ) (classMat_posSemidef σ)
+  refine ⟨φ, hφ, fun Ω hΩ hn => ?_⟩
+  have hmain := lattice_potential_gap Λ sq (linearW R' C') (linearW_classFn R' C') (linearW_pos R' C' hC')
+    (linearW R C) (linearW_classFn R C) (linearKernel_posSemidef R C hC0) (linearKernel_pos R C hC)
+    ℓ₀ rest v hsrc htgt0 hsrc' htgt' (classMat σ) (classMat_posSemidef σ) (classMat_mulVec_one σ hσ) φ hφ Ω hΩ hn
+  refine ⟨hmain.1, fun hW1 => ?_⟩
+  obtain ⟨s, hs, -, hlim⟩ := hmain.2 hW1
+  exact ⟨s, hs, hlim⟩
+
+end LinearLattice
+
+
+end Aperanton
diff --git a/kernel/aperanton/Aperanton/MacWilliams.lean b/kernel/aperanton/Aperanton/MacWilliams.lean
new file mode 100644
index 0000000..4fba57d
--- /dev/null
+++ b/kernel/aperanton/Aperanton/MacWilliams.lean
@@ -0,0 +1,236 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage A2: THE MEET IN GENERAL FORM -- MACWILLIAMS FOR COSETS OF A BINARY CODE.
+
+  For a binary linear code K ≤ F₂^n and a word w, the coset weight enumerator  W_{w+K}(X) = Σ_{c ∈ K} X^{wt(w+c)}
+  satisfies  |K^⊥| · W_{w+K}(X) = Σ_{u ∈ K^⊥} (−1)^{u·w} (1 − X)^{wt u} (1 + X)^{n − wt u}.
+  The proof is the character sum over the dual code: Σ_{u ∈ K^⊥} (−1)^{u·v} = |K^⊥| [v ∈ K^⊥⊥] and K^⊥⊥ = K
+  (Mathlib's `orthogonal_orthogonal` for the nondegenerate symmetric dot product on F₂^n), then the product over
+  coordinates.  Α0's T3 (THE MEET of ΞΕΝΟΔΟΧΙΑ's flux record, kernel-checked at 2 × 2 × 2) is the instance with
+  K = im δ¹ and K^⊥ = Z₂(Λ).  MacWilliams 1963 is classical (W = 0); Mathlib carries the orthogonality of
+  bilinear forms and not the identity.  No sorry, no axiom.
+-/
+import Mathlib
+import Aperanton.TheoremT
+
+open Polynomial Finset Matrix
+
+namespace Aperanton
+
+variable {ι : Type*} [Fintype ι] [DecidableEq ι]
+
+/-- the sign of a bit: 0 ↦ 1, 1 ↦ −1 -/
+def sgn2 (b : ZMod 2) : ℤ := if b = 0 then 1 else -1
+
+theorem sgn2_zero : sgn2 0 = 1 := rfl
+
+theorem sgn2_add (a b : ZMod 2) : sgn2 (a + b) = sgn2 a * sgn2 b := by
+  fin_cases a <;> fin_cases b <;> decide
+
+theorem sgn2_sum {α : Type*} (s : Finset α) (f : α → ZMod 2) : sgn2 (∑ i ∈ s, f i) = ∏ i ∈ s, sgn2 (f i) := by
+  classical
+  induction s using Finset.induction_on with
+  | empty => simp [sgn2_zero]
+  | @insert a s ha ih => rw [Finset.sum_insert ha, Finset.prod_insert ha, sgn2_add, ih]
+
+theorem sum_zmod2 (f : ZMod 2 → Polynomial ℤ) : ∑ b : ZMod 2, f b = f 0 + f 1 := by
+  rw [show (Finset.univ : Finset (ZMod 2)) = {0, 1} by decide, Finset.sum_insert (by decide),
+    Finset.sum_singleton]
+
+theorem sum_sgn2_mul (a : ZMod 2) :
+    ∑ b : ZMod 2, (Polynomial.C (sgn2 (a * b)) * (X : Polynomial ℤ) ^ (if b ≠ 0 then 1 else 0))
+      = 1 + Polynomial.C (sgn2 a) * X := by
+  rw [sum_zmod2]
+  rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a with rfl | rfl <;> simp [sgn2]
+
+/-- the character of the dot product: (−1)^{u·v} -/
+def chi2 (u v : ι → ZMod 2) : ℤ := sgn2 (u ⬝ᵥ v)
+
+theorem chi2_add_left (u u' v : ι → ZMod 2) : chi2 (u + u') v = chi2 u v * chi2 u' v := by
+  unfold chi2
+  rw [add_dotProduct, sgn2_add]
+
+theorem chi2_add_right (u v v' : ι → ZMod 2) : chi2 u (v + v') = chi2 u v * chi2 u v' := by
+  unfold chi2
+  rw [dotProduct_add, sgn2_add]
+
+theorem chi2_eq_prod (u v : ι → ZMod 2) : chi2 u v = ∏ i, sgn2 (u i * v i) := by
+  unfold chi2 dotProduct
+  exact sgn2_sum _ _
+
+/-- the orthogonal of a code under the dot product -/
+def orth (K : Submodule (ZMod 2) (ι → ZMod 2)) : Submodule (ZMod 2) (ι → ZMod 2) where
+  carrier := {v | ∀ u ∈ K, u ⬝ᵥ v = 0}
+  zero_mem' := fun u _ => dotProduct_zero u
+  add_mem' := by
+    intro v v' hv hv' u hu
+    rw [dotProduct_add, hv u hu, hv' u hu, add_zero]
+  smul_mem' := by
+    intro c v hv u hu
+    rw [dotProduct_smul, hv u hu, smul_zero]
+
+theorem mem_orth (K : Submodule (ZMod 2) (ι → ZMod 2)) (v : ι → ZMod 2) :
+    v ∈ orth K ↔ ∀ u ∈ K, u ⬝ᵥ v = 0 := Iff.rfl
+
+/-- the dot product as Mathlib's bilinear form, to borrow its double-orthogonal theorem -/
+noncomputable def dotForm : LinearMap.BilinForm (ZMod 2) (ι → ZMod 2) := Matrix.toBilin' 1
+
+theorem dotForm_apply (u v : ι → ZMod 2) : dotForm u v = u ⬝ᵥ v := by
+  simp [dotForm, Matrix.toBilin'_apply']
+
+theorem orth_eq_orthogonal (K : Submodule (ZMod 2) (ι → ZMod 2)) : orth K = dotForm.orthogonal K := by
+  ext v
+  rw [mem_orth, LinearMap.BilinForm.mem_orthogonal_iff]
+  simp only [dotForm_apply]
+
+theorem dotForm_nondegenerate : (dotForm : LinearMap.BilinForm (ZMod 2) (ι → ZMod 2)).Nondegenerate := by
+  have hsep : ∀ v : ι → ZMod 2, (∀ w, dotForm v w = 0) → v = 0 := by
+    intro v hv
+    funext i
+    have := hv (Pi.single i 1)
+    rw [dotForm_apply, dotProduct_single, mul_one] at this
+    exact this
+  show LinearMap.SeparatingLeft _ ∧ LinearMap.SeparatingRight _
+  refine ⟨hsep, ?_⟩
+  intro v hv
+  apply hsep v
+  intro w
+  rw [dotForm_apply, dotProduct_comm, ← dotForm_apply]
+  exact hv w
+
+theorem dotForm_isRefl : (dotForm : LinearMap.BilinForm (ZMod 2) (ι → ZMod 2)).IsRefl := by
+  intro u v h
+  rw [dotForm_apply] at h ⊢
+  rw [dotProduct_comm]
+  exact h
+
+/-- THE DOUBLE ORTHOGONAL IS THE CODE: K^⊥⊥ = K -/
+theorem orth_orth (K : Submodule (ZMod 2) (ι → ZMod 2)) : orth (orth K) = K := by
+  rw [orth_eq_orthogonal, orth_eq_orthogonal]
+  exact LinearMap.BilinForm.orthogonal_orthogonal dotForm_nondegenerate dotForm_isRefl K
+
+open Classical in
+/-- THE CHARACTER SUM OVER A CODE: Σ_{u ∈ H} (−1)^{u·v} = |H| if v ⊥ H, else 0 -/
+theorem sum_chi2 (H : Submodule (ZMod 2) (ι → ZMod 2)) (v : ι → ZMod 2) :
+    ∑ u ∈ univ.filter (· ∈ H), chi2 u v
+      = if v ∈ orth H then ((univ.filter (· ∈ H)).card : ℤ) else 0 := by
+  split_ifs with h
+  · rw [mem_orth] at h
+    rw [Finset.sum_congr rfl (fun u hu => by
+      show chi2 u v = 1
+      unfold chi2
+      rw [h u (mem_filter.mp hu).2, sgn2_zero]), Finset.sum_const, nsmul_eq_mul, mul_one]
+  · rw [mem_orth] at h
+    push Not at h
+    obtain ⟨u₀, hu₀, hne⟩ := h
+    have hsgn : chi2 u₀ v = -1 := by
+      unfold chi2 sgn2
+      rw [if_neg hne]
+    have hinv : ∀ u : ι → ZMod 2, u + u₀ + u₀ = u := by
+      intro u
+      funext i
+      simp only [Pi.add_apply]
+      rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
+    have hS : ∑ u ∈ univ.filter (· ∈ H), chi2 u v = ∑ u ∈ univ.filter (· ∈ H), chi2 (u + u₀) v := by
+      refine Finset.sum_nbij' (fun u => u + u₀) (fun u => u + u₀) ?_ ?_ ?_ ?_ ?_
+      · intro u hu
+        rw [Finset.mem_filter] at hu ⊢
+        exact ⟨Finset.mem_univ _, H.add_mem hu.2 hu₀⟩
+      · intro u hu
+        rw [Finset.mem_filter] at hu ⊢
+        exact ⟨Finset.mem_univ _, H.add_mem hu.2 hu₀⟩
+      · intro u _; exact hinv u
+      · intro u _; exact hinv u
+      · intro u _; rw [hinv u]
+    simp_rw [chi2_add_left, hsgn] at hS
+    rw [← Finset.sum_mul] at hS
+    linarith
+
+/-- the weight as a sum of indicators -/
+theorem wt_eq_sum (v : ι → ZMod 2) : wt v = ∑ i, if v i ≠ 0 then 1 else 0 := by
+  unfold wt
+  rw [Finset.card_filter]
+
+/-- the weight enumerator of all words against a character factors over the coordinates -/
+theorem sum_chi2_pow (u : ι → ZMod 2) :
+    ∑ v : ι → ZMod 2, Polynomial.C (chi2 u v) * (X : Polynomial ℤ) ^ wt v
+      = (1 - X) ^ wt u * (1 + X) ^ (Fintype.card ι - wt u) := by
+  classical
+  have hpt : ∀ v : ι → ZMod 2, Polynomial.C (chi2 u v) * (X : Polynomial ℤ) ^ wt v
+      = ∏ i, (Polynomial.C (sgn2 (u i * v i)) * X ^ (if v i ≠ 0 then 1 else 0)) := by
+    intro v
+    rw [Finset.prod_mul_distrib, chi2_eq_prod, map_prod, wt_eq_sum, Finset.prod_pow_eq_pow_sum]
+  simp_rw [hpt]
+  rw [← Fintype.prod_sum (fun i (b : ZMod 2) => Polynomial.C (sgn2 (u i * b)) * X ^ (if b ≠ 0 then 1 else 0))]
+  simp_rw [sum_sgn2_mul]
+  have hfac : ∀ i, (1 + Polynomial.C (sgn2 (u i)) * (X : Polynomial ℤ))
+      = if u i ≠ 0 then (1 - X) else (1 + X) := by
+    intro i
+    by_cases h : u i = 0
+    · simp [h, sgn2]
+    · simp [h, sgn2, sub_eq_add_neg]
+  simp_rw [hfac]
+  rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const]
+  have h1 : (Finset.univ.filter (fun i => u i ≠ 0)).card = wt u := rfl
+  have h2 : (Finset.univ.filter (fun i => ¬ u i ≠ 0)).card = Fintype.card ι - wt u := by
+    have := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset ι)) (fun i => u i ≠ 0)
+    rw [Finset.card_univ] at this
+    unfold wt
+    omega
+  rw [h1, h2]
+
+open Classical in
+/-- the coset enumerator over all words: Σ_{c ∈ K} X^{wt(w+c)} = Σ_v [v + w ∈ K] X^{wt v} -/
+theorem cosetEnum_eq_sum (K : Submodule (ZMod 2) (ι → ZMod 2)) (w : ι → ZMod 2) :
+    cosetEnum K w = ∑ v : ι → ZMod 2, if v + w ∈ K then (X : Polynomial ℤ) ^ wt v else 0 := by
+  unfold cosetEnum
+  rw [← Finset.sum_filter]
+  refine Finset.sum_nbij' (fun c => w + c) (fun v => v + w) ?_ ?_ ?_ ?_ ?_
+  · intro c hc
+    have : w + c + w = c := by
+      funext i; simp only [Pi.add_apply]; rw [add_comm (w i), add_assoc, CharTwo.add_self_eq_zero, add_zero]
+    rw [Finset.mem_filter] at hc ⊢
+    refine ⟨Finset.mem_univ _, ?_⟩
+    rw [this]; exact hc.2
+  · intro v hv
+    rw [Finset.mem_filter] at hv ⊢
+    exact ⟨Finset.mem_univ _, hv.2⟩
+  · intro c _
+    funext i; simp only [Pi.add_apply]; rw [add_comm (w i), add_assoc, CharTwo.add_self_eq_zero, add_zero]
+  · intro v _
+    funext i; simp only [Pi.add_apply]; rw [add_comm (v i), ← add_assoc, CharTwo.add_self_eq_zero, zero_add]
+  · intro c _; rfl
+
+open Classical in
+/-- MACWILLIAMS FOR COSETS: |K^⊥| · W_{w+K}(X) = Σ_{u ∈ K^⊥} (−1)^{u·w} (1 − X)^{wt u} (1 + X)^{n − wt u} -/
+theorem macwilliams (K : Submodule (ZMod 2) (ι → ZMod 2)) (w : ι → ZMod 2) :
+    ((univ.filter (· ∈ orth K)).card : Polynomial ℤ) * cosetEnum K w
+      = ∑ u ∈ univ.filter (· ∈ orth K),
+          Polynomial.C (chi2 u w) * ((1 - X) ^ wt u * (1 + X) ^ (Fintype.card ι - wt u)) := by
+  rw [cosetEnum_eq_sum, Finset.mul_sum]
+  -- each word's indicator is the character sum over the dual code
+  have hind : ∀ v : ι → ZMod 2,
+      ((univ.filter (· ∈ orth K)).card : Polynomial ℤ) * (if v + w ∈ K then (X : Polynomial ℤ) ^ wt v else 0)
+        = ∑ u ∈ univ.filter (· ∈ orth K), Polynomial.C (chi2 u v) * Polynomial.C (chi2 u w) * X ^ wt v := by
+    intro v
+    have h1 := sum_chi2 (orth K) (v + w)
+    rw [orth_orth] at h1
+    have h2 : ((univ.filter (· ∈ orth K)).card : Polynomial ℤ) * (if v + w ∈ K then (X : Polynomial ℤ) ^ wt v else 0)
+        = Polynomial.C (∑ u ∈ univ.filter (· ∈ orth K), chi2 u (v + w)) * X ^ wt v := by
+      rw [h1]
+      split_ifs
+      · rw [map_natCast]
+      · rw [map_zero, zero_mul, mul_zero]
+    rw [h2, map_sum, Finset.sum_mul]
+    apply Finset.sum_congr rfl
+    intro u _
+    rw [chi2_add_right, map_mul]
+  simp_rw [hind]
+  rw [Finset.sum_comm]
+  apply Finset.sum_congr rfl
+  intro u _
+  rw [← sum_chi2_pow u, Finset.mul_sum]
+  apply Finset.sum_congr rfl
+  intro v _
+  ring
+
+end Aperanton
diff --git a/kernel/aperanton/Aperanton/MassGap.lean b/kernel/aperanton/Aperanton/MassGap.lean
new file mode 100644
index 0000000..eaeb06c
--- /dev/null
+++ b/kernel/aperanton/Aperanton/MassGap.lean
@@ -0,0 +1,39 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage A4 (fourth landing): THE MASS GAP ON EVERY FINITE CROSS-SECTION.
+
+  For an entrywise-positive symmetric transfer matrix the Perron root is simple and strictly dominant (Perron.lean),
+  so on every finite cross-section the gap between the vacuum and every other state is strictly positive:
+  λ₀ − |λ_i| > 0, and in energies log λ₀ − log |λ_i| > 0 whenever λ_i ≠ 0.  This is the mass gap ΤΟΜΕΥΣ brackets
+  (Δ = 3.750210305668 on Z₂ at y = 1/2 on the 2 × 2 cross-section) as a theorem for every finite group, every
+  coupling and every cross-section.  Its uniformity in the cross-section is Α9's goal, stated there and not here.
+  No sorry, no axiom.
+-/
+import Mathlib
+import Aperanton.Perron
+
+open Matrix
+
+namespace Aperanton
+
+variable {n : Type*} [Fintype n] [DecidableEq n] [Nonempty n]
+
+/-- THE MASS GAP ON A FINITE CROSS-SECTION: every eigenvalue other than the Perron root lies strictly below it in
+absolute value -/
+theorem finite_volume_mass_gap (T : Matrix n n ℝ) (hT : T.IsHermitian) (hpos : ∀ i j, 0 < T i j) (i : n)
+    (hi : hT.eigenvalues i ≠ lamMax T hT) : 0 < lamMax T hT - |hT.eigenvalues i| :=
+  sub_pos.mpr (abs_eigenvalue_lt T hT hpos i hi)
+
+/-- the same gap in energies: log λ₀ − log |λ_i| > 0 for every nonzero non-Perron eigenvalue -/
+theorem finite_volume_mass_gap_log (T : Matrix n n ℝ) (hT : T.IsHermitian) (hpos : ∀ i j, 0 < T i j) (i : n)
+    (hi : hT.eigenvalues i ≠ lamMax T hT) (h0 : hT.eigenvalues i ≠ 0) :
+    0 < Real.log (lamMax T hT) - Real.log |hT.eigenvalues i| :=
+  sub_pos.mpr (Real.log_lt_log (abs_pos.mpr h0) (abs_eigenvalue_lt T hT hpos i hi))
+
+/-- the gap is the rate of the residual: with ρ the spectral ratio of Perron.lean, every non-Perron eigenvalue is
+at most ρ λ₀ with ρ < 1 -- the finite-cross-section mass gap is log(1/ρ) > 0 -/
+theorem mass_gap_rate (T : Matrix n n ℝ) (hT : T.IsHermitian) (hpos : ∀ i j, 0 < T i j) :
+    ∃ ρ : ℝ, 0 ≤ ρ ∧ ρ < 1 ∧ ∀ L : ℕ,
+      |(T ^ L).trace - lamMax T hT ^ L| ≤ ((Fintype.card n : ℝ) - 1) * (ρ * lamMax T hT) ^ L :=
+  trace_pow_residual T hT hpos
+
+end Aperanton
diff --git a/kernel/aperanton/Aperanton/Nonabelian.lean b/kernel/aperanton/Aperanton/Nonabelian.lean
new file mode 100644
index 0000000..f0296a0
--- /dev/null
+++ b/kernel/aperanton/Aperanton/Nonabelian.lean
@@ -0,0 +1,459 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage A8d: THE NONABELIAN WILSON LOOP'S STATIC POTENTIAL IS AT LEAST THE GAP.
+
+  THE QUANTITY, NAMED EXACTLY.  The limit lim_R −log W(R, T)/R at FIXED T -- what the earlier files call the string
+  tension σ(T) -- is the STATIC POTENTIAL E(T) of the T-line's sector above the vacuum.  Every bound here is on E(T):
+  E(T) ≥ the window's gap in that sector, in every phase.  The area law -- E(T) ≥ σ∞ T, σ∞ > 0, the string tension
+  proper -- is NOT proved here and is not claimed; it is Α9's question with the uniform gap.
+
+  GapBound.lean bought the gap for an observable ODD under one symmetry.  A nonabelian character is not odd under
+  one gauge transformation but AVERAGES TO ZERO over the endpoint's group: with the Gram factorisation
+  χ(a b⁻¹) = Σ_j φ_j(a) φ_j(b) of the positive semidefinite class matrix X of a REAL class function χ (a real
+  character, or the real part of one), every Gram vector φ_j of a χ that kills the constants (Σ_b χ(b) = 0: a
+  nontrivial one) has Σ_a φ_j(a) = 0 (`exists_gram_sum_zero`: the
+  constants lie in X's kernel and the Gram vectors are eigenvectors of nonzero eigenvalue, orthogonal to them), so
+  F_j = φ_j ∘ h for the T-line's holonomy h has Σ_g F_j(σ_g c) = Σ_a φ_j(a) = 0 under the gauge transformations σ_g
+  at one endpoint (h(σ_g c) = g · h(c)).  A family of M-invariant permutations fixes the Perron line, so an observable
+  whose family-average vanishes has zero Perron mass (`perron_dot_avg`), term by term; the loop's two-point function
+  W(R) = Σ_j ⟨F_j Ω, M^R F_j Ω⟩ is a sum of moment sequences with no Perron mass, and its static potential is
+  E = log λ₀ − log λ_k for a non-Perron λ_k > 0 (`potential_gap_family`): STRICTLY POSITIVE, at least the
+  finite-volume mass gap of the loop's sector (`nonabelian_potential_gap`).  On the slab: the loop's Gibbs sum
+  with the pair weight P(c_a, c_{a+R}) = χ(h(c_a) h(c_{a+R})⁻¹) is Σ_j of the two-point sums of F_j
+  (`pathSumPair_eq_sum`), each converging to ⟨F_j Ω, M^R F_j Ω⟩ / λ₀^R with ONE unit Perron vector Ω
+  (`slab_tendsto'`, the sign of Ω immaterial), so the nonabelian Wilson loop of the x-transfer model converges to
+  the moment sequence whose static potential is at least the gap (`nonabelian_slab_potential_gap`).  The hypotheses
+  stated at their strength: X positive semidefinite (for a real character the Gram matrix of a unitary
+  representation's matrix coefficients; for the real part of a complex one, of the coefficients and their conjugates),
+  X 1 = 0 (nontrivial), the endpoint action (M-invariant, equivariant on h), W(1) > 0 (the transfer matrix
+  injective and some F_j Ω ≠ 0).  No sorry, no axiom.
+-/
+import Mathlib
+import Aperanton.Perron
+import Aperanton.Spectral
+import Aperanton.XTransfer
+import Aperanton.GapBound
+
+open Matrix Filter Topology
+
+namespace Aperanton
+
+section Averaged
+
+variable {n : Type*} [Fintype n] [DecidableEq n]
+
+/-- THE PERRON MASS OF AN OBSERVABLE WHOSE FAMILY-AVERAGE VANISHES IS ZERO: a finite family of permutations fixing M
+fixes the Perron line, and an observable with Σ_g F(σ_g c) = 0 at every c has Σ_c Ω₁(c) F(c) Ω₂(c) = 0 for any two
+Perron eigenvectors -/
+theorem perron_dot_avg [Nonempty n] {ι : Type*} [Fintype ι] [Nonempty ι] (M : Matrix n n ℝ)
+    (hM : M.IsHermitian) (hpos : ∀ i j, 0 < M i j) (σ : ι → Equiv.Perm n)
+    (hinv : ∀ g a b, M (σ g a) (σ g b) = M a b) (F : n → ℝ) (havg : ∀ c, ∑ g, F (σ g c) = 0)
+    (Ω₁ Ω₂ : n → ℝ) (h₁ : M *ᵥ Ω₁ = lamMax M hM • Ω₁) (h₂ : M *ᵥ Ω₂ = lamMax M hM • Ω₂) :
+    Ω₁ ⬝ᵥ (diagonal F *ᵥ Ω₂) = 0 := by
+  obtain ⟨a, hapos, ha, -⟩ := perron_exists M hM hpos
+  obtain ⟨c₁, hc₁⟩ := perron_simple M hM hpos a hapos ha Ω₁ h₁
+  obtain ⟨c₂, hc₂⟩ := perron_simple M hM hpos a hapos ha Ω₂ h₂
+  have hfix : ∀ g x, a (σ g x) = a x := by
+    intro g x
+    have hPa : permMat (σ g) *ᵥ a = a :=
+      perron_symmetric M hM hpos a hapos ha (permMat (σ g)) (permMat_comm (σ g) M (hinv g))
+        (permMat_nonneg (σ g)) (permMat_orth (σ g))
+    have := congrFun hPa x
+    rw [permMat_mulVec] at this
+    exact this
+  have hsum : ∑ x, F x * (a x * a x) = 0 := by
+    have hg : ∀ g : ι, ∑ x, F x * (a x * a x) = ∑ x, F (σ g x) * (a x * a x) := by
+      intro g
+      rw [← Equiv.sum_comp (σ g) (fun x => F x * (a x * a x))]
+      apply Finset.sum_congr rfl
+      intro x _
+      rw [hfix g x]
+    have htot : (Fintype.card ι : ℝ) * ∑ x, F x * (a x * a x) =
+        ∑ g : ι, ∑ x, F (σ g x) * (a x * a x) := by
+      rw [Finset.sum_congr rfl (fun g _ => (hg g).symm), Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
+    rw [Finset.sum_comm] at htot
+    have hz : ∑ x, ∑ g : ι, F (σ g x) * (a x * a x) = 0 := by
+      apply Finset.sum_eq_zero
+      intro x _
+      rw [← Finset.sum_mul, havg x, zero_mul]
+    rw [hz] at htot
+    have hcard : (Fintype.card ι : ℝ) ≠ 0 := by
+      have := Fintype.card_pos (α := ι)
+      positivity
+    exact (mul_eq_zero.mp htot).resolve_left hcard
+  rw [hc₁, hc₂]
+  have hterm : ∀ x, (c₁ • a) x * (diagonal F *ᵥ (c₂ • a)) x = c₁ * c₂ * (F x * (a x * a x)) := by
+    intro x
+    rw [mulVec_diagonal]
+    simp only [Pi.smul_apply, smul_eq_mul]
+    ring
+  unfold dotProduct
+  simp only [hterm]
+  rw [← Finset.mul_sum, hsum, mul_zero]
+
+/-- the Gram vectors of a positive semidefinite X that kills the constants have zero sum: the constants lie in
+X's kernel, and an eigenvector of nonzero eigenvalue is orthogonal to the kernel -/
+theorem exists_gram_sum_zero (X : Matrix n n ℝ) (hX : X.PosSemidef) (h1 : X *ᵥ (fun _ => (1 : ℝ)) = 0) :
+    ∃ φ : n → n → ℝ, (∀ a b, X a b = ∑ j, φ j a * φ j b) ∧ ∀ j, ∑ a, φ j a = 0 := by
+  set U : Matrix n n ℝ := (hX.1.eigenvectorUnitary : Matrix n n ℝ) with hU
+  have hspec : X = U * diagonal hX.1.eigenvalues * star U := by
+    have h := hX.1.spectral_theorem
+    rw [Unitary.conjStarAlgAut_apply] at h
+    simpa [RCLike.ofReal_real_eq_id] using h
+  have hstar : star U = Uᵀ := by rw [star_eq_conjTranspose, conjTranspose_eq_transpose_of_trivial]
+  have hXt : Xᵀ = X := by
+    have h := hX.1.eq
+    rwa [conjTranspose_eq_transpose_of_trivial] at h
+  have hsq : ∀ j, Real.sqrt (hX.1.eigenvalues j) * Real.sqrt (hX.1.eigenvalues j) =
+      hX.1.eigenvalues j := fun j => Real.mul_self_sqrt (hX.eigenvalues_nonneg j)
+  refine ⟨fun j a => Real.sqrt (hX.1.eigenvalues j) * U a j, fun a b => ?_, fun j => ?_⟩
+  · conv_lhs => rw [hspec]
+    simp only [mul_apply, diagonal_apply, hstar, transpose_apply, Finset.sum_mul]
+    rw [Finset.sum_comm]
+    apply Finset.sum_congr rfl
+    intro j _
+    rw [Finset.sum_eq_single j]
+    · rw [if_pos rfl]
+      have hrhs : (Real.sqrt (hX.1.eigenvalues j) * U a j) * (Real.sqrt (hX.1.eigenvalues j) * U b j) =
+          U a j * (Real.sqrt (hX.1.eigenvalues j) * Real.sqrt (hX.1.eigenvalues j)) * U b j := by ring
+      rw [hrhs, hsq j]
+    · intro k _ hk
+      rw [if_neg (Ne.symm hk)]
+      ring
+    · intro h
+      exact absurd (Finset.mem_univ j) h
+  · rw [← Finset.mul_sum]
+    by_cases hμ : hX.1.eigenvalues j = 0
+    · rw [hμ, Real.sqrt_zero, zero_mul]
+    · have hcol : X *ᵥ (fun a => U a j) = hX.1.eigenvalues j • (fun a => U a j) := by
+        have h := hX.1.mulVec_eigenvectorBasis j
+        have hc : ⇑(hX.1.eigenvectorBasis j) = fun a => U a j := by
+          funext a
+          simp [hU, Matrix.IsHermitian.eigenvectorUnitary_apply]
+        rw [hc] at h
+        exact h
+      have hpair : (X *ᵥ (fun a => U a j)) ⬝ᵥ (fun _ => (1 : ℝ)) =
+          (fun a => U a j) ⬝ᵥ (X *ᵥ fun _ => (1 : ℝ)) := by
+        rw [dotProduct_mulVec, ← mulVec_transpose, hXt]
+      rw [hcol, h1, dotProduct_zero, smul_dotProduct, smul_eq_mul] at hpair
+      have hdot : (fun a => U a j) ⬝ᵥ (fun _ => (1 : ℝ)) = 0 :=
+        (mul_eq_zero.mp hpair).resolve_left hμ
+      have : ∑ a, U a j = 0 := by
+        simpa [dotProduct] using hdot
+      rw [this, mul_zero]
+
+/-- THE STATIC POTENTIAL OF A FINITE SUM OF TWO-POINT FUNCTIONS IS AT LEAST THE GAP: W(R) = Σ_j ⟨f_j, M^R f_j⟩ with
+every f_j orthogonal to the Perron line and W(1) > 0 has log λ₀ − log W(R)/R → E > 0, E = log λ₀ − log λ_k for a
+non-Perron λ_k -/
+theorem potential_gap_family [Nonempty n] {ι : Type*} [Fintype ι] (M : Matrix n n ℝ) (hM : M.PosSemidef)
+    (hpos : ∀ i j, 0 < M i j) (f : ι → n → ℝ) (hf : 0 < ∑ j, f j ⬝ᵥ (M *ᵥ f j))
+    (horth : ∀ j, ∀ Ω : n → ℝ, M *ᵥ Ω = lamMax M hM.1 • Ω → Ω ⬝ᵥ f j = 0) :
+    ∃ σ : ℝ, 0 < σ ∧ (∃ k, hM.1.eigenvalues k ≠ lamMax M hM.1 ∧ 0 < hM.1.eigenvalues k ∧
+      σ = Real.log (lamMax M hM.1) - Real.log (hM.1.eigenvalues k)) ∧
+      Tendsto (fun R : ℕ => Real.log (lamMax M hM.1) -
+        Real.log (∑ j, f j ⬝ᵥ ((M ^ R) *ᵥ f j)) / R) atTop (𝓝 σ) := by
+  have hall := fun j => exists_moment_perron M hM.1 hpos (f j)
+  choose m i₀ Ω hm hl hmom hΩeig hne hmi₀ using hall
+  have hx := hM.eigenvalues_nonneg
+  set mm : n → ℝ := fun i => ∑ j, m j i with hmm
+  have hmmnn : ∀ i, 0 ≤ mm i := fun i => Finset.sum_nonneg fun j _ => hm j i
+  have htot : ∀ R : ℕ, ∑ j, f j ⬝ᵥ ((M ^ R) *ᵥ f j) = moment mm hM.1.eigenvalues R := by
+    intro R
+    rw [Finset.sum_congr rfl (fun j _ => hmom j R)]
+    exact moment_sum Finset.univ m hM.1.eigenvalues R
+  have hne_ι : Nonempty ι := by
+    by_contra hcon
+    rw [not_nonempty_iff] at hcon
+    haveI := hcon
+    simp at hf
+  obtain ⟨j₀⟩ := hne_ι
+  have hsame : ∀ j, i₀ j = i₀ j₀ := fun j => perron_index_unique M hM.1 hpos _ _ (hl j) (hl j₀)
+  have hmm0 : mm (i₀ j₀) = 0 := by
+    apply Finset.sum_eq_zero
+    intro j _
+    rw [← hsame j, hmi₀ j, horth j (Ω j) (hΩeig j)]
+    ring
+  have h1 : 0 < moment mm hM.1.eigenvalues 1 := by
+    rw [← htot 1]
+    simpa using hf
+  have hex : ∃ i, 0 < mm i ∧ 0 < hM.1.eigenvalues i := by
+    by_contra hcon
+    push_neg at hcon
+    have : moment mm hM.1.eigenvalues 1 = 0 := by
+      unfold moment
+      apply Finset.sum_eq_zero
+      intro i _
+      rcases (hmmnn i).lt_or_eq with hmi | hmi
+      · have := le_antisymm (hcon i hmi) (hx i)
+        simp [this]
+      · simp [← hmi]
+    linarith
+  obtain ⟨i₁, hm₁, hx₁⟩ := hex
+  obtain ⟨k, hk, hmax⟩ := Finset.exists_max_image (Finset.univ.filter (fun i => 0 < mm i))
+    hM.1.eigenvalues ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm₁⟩⟩
+  have hmk : 0 < mm k := (Finset.mem_filter.mp hk).2
+  have hxk : 0 < hM.1.eigenvalues k :=
+    lt_of_lt_of_le hx₁ (hmax i₁ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm₁⟩))
+  have hki₀ : k ≠ i₀ j₀ := by
+    intro h
+    rw [h, hmm0] at hmk
+    exact lt_irrefl 0 hmk
+  have hkl : hM.1.eigenvalues k ≠ lamMax M hM.1 := fun h =>
+    hki₀ (perron_index_unique M hM.1 hpos k (i₀ j₀) h (hl j₀))
+  have hlt : hM.1.eigenvalues k < lamMax M hM.1 := by
+    have := abs_eigenvalue_lt M hM.1 hpos k hkl
+    rwa [abs_of_pos hxk] at this
+  refine ⟨Real.log (lamMax M hM.1) - Real.log (hM.1.eigenvalues k),
+    sub_pos.mpr (Real.log_lt_log hxk hlt), ⟨k, hkl, hxk, rfl⟩, ?_⟩
+  have hlim := log_moment_div_tendsto mm hM.1.eigenvalues hmmnn hx k hmk hxk
+    (fun i hi => hmax i (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩))
+  have h2 : Tendsto (fun R : ℕ => Real.log (∑ j, f j ⬝ᵥ ((M ^ R) *ᵥ f j)) / R) atTop
+      (𝓝 (Real.log (hM.1.eigenvalues k))) := hlim.congr fun R => by rw [htot R]
+  exact tendsto_const_nhds.sub h2
+
+end Averaged
+
+section Nonabelian
+
+variable {n : Type*} [Fintype n] [DecidableEq n] {G : Type*} [Fintype G] [DecidableEq G] [Group G]
+
+/-- THE NONABELIAN WILSON LOOP'S STATIC POTENTIAL IS AT LEAST THE GAP, abstract: M the transfer matrix (symmetric,
+entrywise positive, positive semidefinite), h the T-line's holonomy into the group, X(a, b) = χ(a b⁻¹) the class
+matrix of a real class function -- positive semidefinite and killing the constants -- and σ_g the gauge
+transformations at one endpoint of the line (M-invariant permutations with h(σ_g c) = g · h(c)).  Then X has a Gram
+factorisation whose vectors F_j = φ_j ∘ h all have zero Perron mass, and the loop's two-point function
+W(R) = Σ_j ⟨F_j Ω, M^R F_j Ω⟩ (Ω any Perron eigenvector), once W(1) > 0, has log λ₀ − log W(R)/R → E > 0 with
+E = log λ₀ − log λ_k for a non-Perron λ_k -/
+theorem nonabelian_potential_gap [Nonempty n] (M : Matrix n n ℝ) (hM : M.PosSemidef)
+    (hpos : ∀ i j, 0 < M i j) (h : n → G) (X : Matrix G G ℝ) (hX : X.PosSemidef)
+    (hX1 : X *ᵥ (fun _ => (1 : ℝ)) = 0) (σ : G → Equiv.Perm n) (hinv : ∀ g a b, M (σ g a) (σ g b) = M a b)
+    (hact : ∀ g c, h (σ g c) = g * h c) :
+    ∃ φ : G → G → ℝ, (∀ a b, X a b = ∑ j, φ j a * φ j b) ∧
+      ∀ Ω : n → ℝ, M *ᵥ Ω = lamMax M hM.1 • Ω →
+        (∀ j, ∀ Ω' : n → ℝ, M *ᵥ Ω' = lamMax M hM.1 • Ω' →
+          Ω' ⬝ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω) = 0) ∧
+        (0 < ∑ j, (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ (M *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω)) →
+          ∃ s : ℝ, 0 < s ∧ (∃ k, hM.1.eigenvalues k ≠ lamMax M hM.1 ∧ 0 < hM.1.eigenvalues k ∧
+            s = Real.log (lamMax M hM.1) - Real.log (hM.1.eigenvalues k)) ∧
+            Tendsto (fun R : ℕ => Real.log (lamMax M hM.1) - Real.log (∑ j,
+              (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ ((M ^ R) *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω))) / R)
+              atTop (𝓝 s)) := by
+  obtain ⟨φ, hφ, hφ0⟩ := exists_gram_sum_zero X hX hX1
+  refine ⟨φ, hφ, fun Ω hΩ => ⟨fun j Ω' hΩ' => ?_, fun hW1 => ?_⟩⟩
+  · apply perron_dot_avg M hM.1 hpos σ hinv (fun c => φ j (h c)) _ Ω' Ω hΩ' hΩ
+    intro c
+    simp only [hact]
+    have := Equiv.sum_comp (Equiv.mulRight (h c)) (φ j)
+    simp only [Equiv.coe_mulRight] at this
+    rw [this]
+    exact hφ0 j
+  · have horth : ∀ j, ∀ Ω' : n → ℝ, M *ᵥ Ω' = lamMax M hM.1 • Ω' →
+        Ω' ⬝ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω) = 0 := by
+      intro j Ω' hΩ'
+      apply perron_dot_avg M hM.1 hpos σ hinv (fun c => φ j (h c)) _ Ω' Ω hΩ' hΩ
+      intro c
+      simp only [hact]
+      have := Equiv.sum_comp (Equiv.mulRight (h c)) (φ j)
+      simp only [Equiv.coe_mulRight] at this
+      rw [this]
+      exact hφ0 j
+    exact potential_gap_family M hM hpos (fun j => diagonal (fun c => φ j (h c)) *ᵥ Ω) hW1 horth
+
+end Nonabelian
+
+section Slab
+
+variable {n : Type*} [Fintype n] [DecidableEq n]
+
+/-- the product of the two insertions' site weights over a sequence is the observable at the two sites -/
+theorem prod_ins (F : n → ℝ) (a R L : ℕ) (ha : a + R ≤ L) (c : Fin (L + 1) → n) :
+    ∏ x : Fin (L + 1), ins F a R (x : ℕ) (c x) = F (c ⟨a, by omega⟩) * F (c ⟨a + R, by omega⟩) := by
+  simp only [ins]
+  rw [Finset.prod_mul_distrib]
+  congr 1
+  · rw [Finset.prod_eq_single ⟨a, by omega⟩]
+    · simp
+    · intro b _ hb
+      rw [if_neg]
+      intro hb'
+      exact hb (Fin.ext hb')
+    · intro hmem
+      exact absurd (Finset.mem_univ _) hmem
+  · rw [Finset.prod_eq_single ⟨a + R, by omega⟩]
+    · simp
+    · intro b _ hb
+      rw [if_neg]
+      intro hb'
+      exact hb (Fin.ext hb')
+    · intro hmem
+      exact absurd (Finset.mem_univ _) hmem
+
+/-- the slab's Gibbs sum with a PAIR weight P at the sites a and a + R: the Wilson loop's χ(h(c_a) h(c_{a+R})⁻¹) -/
+def pathSumPair (M : Matrix n n ℝ) (P : n → n → ℝ) (u v : n → ℝ) (a R L : ℕ) (ha : a + R ≤ L) : ℝ :=
+  ∑ c : Fin (L + 1) → n, u (c 0) * P (c ⟨a, by omega⟩) (c ⟨a + R, by omega⟩) *
+    (∏ x : Fin L, M (c x.castSucc) (c x.succ)) * v (c (Fin.last L))
+
+/-- THE LOOP IS A SUM OF TWO-POINT FUNCTIONS: a pair weight with a Gram factorisation P(x, y) = Σ_j F_j(x) F_j(y)
+makes the pair sum the sum over j of the two-insertion sums of F_j -/
+theorem pathSumPair_eq_sum {ι : Type*} [Fintype ι] (M : Matrix n n ℝ) (P : n → n → ℝ) (F : ι → n → ℝ)
+    (hP : ∀ x y, P x y = ∑ j, F j x * F j y) (u v : n → ℝ) (a R L : ℕ) (ha : a + R ≤ L) :
+    pathSumPair M P u v a R L ha = ∑ j, pathSum M (ins (F j) a R) u v 0 L := by
+  simp only [pathSumPair, pathSum, zero_add]
+  rw [Finset.sum_comm]
+  apply Finset.sum_congr rfl
+  intro c _
+  rw [hP, Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
+  apply Finset.sum_congr rfl
+  intro j _
+  rw [prod_ins (F j) a R L ha c]
+
+/-- two unit Perron eigenvectors of a symmetric entrywise-positive matrix agree up to sign -/
+theorem perron_unit_sign [Nonempty n] (M : Matrix n n ℝ) (hM : M.IsHermitian) (hpos : ∀ i j, 0 < M i j)
+    (Ω Ω' : n → ℝ) (hΩ : M *ᵥ Ω = lamMax M hM • Ω) (hΩ' : M *ᵥ Ω' = lamMax M hM • Ω')
+    (hn : Ω ⬝ᵥ Ω = 1) (hn' : Ω' ⬝ᵥ Ω' = 1) : Ω' = Ω ∨ Ω' = -Ω := by
+  obtain ⟨a, hapos, ha, -⟩ := perron_exists M hM hpos
+  obtain ⟨c, hc⟩ := perron_simple M hM hpos a hapos ha Ω hΩ
+  obtain ⟨c', hc'⟩ := perron_simple M hM hpos a hapos ha Ω' hΩ'
+  have haa : 0 < a ⬝ᵥ a := by
+    apply Finset.sum_pos
+    · intro i _
+      exact mul_pos (hapos i) (hapos i)
+    · exact Finset.univ_nonempty
+  rw [hc, smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul] at hn
+  rw [hc', smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul] at hn'
+  have hcc : c' * c' = c * c := by
+    have h1 : c * c * (a ⬝ᵥ a) = 1 := by rw [← hn]; ring
+    have h2 : c' * c' * (a ⬝ᵥ a) = 1 := by rw [← hn']; ring
+    have := h1.trans h2.symm
+    exact (mul_right_cancel₀ haa.ne' this).symm
+  rcases mul_self_eq_mul_self_iff.mp hcc with h | h
+  · left
+    rw [hc, hc', h]
+  · right
+    rw [hc, hc', h, neg_smul]
+
+/-- THE INFINITE SLAB WITH ANY UNIT PERRON VECTOR: the two-point function of F placed symmetrically in the slab
+converges to ⟨F Ω, M^R F Ω⟩ / λ₀^R for every unit Perron eigenvector Ω (its sign is immaterial) -/
+theorem slab_tendsto' [Nonempty n] (D : n → ℝ) (hD : ∀ c, 0 < D c) (K : Matrix n n ℝ) (hK : K.PosSemidef)
+    (hKpos : ∀ c c', 0 < K c c') (F : n → ℝ) (Ω : n → ℝ)
+    (hΩ : transfer D K *ᵥ Ω = lamMax (transfer D K) (transfer_posSemidef D K hK).1 • Ω) (hn : Ω ⬝ᵥ Ω = 1)
+    (R : ℕ) :
+    Tendsto (fun a : ℕ => slabNum D K F (a + 1) R / slabZ D K (a + 1) R) atTop
+      (𝓝 ((diagonal F *ᵥ Ω) ⬝ᵥ (transfer D K ^ R *ᵥ (diagonal F *ᵥ Ω)) /
+        lamMax (transfer D K) (transfer_posSemidef D K hK).1 ^ R)) := by
+  obtain ⟨Ω₀, hn₀, hΩ₀, -, hlim⟩ := slab_tendsto D hD K hK hKpos F
+  have hM : (transfer D K).IsHermitian := (transfer_posSemidef D K hK).1
+  have hpos : ∀ i j, 0 < transfer D K i j := transfer_pos D hD K hKpos
+  rcases perron_unit_sign (transfer D K) hM hpos Ω₀ Ω hΩ₀ hΩ hn₀ hn with h | h
+  · rw [h]
+    exact hlim R
+  · rw [h]
+    have : (diagonal F *ᵥ -Ω₀) ⬝ᵥ (transfer D K ^ R *ᵥ (diagonal F *ᵥ -Ω₀)) =
+        (diagonal F *ᵥ Ω₀) ⬝ᵥ (transfer D K ^ R *ᵥ (diagonal F *ᵥ Ω₀)) := by
+      rw [mulVec_neg, mulVec_neg, neg_dotProduct, dotProduct_neg, neg_neg]
+    rw [this]
+    exact hlim R
+
+/-- the slab's Wilson loop with the pair weight P placed symmetrically: a + 1 vacuum cross-sections either side -/
+noncomputable def slabLoop (D : n → ℝ) (K : Matrix n n ℝ) (P : n → n → ℝ) (a R : ℕ) : ℝ :=
+  pathSumPair (transfer D K) P (fun c => Real.sqrt (D c)) (fun c => Real.sqrt (D c)) (a + 1) R
+    (2 * (a + 1) + R) (by omega)
+
+/-- THE NONABELIAN WILSON LOOP OF THE X-TRANSFER MODEL CONVERGES, AND ITS STATIC POTENTIAL IS AT LEAST THE GAP: with
+the class matrix X of a nontrivial real class function factorised as X(x, y) = Σ_j φ_j(x) φ_j(y), the loop's pair
+weight P(c, c') = X(h c, h c') on the slab, D positive, k the link kernel (positive semidefinite and positive), the
+endpoint gauge action σ_g (D-invariant, equivariant on h), and Ω any unit Perron vector of M = D^{1/2} K D^{1/2}:
+the loop's slab expectation converges to W(R) = Σ_j ⟨F_j Ω, M^R F_j Ω⟩ / λ₀^R at every R, and if W(1) > 0 then
+log λ₀ − log Σ_j ⟨F_j Ω, M^R F_j Ω⟩ / R → E > 0, a gap -/
+theorem nonabelian_slab_potential_gap {G : Type*} [Fintype G] [DecidableEq G] [Group G]
+    {L : Type*} [Fintype L] [DecidableEq L]
+    (D : (L → G) → ℝ) (hD : ∀ c, 0 < D c) (k : Matrix G G ℝ) (hk : k.PosSemidef) (hkpos : ∀ g g', 0 < k g g')
+    (h : (L → G) → G) (X : Matrix G G ℝ) (hX : X.PosSemidef) (hX1 : X *ᵥ (fun _ => (1 : ℝ)) = 0)
+    (φ : G → G → ℝ) (hφ : ∀ x y, X x y = ∑ j, φ j x * φ j y)
+    (σ : G → Equiv.Perm (L → G)) (hDinv : ∀ g c, D (σ g c) = D c)
+    (hKinv : ∀ g c c', tensorKernel k (σ g c) (σ g c') = tensorKernel k c c')
+    (hact : ∀ g c, h (σ g c) = g * h c)
+    (Ω : (L → G) → ℝ)
+    (hΩ : transfer D (tensorKernel k) *ᵥ Ω =
+      lamMax (transfer D (tensorKernel k)) (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1 • Ω)
+    (hn : Ω ⬝ᵥ Ω = 1) :
+    (∀ R : ℕ, Tendsto (fun a : ℕ => slabLoop D (tensorKernel k) (fun c c' => X (h c) (h c')) a R /
+        slabZ D (tensorKernel k) (a + 1) R) atTop
+      (𝓝 (∑ j, (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ
+          (transfer D (tensorKernel k) ^ R *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω)) /
+        lamMax (transfer D (tensorKernel k)) (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1 ^ R))) ∧
+    (0 < ∑ j, (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ
+        (transfer D (tensorKernel k) *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω)) →
+      ∃ s : ℝ, 0 < s ∧
+        (∃ i, (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1.eigenvalues i ≠
+            lamMax (transfer D (tensorKernel k)) (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1 ∧
+          0 < (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1.eigenvalues i ∧
+          s = Real.log (lamMax (transfer D (tensorKernel k))
+              (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1) -
+            Real.log ((transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1.eigenvalues i)) ∧
+        Tendsto (fun R : ℕ => Real.log (lamMax (transfer D (tensorKernel k))
+            (transfer_posSemidef D _ (tensorKernel_posSemidef k hk)).1) -
+          Real.log (∑ j, (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ
+            (transfer D (tensorKernel k) ^ R *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω))) / R) atTop (𝓝 s)) := by
+  set K : Matrix (L → G) (L → G) ℝ := tensorKernel k with hKdef
+  have hK : K.PosSemidef := tensorKernel_posSemidef k hk
+  have hKpos : ∀ c c', 0 < K c c' := tensorKernel_pos k hkpos
+  set M : Matrix (L → G) (L → G) ℝ := transfer D K with hMdef
+  have hM : M.PosSemidef := transfer_posSemidef D K hK
+  have hpos : ∀ i j, 0 < M i j := transfer_pos D hD K hKpos
+  have hMinv : ∀ g a b, M (σ g a) (σ g b) = M a b := by
+    intro g a b
+    simp only [hMdef, transfer_apply, hDinv]
+    rw [hKinv]
+  refine ⟨fun R => ?_, fun hW1 => ?_⟩
+  · -- the loop's slab sum is the sum over j of the two-insertion sums
+    have hdecomp : ∀ a : ℕ, slabLoop D K (fun c c' => X (h c) (h c')) a R =
+        ∑ j, slabNum D K (fun c => φ j (h c)) (a + 1) R := by
+      intro a
+      simp only [slabLoop, slabNum]
+      exact pathSumPair_eq_sum M (fun c c' => X (h c) (h c')) (fun j c => φ j (h c))
+        (fun c c' => hφ (h c) (h c')) _ _ (a + 1) R (2 * (a + 1) + R) (by omega)
+    have hlimj : ∀ j, Tendsto (fun a : ℕ => slabNum D K (fun c => φ j (h c)) (a + 1) R / slabZ D K (a + 1) R)
+        atTop (𝓝 ((diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ
+          (M ^ R *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω)) / lamMax M hM.1 ^ R)) :=
+      fun j => slab_tendsto' D hD K hK hKpos (fun c => φ j (h c)) Ω hΩ hn R
+    have hsum := tendsto_finsetSum Finset.univ (fun j _ => hlimj j)
+    have hmain : Tendsto (fun a : ℕ => slabLoop D K (fun c c' => X (h c) (h c')) a R / slabZ D K (a + 1) R)
+        atTop (𝓝 (∑ j, (diagonal (fun c => φ j (h c)) *ᵥ Ω) ⬝ᵥ
+          (M ^ R *ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω)) / lamMax M hM.1 ^ R)) := by
+      refine hsum.congr' (Filter.Eventually.of_forall fun a => ?_)
+      show ∑ j, slabNum D K (fun c => φ j (h c)) (a + 1) R / slabZ D K (a + 1) R =
+        slabLoop D K (fun c c' => X (h c) (h c')) a R / slabZ D K (a + 1) R
+      rw [hdecomp a, Finset.sum_div]
+    simpa [hMdef, hKdef] using hmain
+  · -- every Gram vector of X sums to zero, since 1ᵀ X 1 = Σ_j (Σ_x φ_j x)² and X 1 = 0
+    have hφ0 : ∀ j, ∑ x, φ j x = 0 := by
+      -- Σ_x φ_j(x) = 0: from X 1 = 0 and the Gram form, Σ_j (Σ_x φ_j x)^2 = 1ᵀ X 1 = 0
+      have hXX : ∑ j, (∑ x, φ j x) ^ 2 = 0 := by
+        have h0 : (fun _ => (1 : ℝ)) ⬝ᵥ (X *ᵥ fun _ => (1 : ℝ)) = 0 := by rw [hX1, dotProduct_zero]
+        have hsq : ∀ j, (∑ x, φ j x) ^ 2 = ∑ x, ∑ y, φ j x * φ j y := fun j => by
+          rw [sq, Finset.sum_mul_sum]
+        simp only [hsq]
+        rw [← h0]
+        simp only [dotProduct, mulVec, hφ, Finset.mul_sum, Finset.sum_mul, one_mul, mul_one]
+        rw [Finset.sum_comm]
+        apply Finset.sum_congr rfl
+        intro j _
+        rw [Finset.sum_comm]
+      intro j
+      have := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => sq_nonneg (∑ x, φ j x))).mp hXX j (Finset.mem_univ j)
+      exact pow_eq_zero_iff (two_ne_zero) |>.mp this
+    have horth : ∀ j, ∀ Ω' : (L → G) → ℝ, M *ᵥ Ω' = lamMax M hM.1 • Ω' →
+        Ω' ⬝ᵥ (diagonal (fun c => φ j (h c)) *ᵥ Ω) = 0 := by
+      intro j Ω' hΩ'
+      apply perron_dot_avg M hM.1 hpos σ hMinv (fun c => φ j (h c)) _ Ω' Ω hΩ' hΩ
+      intro c
+      simp only [hact]
+      have := Equiv.sum_comp (Equiv.mulRight (h c)) (φ j)
+      simp only [Equiv.coe_mulRight] at this
+      rw [this]
+      exact hφ0 j
+    exact potential_gap_family M hM hpos (fun j => diagonal (fun c => φ j (h c)) *ᵥ Ω) hW1 horth
+
+end Slab
+
+end Aperanton
