/-! ## The consistency of the link lists, the faces, the sheets, the cubes of a plaquette -- decided LINEAR in the volume -/

theorem c1 : C1 3 := by
  decide +kernel
theorem c2 : C2 3 := by
  decide +kernel
theorem faces_ok : FacesOK 3 := by
  decide +kernel
theorem sheets_ok : SheetsOK 3 := by
  decide +kernel
theorem cube_six : CubeSix 3 := by
  decide +kernel
theorem plaq_four : ((List.range (nPlaq 3)).all (fun p => (plaqLinks 3 (p / V 3) (p % V 3)).length == 4)) = true := by
  decide +kernel
theorem pc : PC 3 := by
  decide +kernel
theorem adj_inc : ∀ mu : Fin 4, AdjInc 3 mu.val := by
  decide +kernel
/-- the direct coboundary masks are the coboundary masks: the filter never runs in the kernel -/
theorem cobdMasks_eq3 : cobdMasks 3 = cobdMasksD 3 := cobdMasks_eq 3 c1 c2

/-! ## The echelon certificates in list form (EchelonList.lean), bridged to those of Echelon.lean -/

theorem Cobd_len : pivCobd.length = basisCobd.length := by decide +kernel
theorem Cobd_nodup : basisCobd.Nodup := by decide +kernel
theorem Cobd_hitL : hitL basisCobd pivCobd = true := by decide +kernel
theorem Cobd_missL : missL basisCobd pivCobd = true := by decide +kernel
theorem Cobd_piv_lt : ∀ p ∈ pivCobd, p < 486 := by decide +kernel
theorem Cobd_cert : EchelonCert basisCobd pivCobd :=
  echelonCert_of_lists _ _ Cobd_len Cobd_nodup Cobd_hitL Cobd_missL
theorem Cobd_selG_len : selGCobd.length = (cobdMasksD 3).length := by decide +kernel
theorem Cobd_selGL : selL (cobdMasksD 3) selGCobd basisCobd = true := by decide +kernel
theorem Cobd_selB_len : selBCobd.length = basisCobd.length := by decide +kernel
theorem Cobd_selBL : selL basisCobd selBCobd (cobdMasksD 3) = true := by decide +kernel
theorem Cobd_selG : ∀ i : Fin (cobdMasks 3).length, (cobdMasks 3).get i = xorSel (selGCobd.getD i.val 0) basisCobd := by
  rw [cobdMasks_eq3]
  exact sel_of_list _ _ _ Cobd_selG_len Cobd_selGL
theorem Cobd_selB : ∀ i : Fin basisCobd.length, basisCobd.get i = xorSel (selBCobd.getD i.val 0) (cobdMasks 3) := by
  rw [cobdMasks_eq3]
  exact sel_of_list _ _ _ Cobd_selB_len Cobd_selBL
theorem Cobd_rank : basisCobd.length = 240 := by decide +kernel

theorem Bd3_len : pivBd3.length = basisBd3.length := by decide +kernel
theorem Bd3_nodup : basisBd3.Nodup := by decide +kernel
theorem Bd3_hitL : hitL basisBd3 pivBd3 = true := by decide +kernel
theorem Bd3_missL : missL basisBd3 pivBd3 = true := by decide +kernel
theorem Bd3_piv_lt : ∀ p ∈ pivBd3, p < 486 := by decide +kernel
theorem Bd3_cert : EchelonCert basisBd3 pivBd3 :=
  echelonCert_of_lists _ _ Bd3_len Bd3_nodup Bd3_hitL Bd3_missL
theorem Bd3_selG_len : selGBd3.length = (cubeMasks 3).length := by decide +kernel
theorem Bd3_selGL : selL (cubeMasks 3) selGBd3 basisBd3 = true := by decide +kernel
theorem Bd3_selB_len : selBBd3.length = basisBd3.length := by decide +kernel
theorem Bd3_selBL : selL basisBd3 selBBd3 (cubeMasks 3) = true := by decide +kernel
theorem Bd3_selG : ∀ i : Fin (cubeMasks 3).length, (cubeMasks 3).get i = xorSel (selGBd3.getD i.val 0) basisBd3 :=
  sel_of_list _ _ _ Bd3_selG_len Bd3_selGL
theorem Bd3_selB : ∀ i : Fin basisBd3.length, basisBd3.get i = xorSel (selBBd3.getD i.val 0) (cubeMasks 3) :=
  sel_of_list _ _ _ Bd3_selB_len Bd3_selBL
theorem Bd3_rank : basisBd3.length = 240 := by decide +kernel

theorem Bd3S_len : pivBd3S.length = basisBd3S.length := by decide +kernel
theorem Bd3S_nodup : basisBd3S.Nodup := by decide +kernel
theorem Bd3S_hitL : hitL basisBd3S pivBd3S = true := by decide +kernel
theorem Bd3S_missL : missL basisBd3S pivBd3S = true := by decide +kernel
theorem Bd3S_piv_lt : ∀ p ∈ pivBd3S, p < 486 := by decide +kernel
theorem Bd3S_cert : EchelonCert basisBd3S pivBd3S :=
  echelonCert_of_lists _ _ Bd3S_len Bd3S_nodup Bd3S_hitL Bd3S_missL
theorem Bd3S_selG_len : selGBd3S.length = (cubeMasks 3 ++ sheetMasks 3).length := by decide +kernel
theorem Bd3S_selGL : selL (cubeMasks 3 ++ sheetMasks 3) selGBd3S basisBd3S = true := by decide +kernel
theorem Bd3S_selB_len : selBBd3S.length = basisBd3S.length := by decide +kernel
theorem Bd3S_selBL : selL basisBd3S selBBd3S (cubeMasks 3 ++ sheetMasks 3) = true := by decide +kernel
theorem Bd3S_selG : ∀ i : Fin (cubeMasks 3 ++ sheetMasks 3).length, (cubeMasks 3 ++ sheetMasks 3).get i = xorSel (selGBd3S.getD i.val 0) basisBd3S :=
  sel_of_list _ _ _ Bd3S_selG_len Bd3S_selGL
theorem Bd3S_selB : ∀ i : Fin basisBd3S.length, basisBd3S.get i = xorSel (selBBd3S.getD i.val 0) (cubeMasks 3 ++ sheetMasks 3) :=
  sel_of_list _ _ _ Bd3S_selB_len Bd3S_selBL
theorem Bd3S_rank : basisBd3S.length = 246 := by decide +kernel

/-- THE RANKS: 240, 240, 246 -- T⁴'s chain complex over F₂ at side 3: 4V − V − 3, 4V − V − 3, and six more -/
theorem ranks : [basisCobd.length, basisBd3.length, basisBd3S.length] = [240, 240, 246] := by decide +kernel

/-! ## The boundary of a boundary and the sheets, as xor identities (TorusLinear.lean) -/

theorem ddx : DDX 3 := by
  decide +kernel
theorem shx : SHX 3 := by
  decide +kernel
/-- ∂₂ ∂₃ = 0 at side 3, in the mask form the bridge reads, from the xor identity -/
theorem dd_zero : ((cubeMasks 3).all (fun c => (cobdMasks 3).all (fun l => !(parAnd 3 c l)))) = true :=
  dd_of_xor 3 c1 c2 faces_ok ddx
/-- the six sheets are 2-cycles at side 3, in the mask form, from the xor identity -/
theorem sheets_cycle : ((sheetMasks 3).all (fun h => (cobdMasks 3).all (fun l => !(parAnd 3 h l)))) = true :=
  sheets_of_xor 3 c1 c2 sheets_ok shx

/-! ## The dual facts at side 3, from the listed cubes and the double count (TorusLinearDual.lean) -/

theorem deg_four : ∀ i : Fin (nPlaq 3),
    (univ.filter (fun k : Fin (nCubes 3) => ((cubeMult 3 i k : ℕ) : ZMod 2) = 1)).card = 4 :=
  hdeg_of 3 faces_ok cube_six pc
theorem faces_six : ∀ s : Fin (nCubes 3),
    (univ.filter (fun i : Fin (nPlaq 3) => ((cubeMult 3 i s : ℕ) : ZMod 2) = 1)).card = 6 :=
  hsix_of 3 faces_ok cube_six
theorem col : ∀ (k : Fin (nCubes 3)) (i : Fin (nPlaq 3)),
    ((cubeMult 3 i k : ℕ) : ZMod 2) = vecOf 3 (cubeMask 3 k.val) i :=
  hcol_of 3 faces_ok
theorem adj : ∀ mu : Fin 4, AdjList 3 mu.val := fun mu => adjList_of 3 mu.val faces_ok cube_six pc (adj_inc mu)

