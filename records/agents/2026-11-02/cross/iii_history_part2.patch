+/-- the profile certificates at (2D, K = 3, p = 5) and (2D, K = 3, p = 13) -/
+def certP5K3 : Bool :=
+  wfCheck R23s
+  && decide ((autoOrbit R23s 5 zero48 2).1 = (autoOrbit R23s 5 zero48 1).1.map (· + 1))
