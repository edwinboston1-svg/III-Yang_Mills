extern @abi(c-msvc-x64) fn mgs_cmp(a: u64, b: u64) -> u64 from "megethos.iii"
extern @abi(c-msvc-x64) fn mgs_sign(r: u64) -> u64 from "megethos.iii"
extern @abi(c-msvc-x64) fn mgs_iszero(r: u64) -> u64 from "megethos.iii"
extern @abi(c-msvc-x64) fn mgs_neg(r: u64) -> u64 from "megethos.iii"
extern @abi(c-msvc-x64) fn sfx_setgroup(gk: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_setcoupling(yk: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_orbits() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_sym() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_fillks() -> u64 from "strophinx.iii"
