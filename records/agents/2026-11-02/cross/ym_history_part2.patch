+  push(P0(`Put *z* = *r*²/4 and *A* = Σ_{k} *z*^{k}/(*k*!(*k* + 2)!), *B* = Σ_{k} *z*^{k}/(*k*!(*k* + 1)!), *C* = Σ_{k} *z*^{k}/(*k*!(*k* + 3)!), so that *A* = (2/*r*)²*I*₂, *B* = (2/*r*)*I*₁ and *C* = (2/*r*)³*I*₃, all three positive, with *m*/*r* = *A*/(2*B*) and *m*² = *zA*²/*B*². Comparing coefficients gives *B* − 2*A* = *zC* ≥ 0, which is the first half of (i). By (8.9), φ″ = 1 − 3*A*/(2*B*) − *zA*²/*B*², and the substitution *B* = 2*A* + *zC* gives`));
+  push(Eq([frac('1', '4'), mr(' − φ″ = '), frac(mr('z (A² − ¾ BC)'), mr('B²')), mr(',      D = φ″ − '), frac('m', 'r'), mr(' = − '), frac(mr('z (A² − BC)'), mr('B²')), mr('.')], '8.10'));
