namespace Aperanton
namespace VertexLaw

/-- a Gaussian integer -/
structure GI where
  re : Int
  im : Int
deriving DecidableEq, Repr

def GI.add (x y : GI) : GI := ⟨x.re + y.re, x.im + y.im⟩
def GI.mul (x y : GI) : GI := ⟨x.re * y.re - x.im * y.im, x.re * y.im + x.im * y.re⟩

/-- a 2 x 2 matrix over the Gaussian integers, row-major -/
structure M2 where
  a : GI
  b : GI
  c : GI
  d : GI
deriving DecidableEq, Repr

def M2.mul (x y : M2) : M2 :=
  ⟨(x.a.mul y.a).add (x.b.mul y.c), (x.a.mul y.b).add (x.b.mul y.d),
   (x.c.mul y.a).add (x.d.mul y.c), (x.c.mul y.b).add (x.d.mul y.d)⟩
def M2.one : M2 := ⟨⟨1, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩, ⟨1, 0⟩⟩
def M2.traceRe (x : M2) : Int := x.a.re + x.d.re

/-- sigma_1, sigma_2, sigma_3 -/
def pauli : Nat → M2
  | 0 => ⟨⟨0, 0⟩, ⟨1, 0⟩, ⟨1, 0⟩, ⟨0, 0⟩⟩
  | 1 => ⟨⟨0, 0⟩, ⟨0, -1⟩, ⟨0, 1⟩, ⟨0, 0⟩⟩
  | _ => ⟨⟨1, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩, ⟨-1, 0⟩⟩

/-- the index of chord w under the assignment code, a base-3 digit -/
def digit (code w : Nat) : Nat := (code / 3 ^ w) % 3

/-- the Pauli product around the vertex cycle; a diagram is the list of chord numbers at the 2k positions -/
def prodAlong (code : Nat) : List Nat → M2
  | [] => M2.one
  | w :: ws => (pauli (digit code w)).mul (prodAlong code ws)

/-- S(D) = 2 * 3^k * c(D): the trace sum over the 3^k assignments -/
def vertexSum (k : Nat) (diag : List Nat) : Int :=
  (List.range (3 ^ k)).foldl (fun acc code => acc + (prodAlong code diag).traceRe) 0

def M2.traceIm (x : M2) : Int := x.a.im + x.d.im

/-- the spine's trace-tensor norm (S1 §17, Lemma S13): 4 |T_m|^2 = sum over the 3^m assignments of |tr(sigma_{m1} ... sigma_{mm})|^2,
    the closed form 3^m + 3 (-1)^m; J_m = 3^-m <T_u, T_v> is bounded by |T_m|^2 / 3^m -/
def spineSum (m : Nat) : Int :=
  (List.range (3 ^ m)).foldl (fun acc code =>
    let p := prodAlong code (List.range m)
    acc + p.traceRe * p.traceRe + p.traceIm * p.traceIm) 0

/-! ## The sighted controls: one chord gives 6 (c = 1); the Pauli matrices square to one -/

theorem pauli_sq : (List.range 3).all (fun m => (pauli m).mul (pauli m) == M2.one) = true := by decide +kernel

