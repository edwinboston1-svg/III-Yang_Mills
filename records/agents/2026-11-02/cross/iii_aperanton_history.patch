+  have hcpos : 0 < c := by linarith
+  have hT : 0 < lamMax (T Q z) (T_herm Q z) := lt_of_lt_of_le h6 h1
+  unfold rate
+  constructor
+  · rw [inv_eq_one_div, div_le_div_iff₀ hcpos hT]
+    nlinarith [h2, h3, h6, hT]
+  · rw [div_le_iff₀ hT]
+    nlinarith [h1, h4, h6, hT, hcpos]
+
