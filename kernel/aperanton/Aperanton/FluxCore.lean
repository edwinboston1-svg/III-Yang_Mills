  (List.range 8).foldl (fun acc h =>
    padd acc (pscale (sign h w)
      ((List.range 25).foldl (fun acc2 k => padd acc2 (pscale (coeffAt (J h) k / 2) (basisTable.getD k []))) (List.replicate 25 0))))
    (List.replicate 25 0)

