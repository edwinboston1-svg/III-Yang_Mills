namespace Z2Inv

abbrev Mat := List (List Int)

def dot : List Int → List Int → Int
  | [], _ => 0
  | _, [] => 0
  | a :: as, b :: bs => a * b + dot as bs

/-- the product a · b given the transpose of b -/
def mulT (a bT : Mat) : Mat := a.map (fun r => bT.map (fun c => dot r c))

def transpose (m : Mat) (n : Nat) : Mat := (List.range n).map (fun j => m.map (fun r => r.getD j 0))

def mul (a b : Mat) (n : Nat) : Mat := mulT a (transpose b n)

def scale (c : Int) (m : Mat) : Mat := m.map (fun r => r.map (fun x => c * x))

