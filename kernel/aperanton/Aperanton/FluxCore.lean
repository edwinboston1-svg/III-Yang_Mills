/-! ## The torus 2x2x2, from the definitions (sites x-major, as the stranger's engine indexes them) -/

def L1 : Nat := 2
def L2 : Nat := 2
def L3 : Nat := 2
def V : Nat := L1 * L2 * L3
def E : Nat := 3 * V
def P : Nat := 3 * V

def site (x y z : Nat) : Nat := ((x % L1) * L2 + (y % L2)) * L3 + (z % L3)
def cx (s : Nat) : Nat := s / (L2 * L3)
def cy (s : Nat) : Nat := (s / L3) % L2
def cz (s : Nat) : Nat := s % L3
def coord (s mu : Nat) : Nat := if mu == 0 then cx s else if mu == 1 then cy s else cz s
def side (mu : Nat) : Nat := if mu == 0 then L1 else if mu == 1 then L2 else L3
/-- the neighbour one step forward along mu (periodic) -/
def stepP (s mu : Nat) : Nat :=
  if mu == 0 then site (cx s + 1) (cy s) (cz s)
  else if mu == 1 then site (cx s) (cy s + 1) (cz s)
  else site (cx s) (cy s) (cz s + 1)
def link (mu s : Nat) : Nat := mu * V + s
/-- plaquette (q, s): the pair q = 0 is (x,y) with normal z, 1 is (x,z) with normal y, 2 is (y,z) with normal x -/
def plaq (q s : Nat) : Nat := q * V + s
def normal (q : Nat) : Nat := 2 - q
def pairMu (q : Nat) : Nat := if q == 2 then 1 else 0
def pairNu (q : Nat) : Nat := if q == 0 then 1 else 2
/-- the four links in the boundary of the plaquette (q, s) -/
def bdry (q s : Nat) : List Nat :=
  [link (pairMu q) s, link (pairNu q) (stepP s (pairMu q)), link (pairMu q) (stepP s (pairNu q)), link (pairNu q) s]
/-- the six faces of the cube with lowest corner s: the lower face (q, s) and the upper face (q, s + normal) -/
def faces (s : Nat) : List Nat := (List.range 3).flatMap (fun q => [plaq q s, plaq q (stepP s (normal q))])
def plaquettes : List Nat := (List.range 3).flatMap (fun q => (List.range V).map (fun s => plaq q s))
/-- the plaquettes containing the link l (the coboundary of the link) -/
def coboundary (l : Nat) : List Nat := plaquettes.filter (fun p => (bdry (p / V) (p % V)).contains l)
/-- the line representative of direction r: the plaquettes with normal r on the column at the last (mu, nu) -/
def lineR (r : Nat) : List Nat :=
  (List.range V).filterMap (fun s =>
    if coord s (pairMu (2 - r)) == side (pairMu (2 - r)) - 1 && coord s (pairNu (2 - r)) == side (pairNu (2 - r)) - 1
    then some (plaq (2 - r) s) else none)
/-- the sheet of direction r: the plaquettes with normal r at the last layer of r -/
def sheetR (r : Nat) : List Nat :=
  (List.range V).filterMap (fun s => if coord s r == side r - 1 then some (plaq (2 - r) s) else none)
def bit (v r : Nat) : Nat := (v / 2 ^ r) % 2
def lineW (w : Nat) : List Nat := (List.range 3).flatMap (fun r => if bit w r == 1 then lineR r else [])
def sheetH (h : Nat) : List Nat := (List.range 3).flatMap (fun r => if bit h r == 1 then sheetR r else [])
/-- the pairing read off the representatives: the parity of the intersection -/
def pairing (h w : Nat) : Nat := ((sheetH h).filter (fun p => (lineW w).contains p)).length % 2
def dot (h w : Nat) : Nat := (bit h 0 * bit w 0 + bit h 1 * bit w 1 + bit h 2 * bit w 2) % 2

/-- T1 the lines are cocycles: every cube meets each line in an even number of faces -/
theorem lines_cocycle :
    ((List.range 3).all (fun r => (List.range V).all (fun s =>
      ((faces s).filter (fun p => (lineR r).contains p)).length % 2 == 0))) = true := by decide
/-- T1 the sheets are cycles: every link lies in an even number of each sheet's plaquettes -/
theorem sheets_cycle :
    ((List.range 3).all (fun r => (List.range E).all (fun l =>
      ((coboundary l).filter (fun p => (sheetR r).contains p)).length % 2 == 0))) = true := by decide
/-- the weights of the representatives: lines of length L_r, sheets of area L_mu L_nu -/
theorem representatives_weights :
    (List.range 3).map (fun r => ((lineR r).length, (sheetR r).length)) = [(2, 4), (2, 4), (2, 4)] := by decide
/-- every link lies in exactly four plaquettes -/
theorem link_in_four : ((List.range E).all (fun l => (coboundary l).length == 4)) = true := by decide
/-- T2 the pairing is the dot product, on all 64 pairs -/
theorem pairing_is_dot : ((List.range 8).all (fun h => (List.range 8).all (fun w => pairing h w == dot h w))) = true := by decide

/-! ## Polynomials as integer coefficient lists, structurally recursive so the kernel reduces them -/

def padd : List Int → List Int → List Int
  | [], b => b
  | a, [] => a
  | (x :: xs), (y :: ys) => (x + y) :: padd xs ys
def pscale (c : Int) (a : List Int) : List Int := a.map (fun t => c * t)
def pmul : List Int → List Int → List Int
  | [], _ => []
  | (a :: as), b => padd (pscale a b) (0 :: pmul as b)
/-- (1 - y)^k -/
def pow1m : Nat → List Int
  | 0 => [1]
  | k + 1 => pmul (pow1m k) [1, -1]
/-- (1 + y)^k -/
def pow1p : Nat → List Int
  | 0 => [1]
  | k + 1 => pmul (pow1p k) [1, 1]
/-- the coefficients of y^0 .. y^24 of (1 - y)^k (1 + y)^(24 - k), padded to 25 -/
def basis (k : Nat) : List Int := padd (pmul (pow1m k) (pow1p (24 - k))) (List.replicate 25 0)
def sign (h w : Nat) : Int := if dot h w == 1 then -1 else 1
def firstNonzero : List Int → Nat → Nat
  | [], _ => 0
  | (x :: xs), i => if x == 0 then firstNonzero xs (i + 1) else i
def coeffAt : List Int → Nat → Int
  | [], _ => 0
  | (x :: xs), i => if i == 0 then x else coeffAt xs (i - 1)

