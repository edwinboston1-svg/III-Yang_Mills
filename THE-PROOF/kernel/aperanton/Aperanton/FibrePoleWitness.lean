namespace FibrePoleWitness

structure Q where
  a : Int
  b : Int
  deriving DecidableEq, Repr

def mul (d : Int) (x y : Q) : Q := ⟨x.a * y.a + d * x.b * y.b, x.a * y.b + x.b * y.a⟩
def add (x y : Q) : Q := ⟨x.a + y.a, x.b + y.b⟩
def dot (d : Int) : List Q → List Q → Q
  | [], _ => ⟨0, 0⟩
  | _, [] => ⟨0, 0⟩
  | x :: xs, y :: ys => add (mul d x y) (dot d xs ys)
def mulVec (d : Int) (M : List (List Q)) (v : List Q) : List Q := M.map (fun r => dot d r v)
def zero16 : List Q := List.replicate 16 ⟨0, 0⟩

