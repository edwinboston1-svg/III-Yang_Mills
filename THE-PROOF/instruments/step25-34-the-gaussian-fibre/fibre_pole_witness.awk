# fibre_pole_witness.awk -- THE POLE WITNESS (the validation protocol's first object, §31.18): for each cell of the block-averaged Gaussian
# fibre's operator (fibre_matrix.2026-11-02a.txt: the 16 x 16 polynomial matrix C(z) = C0 + C1 z + C2 z^2 over Z, and the law's quadratic
# q z^2 + b z + q whose root z0 = (-b + f sqrt d)/(2q), d squarefree, is the pole), an EXPLICIT KERNEL VECTOR v over Z[sqrt d] with
# M v = 0, M = 4q^2 C(z0) = 4q^2 C0 + 2q C1 w + C2 w^2, w = 2q z0 = -b + f sqrt d in Z[sqrt d] -- so the pole is EXHIBITED (C(z0) singular)
# without computing a determinant: the kernel decides M v = 0 by integer arithmetic on pairs (a, b) = a + b sqrt d.  Gauss--Jordan over the
# field Q(sqrt d) (elements (A + B sqrt d)/D, exact in gawk -M), the nullity read, each kernel vector cleared to Z[sqrt d], and M v = 0
# re-checked in Z[sqrt d] before anything is emitted; a bent vector (its first entry + 1) must FAIL (the sighted control).  Emits the Lean
# file LEAN/aperanton/Aperanton/FibrePoleWitness.lean (bare kernel: no import, decide the only proof term) when LEAN=<path> is given.
# Classical: a nonzero v with M v = 0 makes det M = 0 (Mathlib's Matrix.exists_mulVec_eq_zero_iff over the domain Z[sqrt d]), and
# det C(z0) = 0 with D = det C in Z[z] and z0 of degree two makes the quadratic divide D -- the bridge stated in FibrePoleBridge.lean.
# usage: gawk -M -v LEAN=LEAN/aperanton/Aperanton/FibrePoleWitness.lean -f fibre_pole_witness.awk fibre_matrix.2026-11-02a.txt
function gcd(a, b,   t) { a = (a < 0) ? -a : a; b = (b < 0) ? -b : b; while (b != 0) { t = a % b; a = b; b = t } return a }
function iabs(a) { return (a < 0) ? -a : a }
# Q(sqrt d) elements as (A, B, D): (A + B sqrt d)/D, D > 0, gcd(A, B, D) = 1 -- stored in EA/EB/ED by a name
function qnorm(k,   g) { if (ED[k] < 0) { EA[k] = -EA[k]; EB[k] = -EB[k]; ED[k] = -ED[k] } g = gcd(gcd(EA[k], EB[k]), ED[k]); if (g > 1) { EA[k] /= g; EB[k] /= g; ED[k] /= g } }
function qset(k, A, B, D) { EA[k] = A; EB[k] = B; ED[k] = D; qnorm(k) }
function qmul(x, y, k,   A, B, D) { A = EA[x] * EA[y] + DD * EB[x] * EB[y]; B = EA[x] * EB[y] + EB[x] * EA[y]; D = ED[x] * ED[y]; qset(k, A, B, D) }
function qsub(x, y, k,   A, B, D) { A = EA[x] * ED[y] - EA[y] * ED[x]; B = EB[x] * ED[y] - EB[y] * ED[x]; D = ED[x] * ED[y]; qset(k, A, B, D) }
function qinv(x, k,   N) { N = EA[x] * EA[x] - DD * EB[x] * EB[x]; if (N == 0) { print "REFUSED: inverse of zero"; exit 3 } qset(k, ED[x] * EA[x], -ED[x] * EB[x], N) }
function qzero(x) { return (EA[x] == 0 && EB[x] == 0) }
function squarefree(n,   f, d, p) { f = 1; d = n; for (p = 2; p * p <= d; p++) while (d % (p * p) == 0) { d /= p * p; f *= p } return d SUBSEP f }   # returns d, f with n = f^2 d
BEGIN { PROCINFO["sorted_in"] = "@ind_str_asc"; NCELL = 0 }
/^FM-C / { cell = $2 " " $3; if (!(cell in SEEN)) { SEEN[cell] = ++NCELL; CELLNAME[NCELL] = cell; npi = gsub(/pi/, "pi", $2); LAWKEY[NCELL] = "npi=" npi " " $3 } c = SEEN[cell]
  i = $4; j = $5; sub(/^i=/, "", i); sub(/^j=/, "", j); z0 = $6; z1 = $7; z2 = $8; sub(/^z\^0=/, "", z0); sub(/^z\^1=/, "", z1); sub(/^z\^2=/, "", z2)
  C0[c, i, j] = z0 + 0; C1[c, i, j] = z1 + 0; C2[c, i, j] = z2 + 0; next }
/^FP-LAW / { m = $0; sub(/^.*quadratic=/, "", m); split(m, f, " "); q = f[1] + 0; b = f[4] + 0; key = $2 " " $3; LAWQ[key] = q; LAWB[key] = b; next }
END {
  if (LEAN != "") { LF = LEAN; printf "/-\n  APERANTON -- THE POLE WITNESS (campaign §31.18, the validation protocol's first object; generated by\n  STDLIB/build/holoklerosis/fibre_pole_witness.awk from fibre_matrix.2026-11-02a.txt, the author's block-averaged Gaussian fibre operator).\n  For each of the eight cells the 16 x 16 matrix M = 4q^2 C(z0) over Z[sqrt d] (pairs (a, b) = a + b sqrt d) at the pole\n  z0 = (-b + f sqrt d)/(2q) of the law's quadratic q z^2 + b z + q, and an explicit nonzero vector v with M v = 0: the pole exhibited,\n  the determinant never computed.  Bare kernel: no import, `decide` the only proof term; a bent vector is the sighted control.\n-/\nnamespace FibrePoleWitness\n\nstructure Q where\n  a : Int\n  b : Int\n  deriving DecidableEq, Repr\n\ndef mul (d : Int) (x y : Q) : Q := ⟨x.a * y.a + d * x.b * y.b, x.a * y.b + x.b * y.a⟩\ndef add (x y : Q) : Q := ⟨x.a + y.a, x.b + y.b⟩\ndef dot (d : Int) : List Q → List Q → Q\n  | [], _ => ⟨0, 0⟩\n  | _, [] => ⟨0, 0⟩\n  | x :: xs, y :: ys => add (mul d x y) (dot d xs ys)\ndef mulVec (d : Int) (M : List (List Q)) (v : List Q) : List Q := M.map (fun r => dot d r v)\ndef zero16 : List Q := List.replicate 16 ⟨0, 0⟩\n\n" > LF }
  for (c = 1; c <= NCELL; c++) { key = CELLNAME[c]; lk = LAWKEY[c]; if (!(lk in LAWQ)) { print "REFUSED: no FP-LAW for cell " key " (law key " lk ")"; exit 3 }
    q = LAWQ[lk]; b = LAWB[lk]; disc = b * b - 4 * q * q; split(squarefree(disc), sf, SUBSEP); d = sf[1] + 0; fr = sf[2] + 0; DD = d
    # w = -b + fr sqrt d; w^2 = (b^2 + fr^2 d) - 2 b fr sqrt d; M = 4q^2 C0 + 2q C1 w + C2 w^2 as integer pairs (MA, MB)
    for (i = 0; i < 16; i++) for (j = 0; j < 16; j++) { MA[i, j] = 4 * q * q * C0[c, i, j] + 2 * q * C1[c, i, j] * (-b) + C2[c, i, j] * (b * b + fr * fr * d); MB[i, j] = 2 * q * C1[c, i, j] * fr + C2[c, i, j] * (-2 * b * fr) }
    # Gauss--Jordan over Q(sqrt d) on a copy R
    for (i = 0; i < 16; i++) for (j = 0; j < 16; j++) qset("R" i "," j, MA[i, j], MB[i, j], 1)
    rank = 0; delete PIV; delete ISPIV
    for (col = 0; col < 16 && rank < 16; col++) { pr = -1; for (i = rank; i < 16; i++) if (!qzero("R" i "," col)) { pr = i; break } if (pr < 0) continue
      if (pr != rank) for (j = 0; j < 16; j++) { t1 = EA["R" pr "," j]; t2 = EB["R" pr "," j]; t3 = ED["R" pr "," j]; qset("R" pr "," j, EA["R" rank "," j], EB["R" rank "," j], ED["R" rank "," j]); qset("R" rank "," j, t1, t2, t3) }
      qinv("R" rank "," col, "pinv"); for (j = 0; j < 16; j++) { qmul("R" rank "," j, "pinv", "t"); qset("R" rank "," j, EA["t"], EB["t"], ED["t"]) }
      for (i = 0; i < 16; i++) { if (i == rank || qzero("R" i "," col)) continue; qset("fac", EA["R" i "," col], EB["R" i "," col], ED["R" i "," col]); for (j = 0; j < 16; j++) { qmul("fac", "R" rank "," j, "t"); qsub("R" i "," j, "t", "u"); qset("R" i "," j, EA["u"], EB["u"], ED["u"]) } }
      PIV[rank] = col; ISPIV[col] = rank; rank++ }
    nullity = 16 - rank; printf "CELL %s: quadratic %d z^2 + %d z + %d, disc %d = %d^2 * %d, z0 = (-%d + %d sqrt %d)/(2*%d); rank %d, nullity %d\n", key, q, b, q, disc, fr, d, b, fr, d, q, rank, nullity
    if (nullity < 1) { printf "  REFUSED: no kernel at the pole -- the law's root is not a singular point of C\n"; continue }
    # the first free column's kernel vector: v[free] = 1, v[pivot col of row r] = -R[r][free]; cleared to Z[sqrt d] by the lcm of denominators
    fc = -1; for (col = 0; col < 16; col++) if (!(col in ISPIV)) { fc = col; break }
    for (j = 0; j < 16; j++) qset("v" j, 0, 0, 1); qset("v" fc, 1, 0, 1); for (r = 0; r < rank; r++) { qset("v" PIV[r], -EA["R" r "," fc], -EB["R" r "," fc], ED["R" r "," fc]) }
    L = 1; for (j = 0; j < 16; j++) L = L / gcd(L, ED["v" j]) * ED["v" j]
    for (j = 0; j < 16; j++) { VA[j] = EA["v" j] * (L / ED["v" j]); VB[j] = EB["v" j] * (L / ED["v" j]) }
    g = 0; for (j = 0; j < 16; j++) g = gcd(g, gcd(VA[j], VB[j])); if (g > 1) for (j = 0; j < 16; j++) { VA[j] /= g; VB[j] /= g }
    # the check in Z[sqrt d]: (M v)_i = sum_j (MA + MB sqrt d)(VA + VB sqrt d) = sum (MA VA + d MB VB) + sqrt d sum (MA VB + MB VA)
    bad = 0; for (i = 0; i < 16; i++) { sa = 0; sb = 0; for (j = 0; j < 16; j++) { sa += MA[i, j] * VA[j] + d * MB[i, j] * VB[j]; sb += MA[i, j] * VB[j] + MB[i, j] * VA[j] } if (sa != 0 || sb != 0) bad++ }
    # the control: v bent at its first entry (a + 1) must fail
    cbad = 0; for (i = 0; i < 16; i++) { sa = 0; sb = 0; for (j = 0; j < 16; j++) { va = VA[j] + (j == 0 ? 1 : 0); sa += MA[i, j] * va + d * MB[i, j] * VB[j]; sb += MA[i, j] * VB[j] + MB[i, j] * va } if (sa != 0 || sb != 0) cbad++ }
    vmax = 0; for (j = 0; j < 16; j++) { if (iabs(VA[j]) > vmax) vmax = iabs(VA[j]); if (iabs(VB[j]) > vmax) vmax = iabs(VB[j]) }
    printf "  M v = 0 in Z[sqrt %d]: %s (%d of 16 rows nonzero); the bent vector: %s (%d rows nonzero); |v| max %d; v = (", d, (bad == 0) ? "MET" : "FAILED", bad, (cbad > 0) ? "FAILS, SIGHTED" : "PASSES, BLIND", cbad, vmax
    for (j = 0; j < 16; j++) printf "%s%d%+d√%d", (j ? ", " : ""), VA[j], VB[j], d; printf ")\n"
    if (LEAN != "" && bad == 0) { printf "-- cell %s: %d z^2 + %d z + %d, d = %d, w = -%d + %d sqrt %d, M = 4q^2 C0 + 2q C1 w + C2 w^2\ndef d%d : Int := %d\ndef M%d : List (List Q) := [\n", key, q, b, q, d, b, fr, d, c, d, c > LF
      for (i = 0; i < 16; i++) { printf "  [" > LF; for (j = 0; j < 16; j++) printf "%s⟨%d, %d⟩", (j ? ", " : ""), MA[i, j], MB[i, j] > LF; printf "]%s\n", (i < 15 ? "," : "") > LF } printf "]\ndef v%d : List Q := [", c > LF
      for (j = 0; j < 16; j++) printf "%s⟨%d, %d⟩", (j ? ", " : ""), VA[j], VB[j] > LF; printf "]\ndef v%dbent : List Q := [", c > LF
      for (j = 0; j < 16; j++) printf "%s⟨%d, %d⟩", (j ? ", " : ""), VA[j] + (j == 0 ? 1 : 0), VB[j] > LF
      printf "]\ntheorem pole%d : mulVec d%d M%d v%d = zero16 := by decide\ntheorem pole%d_nonzero : v%d ≠ zero16 := by decide\ntheorem pole%d_control : mulVec d%d M%d v%dbent ≠ zero16 := by decide\n\n", c, c, c, c, c, c, c, c, c, c > LF; NLEAN++ } }
  if (LEAN != "") { printf "end FibrePoleWitness\n" > LF; close(LF); printf "LEAN %s: %d cells, %d theorems (three per cell: the witness, its nonvanishing, the bent control)\n", LEAN, NLEAN, 3 * NLEAN }
  # THE MECHANISM: the witness read at every cell is the longitudinal stagger v = (-1)^{s0} (sites 0..7 at s0 = 0, 8..15 at s0 = 1), so it is
  # tested as a COMMON EIGENVECTOR of C0, C1, C2 -- then C(z) v = (c0 + c1 z + c2 z^2) v and the law's quadratic is the stagger's own
  # dispersion: (c0 : c1 : c2) = c0 (1 : b/q : 1), with c0 = 128 MD (the scale)
  for (c = 1; c <= NCELL; c++) { key = CELLNAME[c]; lk = LAWKEY[c]; q = LAWQ[lk]; b = LAWB[lk]; ok = 1
    for (k = 0; k < 3; k++) { lam = ""; for (i = 0; i < 16; i++) { s = 0; for (j = 0; j < 16; j++) { vj = (j < 8) ? -1 : 1; s += (k == 0 ? C0[c, i, j] : (k == 1 ? C1[c, i, j] : C2[c, i, j])) * vj } vi = (i < 8) ? -1 : 1; r = s * vi; if (lam == "") lam = r; else if (r != lam) ok = 0 } EV[k] = lam }
    law = (EV[1] * q == EV[0] * b && EV[2] == EV[0])
    printf "STAGGER %s: C0 v = %d v, C1 v = %d v, C2 v = %d v; common eigenvector %s; (c0 : c1 : c2) = c0 (1 : %d/%d : 1) %s, c0/128 = %d\n", key, EV[0], EV[1], EV[2], ok ? "YES" : "NO", b, q, law ? "MET" : "FAILED", EV[0] / 128 } }
