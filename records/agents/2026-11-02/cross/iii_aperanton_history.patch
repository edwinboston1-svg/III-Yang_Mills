diff --git a/LEAN/aperanton/Aperanton/TorusLevels.lean b/LEAN/aperanton/Aperanton/TorusLevels.lean
new file mode 100644
index 000000000..cbd36bbf8
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusLevels.lean
@@ -0,0 +1,88 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6 (ADDENDUM I, THE ROAD): THE LEVELS OF THE FOUR-TORUS -- DISTANCE FROM A WALL,
+  AND THE DUAL FACTOR SYSTEM'S RANGE ONE ALONG IT.
+
+  Dobrushin's comparison theorem reads decay along a LEVEL φ : sites → ℕ with the interdependence of range one
+  (`RangeOne`: C s t = 0 whenever φ s + 1 < φ t).  On the slab the level was the time coordinate; on the torus of
+  side L the level of a cube is its site's distance from the wall x_μ = 0 ON THE CIRCLE, min(x_μ, L − x_μ)
+  (`levelAt`), which a step in any direction moves by at most one, the wrap included.  Two cubes with a nonzero
+  interdependence share a face, and the cubes sharing a face sit at sites one step apart, so their levels differ by
+  at most one: THE ADJACENCY FACT, in a list form each side's instance decides (every face of every cube against
+  every cube: 4V·6·4V membership tests), carried here as the hypothesis `hadj` of `rangeOne_of`.  With it, every
+  dual sector at side L is a Gibbs measure whose correlations between the wall and the cubes R levels away decay as
+  α^R, α = 18·c₁(y) (`cov_le`, Dobrushin.lean), uniformly in L -- the weak-coupling clause's engine.  W = 0;
+  the earning is the level that survives the wrap.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.TorusL
+import Aperanton.TorusSysL
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- the level of a cube index: its site's distance from the wall x_μ = 0 on the circle of length L -/
+def levelN (L mu k : ℕ) : ℕ := min (coord L (k % V L) mu) (L - coord L (k % V L) mu)
+
+def levelAt (L mu : ℕ) (k : Fin (nCubes L)) : ℕ := levelN L mu k.val
+
+/-- THE ADJACENCY FACT in list form: every face of every cube lies on cubes whose level is at most one more (an
+`abbrev`, so a side's instance decides it as the Bool equation it is) -/
+abbrev AdjList (L mu : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k => (cubeFaces L (k / V L) (k % V L)).all (fun i =>
+    (List.range (nCubes L)).all (fun k' =>
+      !(decide (i ∈ cubeFaces L (k' / V L) (k' % V L))) || decide (levelN L mu k' ≤ levelN L mu k + 1))))) = true
+
+/-- a nonzero incidence is a membership -/
+theorem cubeMult_ne_zero_iff (L : ℕ) (i : Fin (nPlaq L)) (k : Fin (nCubes L)) :
+    cubeMult L i k ≠ 0 ↔ i.val ∈ cubeFaces L (k.val / V L) (k.val % V L) := by
+  unfold cubeMult
+  rw [Ne, List.count_eq_zero, not_not]
+
+/-- the adjacency fact read at two cubes sharing a face -/
+theorem level_le_of_shared (L mu : ℕ) (hadj : AdjList L mu) (i : Fin (nPlaq L)) (k k' : Fin (nCubes L))
+    (hk : cubeMult L i k ≠ 0) (hk' : cubeMult L i k' ≠ 0) : levelAt L mu k' ≤ levelAt L mu k + 1 := by
+  unfold AdjList at hadj
+  rw [List.all_eq_true] at hadj
+  have h1 := hadj k.val (List.mem_range.mpr k.isLt)
+  rw [List.all_eq_true] at h1
+  have h2 := h1 i.val ((cubeMult_ne_zero_iff L i k).mp hk)
+  rw [List.all_eq_true] at h2
+  have h3 := h2 k'.val (List.mem_range.mpr k'.isLt)
+  have hmem : i.val ∈ cubeFaces L (k'.val / V L) (k'.val % V L) := (cubeMult_ne_zero_iff L i k').mp hk'
+  simp [hmem] at h3
+  exact h3
+
+/-- an incidence read as one in F₂ is nonzero -/
+theorem cubeMult_ne_zero_of_one (L : ℕ) (i : Fin (nPlaq L)) (k : Fin (nCubes L))
+    (h : ((cubeMult L i k : ℕ) : ZMod 2) = 1) : cubeMult L i k ≠ 0 := by
+  intro h0
+  rw [h0] at h
+  exact absurd h (by decide)
+
+/-- THE DUAL FACTOR SYSTEM HAS RANGE ONE ALONG THE WALL LEVEL -/
+theorem rangeOne_of (L mu : ℕ) (hadj : AdjList L mu) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y)
+    (hy1 : y ≤ 1) : RangeOne (torusSys L h y hy0 hy1).C (levelAt L mu) := by
+  intro s t hst
+  unfold Z2Sys.C
+  have hne : s ≠ t := by
+    intro e
+    rw [e] at hst
+    omega
+  rw [if_neg hne]
+  have hshared : (torusSys L h y hy0 hy1).shared s t = 0 := by
+    unfold Z2Sys.shared
+    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
+    intro i _ hp
+    have hs : cubeMult L i s ≠ 0 := cubeMult_ne_zero_of_one L i s hp.1
+    have ht : cubeMult L i t ≠ 0 := cubeMult_ne_zero_of_one L i t hp.2
+    have := level_le_of_shared L mu hadj i s t hs ht
+    omega
+  rw [hshared]
+  simp
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusLinear.lean b/LEAN/aperanton/Aperanton/TorusLinear.lean
new file mode 100644
index 000000000..798493759
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusLinear.lean
@@ -0,0 +1,209 @@
+/-
+  APERANTON -- THE BOUNDLESS, THE EVERY-L STEP (2026-10-28): THE LINEAR GEOMETRY -- the four-torus's incidence facts
+  decided in time LINEAR in the volume, bridged to the mask forms the split consumes.
+
+  The kernel's cost law, measured decide by decide at side 3 (01:1x): an enumeration of ~10^5 closure applications
+  costs gigabytes, ~10^4 is free, and the all-plaquette filter behind `linkCobd` (4V · 6V `contains`) alone took the
+  kernel 7.7 GB past the import.  So the link's six plaquettes are LISTED DIRECTLY (`linkPlaqs`: for each pair
+  containing the link's direction, the plaquette at the site and the one a step back in the other direction) and TWO
+  CONSISTENCY DECIDES, each linear (every link of every plaquette lists the plaquette; every plaquette of every link
+  lists the link, both in range), give `cobdMask = maskOf (linkPlaqs)` for every link WITHOUT the filter ever running
+  in the kernel.  THE BOUNDARY OF A BOUNDARY and THE SHEETS' CYCLICITY are decided as XOR IDENTITIES: the xor over a
+  cube's six faces (a sheet's L² plaquettes) of each face's link mask is zero -- one GMP xor per face -- and the bit of
+  a xor-fold is the parity of the count, which with the consistency decides is the parity of the intersection the mask
+  form reads.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.TorusL
+import Aperanton.TorusLocal
+
+namespace Aperanton
+
+namespace TorusL
+
+open Finset
+
+/-! ## The bit of a xor-fold -/
+
+theorem testBit_xorFold (l : List ℕ) (m : ℕ → ℕ) (j acc : ℕ) :
+    Nat.testBit (l.foldl (fun acc p => acc ^^^ m p) acc) j
+      = l.foldl (fun b p => xor b (Nat.testBit (m p) j)) (Nat.testBit acc j) := by
+  induction l generalizing acc with
+  | nil => rfl
+  | cons p l ih =>
+    simp only [List.foldl_cons]
+    rw [ih, Nat.testBit_xor]
+
+theorem bodd_eq_decide (n : ℕ) : Nat.bodd n = decide (n % 2 = 1) := by
+  cases h : Nat.bodd n <;> simp [Nat.mod_two_of_bodd, h]
+
+/-- a xor-fold of Bools is the parity of the count of trues -/
+theorem foldl_xor_eq_parity (l : List ℕ) (f : ℕ → Bool) (b : Bool) :
+    l.foldl (fun b p => xor b (f p)) b = xor b (Nat.bodd (l.filter f).length) := by
+  induction l generalizing b with
+  | nil => simp
+  | cons p l ih =>
+    simp only [List.foldl_cons]
+    rw [ih]
+    cases hf : f p
+    · simp [List.filter_cons, hf]
+    · simp [List.filter_cons, hf, Nat.bodd_succ, Bool.xor_assoc]
+
+/-! ## The link's plaquettes, listed directly -/
+
+/-- the step back in direction μ: that digit decreased modulo L -/
+def stepM (L s mu : ℕ) : ℕ := s - coord L s mu * L ^ mu + ((coord L s mu + L - 1) % L) * L ^ mu
+
+/-- the six plaquettes containing the link (μ, s): for each pair containing μ, the plaquette at s and the plaquette
+a step back in the pair's other direction -/
+def linkPlaqs (L mu s : ℕ) : List ℕ :=
+  (List.range 6).flatMap (fun q =>
+    if Torus4.pairMu q = mu then [plaq L q s, plaq L q (stepM L s (Torus4.pairNu q))]
+    else if Torus4.pairNu q = mu then [plaq L q s, plaq L q (stepM L s (Torus4.pairMu q))]
+    else [])
+
+def linkPlaqsOf (L l : ℕ) : List ℕ := linkPlaqs L (l / V L) (l % V L)
+
+/-- the links of a plaquette as a mask over the links -/
+def plaqLinkMask (L p : ℕ) : ℕ := Torus4.maskOf (plaqLinks L (p / V L) (p % V L))
+
+/-- CONSISTENCY, ONE WAY: every link of every plaquette is in range and lists the plaquette -/
+abbrev C1 (L : ℕ) : Prop :=
+  ((List.range (nPlaq L)).all (fun p => (plaqLinks L (p / V L) (p % V L)).all (fun l =>
+    decide (l < nLinks L) && (linkPlaqsOf L l).contains p))) = true
+
+/-- CONSISTENCY, THE OTHER WAY: every plaquette of every link is in range and lists the link -/
+abbrev C2 (L : ℕ) : Prop :=
+  ((List.range (nLinks L)).all (fun l => (linkPlaqsOf L l).all (fun p =>
+    decide (p < nPlaq L) && (plaqLinks L (p / V L) (p % V L)).contains l))) = true
+
+theorem mem_linkCobd_iff (L l p : ℕ) :
+    p ∈ linkCobd L l ↔ p < nPlaq L ∧ l ∈ plaqLinks L (p / V L) (p % V L) := by
+  unfold linkCobd
+  simp [List.mem_filter]
+
+theorem mem_linkPlaqs_iff (L : ℕ) (c1 : C1 L) (c2 : C2 L) (l : ℕ) (hl : l < nLinks L) (p : ℕ) :
+    p ∈ linkPlaqsOf L l ↔ p < nPlaq L ∧ l ∈ plaqLinks L (p / V L) (p % V L) := by
+  constructor
+  · intro hp
+    unfold C2 at c2
+    rw [List.all_eq_true] at c2
+    have h := c2 l (List.mem_range.mpr hl)
+    rw [List.all_eq_true] at h
+    have h := h p hp
+    simpa using h
+  · rintro ⟨hp, hlp⟩
+    unfold C1 at c1
+    rw [List.all_eq_true] at c1
+    have h := c1 p (List.mem_range.mpr hp)
+    rw [List.all_eq_true] at h
+    have h := h l hlp
+    have h' : l < nLinks L ∧ p ∈ linkPlaqsOf L l := by simpa using h
+    exact h'.2
+
+/-- THE COBOUNDARY MASK WITHOUT THE FILTER -/
+theorem cobdMask_eq (L : ℕ) (c1 : C1 L) (c2 : C2 L) (l : ℕ) (hl : l < nLinks L) :
+    cobdMask L l = Torus4.maskOf (linkPlaqsOf L l) := by
+  unfold cobdMask
+  apply Nat.eq_of_testBit_eq
+  intro p
+  rw [testBit_maskOf, testBit_maskOf, decide_eq_decide, mem_linkCobd_iff, mem_linkPlaqs_iff L c1 c2 l hl]
+
+/-- the direct form of the coboundary masks -/
+def cobdMasksD (L : ℕ) : List ℕ := (List.range (nLinks L)).map (fun l => Torus4.maskOf (linkPlaqsOf L l))
+
+theorem cobdMasks_eq (L : ℕ) (c1 : C1 L) (c2 : C2 L) : cobdMasks L = cobdMasksD L := by
+  unfold cobdMasks cobdMasksD
+  apply List.map_congr_left
+  intro l hl
+  exact cobdMask_eq L c1 c2 l (List.mem_range.mp hl)
+
+/-! ## The boundary of a boundary as a xor identity -/
+
+/-- the xor over a cube's faces of their link masks is zero -/
+abbrev DDX (L : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k =>
+    ((cubeFaces L (k / V L) (k % V L)).foldl (fun acc p => acc ^^^ plaqLinkMask L p) 0) == 0)) = true
+
+/-- the parity of a list's members lying in a link's plaquettes, read as the bit of the xor of their link masks -/
+theorem parity_eq_bit (L : ℕ) (c1 : C1 L) (c2 : C2 L) (A : List ℕ) (hlt : ∀ p ∈ A, p < nPlaq L)
+    (l : ℕ) (hl : l < nLinks L) :
+    decide ((A.filter (fun p => decide (p ∈ linkPlaqsOf L l))).length % 2 = 1)
+      = Nat.testBit (A.foldl (fun acc p => acc ^^^ plaqLinkMask L p) 0) l := by
+  have hfilt : A.filter (fun p => decide (p ∈ linkPlaqsOf L l))
+      = A.filter (fun p => Nat.testBit (plaqLinkMask L p) l) := by
+    apply List.filter_congr
+    intro p hp
+    rw [plaqLinkMask, testBit_maskOf, Bool.eq_iff_iff, decide_eq_true_iff, decide_eq_true_iff,
+      mem_linkPlaqs_iff L c1 c2 l hl]
+    exact ⟨fun h => h.2, fun h => ⟨hlt p hp, h⟩⟩
+  rw [testBit_xorFold, Nat.zero_testBit, foldl_xor_eq_parity, Bool.false_xor, bodd_eq_decide, hfilt]
+
+/-- THE MASK FORM OF ∂₂∂₃ = 0 FROM THE XOR IDENTITY -/
+theorem dd_of_xor (L : ℕ) (c1 : C1 L) (c2 : C2 L) (hok : FacesOK L) (hx : DDX L) :
+    ((cubeMasks L).all (fun c => (cobdMasks L).all (fun l => !(parAnd L c l)))) = true := by
+  rw [List.all_eq_true]
+  intro c hc
+  rw [cubeMasks, List.mem_map] at hc
+  obtain ⟨k, hk, rfl⟩ := hc
+  rw [List.all_eq_true]
+  intro m hm
+  rw [cobdMasks, List.mem_map] at hm
+  obtain ⟨l, hl, rfl⟩ := hm
+  have hl' := List.mem_range.mp hl
+  rw [cobdMask_eq L c1 c2 l hl']
+  unfold cubeMask
+  rw [parAnd_maskOf]
+  unfold FacesOK at hok
+  rw [List.all_eq_true] at hok
+  have hk' := hok k hk
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hk'
+  have hnd : (cubeFaces L (k / V L) (k % V L)).Nodup := hk'.1
+  have hlt : ∀ p ∈ cubeFaces L (k / V L) (k % V L), p < nPlaq L := fun p hp => by simpa using hk'.2 p hp
+  rw [card_filter_fin_eq_length (nPlaq L) _ hnd hlt (fun p => p ∈ linkPlaqsOf L l),
+    parity_eq_bit L c1 c2 _ hlt l hl']
+  unfold DDX at hx
+  rw [List.all_eq_true] at hx
+  have hxk := hx k hk
+  rw [beq_iff_eq] at hxk
+  rw [hxk, Nat.zero_testBit]
+  rfl
+
+/-! ## The sheets' cyclicity as a xor identity -/
+
+/-- the xor over a sheet's plaquettes of their link masks is zero -/
+abbrev SHX (L : ℕ) : Prop :=
+  ((List.range 6).all (fun q =>
+    ((sheetList L q).foldl (fun acc p => acc ^^^ plaqLinkMask L p) 0) == 0)) = true
+
+/-- THE MASK FORM OF THE SHEETS' CYCLICITY FROM THE XOR IDENTITY -/
+theorem sheets_of_xor (L : ℕ) (c1 : C1 L) (c2 : C2 L) (hok : SheetsOK L) (hx : SHX L) :
+    ((sheetMasks L).all (fun h => (cobdMasks L).all (fun l => !(parAnd L h l)))) = true := by
+  rw [List.all_eq_true]
+  intro c hc
+  rw [sheetMasks, List.mem_map] at hc
+  obtain ⟨q, hq, rfl⟩ := hc
+  rw [List.all_eq_true]
+  intro m hm
+  rw [cobdMasks, List.mem_map] at hm
+  obtain ⟨l, hl, rfl⟩ := hm
+  have hl' := List.mem_range.mp hl
+  rw [cobdMask_eq L c1 c2 l hl', sheetMask_eq_maskOf, parAnd_maskOf]
+  unfold SheetsOK at hok
+  rw [List.all_eq_true] at hok
+  have hq' := hok q hq
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hq'
+  have hnd : (sheetList L q).Nodup := hq'.1
+  have hlt : ∀ p ∈ sheetList L q, p < nPlaq L := fun p hp => by simpa using hq'.2 p hp
+  rw [card_filter_fin_eq_length (nPlaq L) _ hnd hlt (fun p => p ∈ linkPlaqsOf L l),
+    parity_eq_bit L c1 c2 _ hlt l hl']
+  unfold SHX at hx
+  rw [List.all_eq_true] at hx
+  have hxq := hx q hq
+  rw [beq_iff_eq] at hxq
+  rw [hxq, Nat.zero_testBit]
+  rfl
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusLinearDual.lean b/LEAN/aperanton/Aperanton/TorusLinearDual.lean
new file mode 100644
index 000000000..aa216b0ed
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusLinearDual.lean
@@ -0,0 +1,218 @@
+/-
+  APERANTON -- THE BOUNDLESS, THE EVERY-L STEP (2026-10-28): THE LINEAR GEOMETRY, THE DUAL FACTS -- the four facts the
+  dual factor system needs at a side (every plaquette on four cubes, every cube with six faces, every cube's column its
+  face mask, the adjacency along a wall) from decides LINEAR in the volume: the four cubes of a plaquette LISTED
+  DIRECTLY (`plaqCubes`: for each triple containing the pair, the cube at the site and the cube a step back in the
+  triple's third direction) and checked to be distinct members having the plaquette as a face; their COMPLETENESS by
+  THE DOUBLE COUNT (the incidences counted by plaquette and by cube: Σ_p #cubes(p) = Σ_k #faces(k) = 6 · 4V = 4 · 6V, so
+  four listed cubes each is four cubes each); the multiplicity read as membership (the faces distinct); and the
+  adjacency over the listed cubes only.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.TorusL
+import Aperanton.TorusLocal
+import Aperanton.TorusSysL
+import Aperanton.TorusLevels
+import Aperanton.TorusLinear
+
+namespace Aperanton
+
+namespace TorusL
+
+open Finset
+
+/-! ## The cubes of a plaquette, listed directly -/
+
+def tripHas (c d : ℕ) : Bool :=
+  decide (Torus4.tripA c = d) || decide (Torus4.tripB c = d) || decide (Torus4.tripC c = d)
+
+/-- the direction of the triple c outside the pair (a, b) -/
+def third (c a b : ℕ) : ℕ :=
+  if Torus4.tripA c ≠ a ∧ Torus4.tripA c ≠ b then Torus4.tripA c
+  else if Torus4.tripB c ≠ a ∧ Torus4.tripB c ≠ b then Torus4.tripB c else Torus4.tripC c
+
+/-- the four cubes containing the plaquette (q, s): for each triple containing the pair, the cube at s and the cube a
+step back in the triple's third direction -/
+def plaqCubes (L q s : ℕ) : List ℕ :=
+  (List.range 4).flatMap (fun c =>
+    if tripHas c (Torus4.pairMu q) && tripHas c (Torus4.pairNu q) then
+      [cube L c s, cube L c (stepM L s (third c (Torus4.pairMu q) (Torus4.pairNu q)))]
+    else [])
+
+def plaqCubesOf (L p : ℕ) : List ℕ := plaqCubes L (p / V L) (p % V L)
+
+/-- every plaquette's listed cubes: four, distinct, in range, each having the plaquette as a face -/
+abbrev PC (L : ℕ) : Prop :=
+  ((List.range (nPlaq L)).all (fun p => decide ((plaqCubesOf L p).Nodup) && ((plaqCubesOf L p).length == 4) &&
+    (plaqCubesOf L p).all (fun k => decide (k < nCubes L) && (cubeFaces L (k / V L) (k % V L)).contains p))) = true
+
+/-- every cube has six faces -/
+abbrev CubeSix (L : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k => (cubeFaces L (k / V L) (k % V L)).length == 6)) = true
+
+/-- the adjacency over the listed cubes: a cube's level against the levels of the cubes of each of its faces -/
+abbrev AdjInc (L mu : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k => (cubeFaces L (k / V L) (k % V L)).all (fun i =>
+    (plaqCubesOf L i).all (fun k' => decide (levelN L mu k' ≤ levelN L mu k + 1))))) = true
+
+/-! ## The faces, read -/
+
+theorem facesOK_at (L : ℕ) (hok : FacesOK L) (k : ℕ) (hk : k < nCubes L) :
+    (cubeFaces L (k / V L) (k % V L)).Nodup ∧ ∀ p ∈ cubeFaces L (k / V L) (k % V L), p < nPlaq L := by
+  unfold FacesOK at hok
+  rw [List.all_eq_true] at hok
+  have h := hok k (List.mem_range.mpr hk)
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
+  exact ⟨h.1, fun p hp => by simpa using h.2 p hp⟩
+
+theorem cubeSix_at (L : ℕ) (h6 : CubeSix L) (k : ℕ) (hk : k < nCubes L) :
+    (cubeFaces L (k / V L) (k % V L)).length = 6 := by
+  unfold CubeSix at h6
+  rw [List.all_eq_true] at h6
+  have h := h6 k (List.mem_range.mpr hk)
+  simpa using h
+
+/-- the multiplicity modulo two is the membership, the faces being distinct -/
+theorem cubeMult_mod_two (L : ℕ) (hok : FacesOK L) (i : Fin (nPlaq L)) (k : Fin (nCubes L)) :
+    (((cubeMult L i k : ℕ) : ZMod 2) = 1) ↔ i.val ∈ cubeFaces L (k.val / V L) (k.val % V L) := by
+  have hnd := (facesOK_at L hok k.val k.isLt).1
+  unfold cubeMult
+  by_cases hm : i.val ∈ cubeFaces L (k.val / V L) (k.val % V L)
+  · rw [List.count_eq_one_of_mem hnd hm]
+    simp [hm]
+  · rw [List.count_eq_zero_of_not_mem hm]
+    simp [hm]
+
+/-- a nodup list's members below the width, counted as a Fin-filter card -/
+theorem card_filter_mem (n : ℕ) (A : List ℕ) (hnd : A.Nodup) (hlt : ∀ a ∈ A, a < n) :
+    (univ.filter (fun p : Fin n => p.val ∈ A)).card = A.length := by
+  have := card_filter_fin_eq_length n A hnd hlt (fun _ => True)
+  simpa using this
+
+/-! ## The six faces and the column -/
+
+theorem hsix_of (L : ℕ) (hok : FacesOK L) (h6 : CubeSix L) (s : Fin (nCubes L)) :
+    (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6 := by
+  obtain ⟨hnd, hlt⟩ := facesOK_at L hok s.val s.isLt
+  rw [Finset.filter_congr (fun i _ => cubeMult_mod_two L hok i s), card_filter_mem (nPlaq L) _ hnd hlt]
+  exact cubeSix_at L h6 s.val s.isLt
+
+theorem hcol_of (L : ℕ) (hok : FacesOK L) (k : Fin (nCubes L)) (i : Fin (nPlaq L)) :
+    ((cubeMult L i k : ℕ) : ZMod 2) = vecOf L (cubeMask L k.val) i := by
+  have hnd := (facesOK_at L hok k.val k.isLt).1
+  unfold vecOf cubeMask cubeMult
+  rw [vecOfN_apply, testBit_maskOf]
+  by_cases hm : i.val ∈ cubeFaces L (k.val / V L) (k.val % V L)
+  · rw [List.count_eq_one_of_mem hnd hm]
+    simp [hm]
+  · rw [List.count_eq_zero_of_not_mem hm]
+    simp [hm]
+
+/-! ## The four cubes, by the double count -/
+
+/-- the cubes having a given plaquette as a face are exactly four -/
+theorem card_cubes_eq_four (L : ℕ) (hok : FacesOK L) (h6 : CubeSix L) (hpc : PC L) (i : Fin (nPlaq L)) :
+    (univ.filter (fun k : Fin (nCubes L) => i.val ∈ cubeFaces L (k.val / V L) (k.val % V L))).card = 4 := by
+  set a : Fin (nPlaq L) → ℕ := fun i =>
+    (univ.filter (fun k : Fin (nCubes L) => i.val ∈ cubeFaces L (k.val / V L) (k.val % V L))).card with ha
+  show a i = 4
+  have hlow : ∀ i : Fin (nPlaq L), 4 ≤ a i := by
+    intro i
+    unfold PC at hpc
+    rw [List.all_eq_true] at hpc
+    have hp := hpc i.val (List.mem_range.mpr i.isLt)
+    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.all_eq_true] at hp
+    obtain ⟨⟨hnd, hlen⟩, hmem⟩ := hp
+    have hsub : (univ.filter (fun k : Fin (nCubes L) => k.val ∈ plaqCubesOf L i.val)) ⊆
+        (univ.filter (fun k : Fin (nCubes L) => i.val ∈ cubeFaces L (k.val / V L) (k.val % V L))) := by
+      intro k hk
+      rw [Finset.mem_filter] at hk ⊢
+      refine ⟨hk.1, ?_⟩
+      have := (hmem k.val hk.2).2
+      simpa using this
+    have hcard := card_filter_mem (nCubes L) (plaqCubesOf L i.val) hnd (fun k hk => (hmem k hk).1)
+    rw [hlen] at hcard
+    calc 4 = _ := hcard.symm
+      _ ≤ a i := Finset.card_le_card hsub
+  have hsum : ∑ i : Fin (nPlaq L), a i
+      = ∑ k : Fin (nCubes L), (cubeFaces L (k.val / V L) (k.val % V L)).length := by
+    simp only [ha, Finset.card_filter]
+    rw [Finset.sum_comm]
+    apply Finset.sum_congr rfl
+    intro k _
+    obtain ⟨hnd, hlt⟩ := facesOK_at L hok k.val k.isLt
+    rw [← Finset.card_filter, card_filter_mem (nPlaq L) _ hnd hlt]
+  have h6' : ∀ k : Fin (nCubes L), (cubeFaces L (k.val / V L) (k.val % V L)).length = 6 :=
+    fun k => cubeSix_at L h6 k.val k.isLt
+  simp only [h6', Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hsum
+  have htot : ∑ i : Fin (nPlaq L), (4 : ℕ) = ∑ i : Fin (nPlaq L), a i := by
+    rw [hsum]
+    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
+    unfold nPlaq nCubes
+    ring
+  exact ((Finset.sum_eq_sum_iff_of_le (fun i _ => hlow i)).mp htot i (Finset.mem_univ i)).symm
+
+theorem hdeg_of (L : ℕ) (hok : FacesOK L) (h6 : CubeSix L) (hpc : PC L) (i : Fin (nPlaq L)) :
+    (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4 := by
+  rw [Finset.filter_congr (fun k _ => cubeMult_mod_two L hok i k)]
+  exact card_cubes_eq_four L hok h6 hpc i
+
+/-- THE LISTED CUBES ARE ALL THE CUBES: a cube having the plaquette as a face is among its four -/
+theorem plaqCubes_complete (L : ℕ) (hok : FacesOK L) (h6 : CubeSix L) (hpc : PC L) (i : Fin (nPlaq L))
+    (k : Fin (nCubes L)) (hm : i.val ∈ cubeFaces L (k.val / V L) (k.val % V L)) :
+    k.val ∈ plaqCubesOf L i.val := by
+  have hpc' := hpc
+  unfold PC at hpc'
+  rw [List.all_eq_true] at hpc'
+  have hp := hpc' i.val (List.mem_range.mpr i.isLt)
+  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.all_eq_true] at hp
+  obtain ⟨⟨hnd, hlen⟩, hmem⟩ := hp
+  have hsub : (univ.filter (fun k : Fin (nCubes L) => k.val ∈ plaqCubesOf L i.val)) ⊆
+      (univ.filter (fun k : Fin (nCubes L) => i.val ∈ cubeFaces L (k.val / V L) (k.val % V L))) := by
+    intro k hk
+    rw [Finset.mem_filter] at hk ⊢
+    refine ⟨hk.1, ?_⟩
+    have := (hmem k.val hk.2).2
+    simpa using this
+  have hcardB := card_filter_mem (nCubes L) (plaqCubesOf L i.val) hnd (fun k hk => (hmem k hk).1)
+  rw [hlen] at hcardB
+  have hcardA := card_cubes_eq_four L hok h6 hpc i
+  have heq := Finset.eq_of_subset_of_card_le hsub (by rw [hcardA, hcardB])
+  have hkA : k ∈ (univ.filter (fun k : Fin (nCubes L) => i.val ∈ cubeFaces L (k.val / V L) (k.val % V L))) :=
+    Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm⟩
+  rw [← heq, Finset.mem_filter] at hkA
+  exact hkA.2
+
+/-! ## The adjacency from the listed cubes -/
+
+theorem adjList_of (L mu : ℕ) (hok : FacesOK L) (h6 : CubeSix L) (hpc : PC L) (hinc : AdjInc L mu) :
+    AdjList L mu := by
+  unfold AdjList
+  rw [List.all_eq_true]
+  intro k hk
+  rw [List.all_eq_true]
+  intro i hi
+  rw [List.all_eq_true]
+  intro k' hk'
+  rw [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, decide_eq_true_eq]
+  by_cases hm : i ∈ cubeFaces L (k' / V L) (k' % V L)
+  · right
+    have hkl := List.mem_range.mp hk
+    have hk'l := List.mem_range.mp hk'
+    have hil : i < nPlaq L := (facesOK_at L hok k hkl).2 i hi
+    have hk'mem : k' ∈ plaqCubesOf L i :=
+      plaqCubes_complete L hok h6 hpc ⟨i, hil⟩ ⟨k', hk'l⟩ hm
+    unfold AdjInc at hinc
+    rw [List.all_eq_true] at hinc
+    have h1 := hinc k hk
+    rw [List.all_eq_true] at h1
+    have h2 := h1 i hi
+    rw [List.all_eq_true] at h2
+    have h3 := h2 k' hk'mem
+    simpa using h3
+  · left
+    exact hm
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusLocal.lean b/LEAN/aperanton/Aperanton/TorusLocal.lean
new file mode 100644
index 000000000..8a2a60a30
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusLocal.lean
@@ -0,0 +1,270 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6′ (ADDENDUM I, THE ROAD): THE EVERY-L STEP'S FIRST LEMMAS -- A MASK'S BIT IS
+  MEMBERSHIP IN ITS LIST, AND A MASK PARITY IS AN INTERSECTION COUNT.
+
+  The side-3 certificate decides ∂₂∂₃ = 0 as a mask parity for every pair of a cube and a link: 4V·4V parities each a
+  6V-deep recursion (`Torus4.par`), 105,000 × 486 at side 3 and 1,000,000 × 1536 at side 4 -- the one decide that
+  does not scale.  The parity of the and of two masks built from lists is the parity of the lists' intersection
+  count (`parAnd_maskOf`), because a mask's bit is membership in its list (`testBit_maskOf`); so the same fact reads
+  LOCALLY -- a cube's faces against a link's plaquettes, six against six -- and a side's instance decides the local
+  form in time linear in the volume.  W = 0; the earning is the decide that scales.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.TorusL
+import Aperanton.Bridge
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- one bit set: the bit of `1 <<< i` is the index itself -/
+theorem testBit_bitOf (i p : ℕ) : Nat.testBit (Torus4.bitOf i) p = decide (p = i) := by
+  unfold Torus4.bitOf
+  rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
+  by_cases h : p = i
+  · subst h; simp
+  · simp [h, Ne.symm h]
+
+/-- a bit of a mask built from a list is set iff the index is in the list -/
+theorem testBit_maskOf (l : List ℕ) (p : ℕ) : Nat.testBit (Torus4.maskOf l) p = decide (p ∈ l) := by
+  unfold Torus4.maskOf
+  suffices h : ∀ acc : ℕ, Nat.testBit (l.foldl (fun m i => Nat.lor m (Torus4.bitOf i)) acc) p
+      = (Nat.testBit acc p || decide (p ∈ l)) by
+    rw [h 0, Nat.zero_testBit, Bool.false_or]
+  induction l with
+  | nil => intro acc; simp
+  | cons i t ih =>
+    intro acc
+    rw [List.foldl_cons, ih]
+    have hlor : Nat.testBit (Nat.lor acc (Torus4.bitOf i)) p = (Nat.testBit acc p || decide (p = i)) := by
+      show Nat.testBit (acc ||| Torus4.bitOf i) p = _
+      rw [Nat.testBit_lor, testBit_bitOf]
+    rw [hlor]
+    by_cases hp : p = i
+    · subst hp; simp
+    · simp [hp, List.mem_cons]
+
+/-- THE PARITY OF THE AND OF TWO LIST MASKS IS THE PARITY OF THEIR INTERSECTION COUNT (below the width) -/
+theorem parAnd_maskOf (L : ℕ) (A B : List ℕ) :
+    parAnd L (Torus4.maskOf A) (Torus4.maskOf B) =
+      decide ((univ.filter (fun p : Fin (nPlaq L) => p.val ∈ A ∧ p.val ∈ B)).card % 2 = 1) := by
+  unfold parAnd
+  have hsum := sum_testBit_eq_par (nPlaq L) (Nat.land (Torus4.maskOf A) (Torus4.maskOf B))
+  have hpt : ∀ i : Fin (nPlaq L),
+      (if Nat.testBit (Nat.land (Torus4.maskOf A) (Torus4.maskOf B)) i.val then (1 : ZMod 2) else 0)
+        = if i.val ∈ A ∧ i.val ∈ B then 1 else 0 := by
+    intro i
+    have hland : Nat.land (Torus4.maskOf A) (Torus4.maskOf B) = Torus4.maskOf A &&& Torus4.maskOf B := rfl
+    rw [hland, Nat.testBit_land, testBit_maskOf, testBit_maskOf]
+    by_cases ha : i.val ∈ A <;> by_cases hb : i.val ∈ B <;> simp [ha, hb]
+  simp_rw [hpt] at hsum
+  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_one] at hsum
+  -- hsum : (card : ZMod 2) = if par .. then 1 else 0
+  set c := (univ.filter (fun p : Fin (nPlaq L) => p.val ∈ A ∧ p.val ∈ B)).card with hc
+  have hmod : ((c : ℕ) : ZMod 2) = ((c % 2 : ℕ) : ZMod 2) := (ZMod.natCast_mod c 2).symm
+  rw [hmod] at hsum
+  rcases Nat.mod_two_eq_zero_or_one c with h0 | h1
+  · rw [h0] at hsum
+    simp only [Nat.cast_zero] at hsum
+    cases hpar : Torus4.par (nPlaq L) (Nat.land (Torus4.maskOf A) (Torus4.maskOf B))
+    · simp [h0]
+    · rw [hpar] at hsum
+      simp at hsum
+  · rw [h1] at hsum
+    simp only [Nat.cast_one] at hsum
+    cases hpar : Torus4.par (nPlaq L) (Nat.land (Torus4.maskOf A) (Torus4.maskOf B))
+    · rw [hpar] at hsum
+      simp at hsum
+    · simp [h1]
+
+/-- the count of a nodup list's members below n satisfying P, as a Fin-filter card -/
+theorem card_filter_fin_eq_length (n : ℕ) (A : List ℕ) (hA : A.Nodup) (hlt : ∀ a ∈ A, a < n)
+    (P : ℕ → Prop) [DecidablePred P] :
+    (univ.filter (fun p : Fin n => p.val ∈ A ∧ P p.val)).card = (A.filter (fun a => decide (P a))).length := by
+  rw [← List.toFinset_card_of_nodup (List.Nodup.filter _ hA)]
+  apply Finset.card_bij (fun p _ => p.val)
+  · intro p hp
+    rw [Finset.mem_filter] at hp
+    rw [List.mem_toFinset, List.mem_filter]
+    exact ⟨hp.2.1, by simpa using hp.2.2⟩
+  · intro p _ q _ h
+    exact Fin.ext h
+  · intro a ha
+    rw [List.mem_toFinset, List.mem_filter] at ha
+    refine ⟨⟨a, hlt a ha.1⟩, ?_, rfl⟩
+    rw [Finset.mem_filter]
+    exact ⟨Finset.mem_univ _, ha.1, by simpa using ha.2⟩
+
+/-- THE LOCAL FORM OF ∂₂∂₃ = 0: every cube's faces meet every link's plaquettes an even number of times, as list counts
+(4V · 4V pairs, six faces against four links each) -/
+abbrev LocalDD (L : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k => (List.range (nLinks L)).all (fun l =>
+    ((cubeFaces L (k / V L) (k % V L)).filter
+      (fun p => (plaqLinks L (p / V L) (p % V L)).contains l)).length % 2 == 0))) = true
+
+/-- the faces of every cube are distinct and below the width -/
+abbrev FacesOK (L : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k => decide ((cubeFaces L (k / V L) (k % V L)).Nodup) &&
+    (cubeFaces L (k / V L) (k % V L)).all (fun p => p < nPlaq L))) = true
+
+/-- THE MASK FORM FROM THE LOCAL FORM: the decide that scales gives the decide the bridge reads -/
+theorem dd_of_local (L : ℕ) (hloc : LocalDD L) (hok : FacesOK L) :
+    ((cubeMasks L).all (fun c => (cobdMasks L).all (fun l => !(parAnd L c l)))) = true := by
+  rw [List.all_eq_true]
+  intro c hc
+  rw [cubeMasks, List.mem_map] at hc
+  obtain ⟨k, hk, rfl⟩ := hc
+  rw [List.all_eq_true]
+  intro m hm
+  rw [cobdMasks, List.mem_map] at hm
+  obtain ⟨l, hl, rfl⟩ := hm
+  unfold cubeMask cobdMask
+  rw [parAnd_maskOf]
+  unfold FacesOK at hok
+  rw [List.all_eq_true] at hok
+  have hk' := hok k hk
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hk'
+  have hnd : (cubeFaces L (k / V L) (k % V L)).Nodup := hk'.1
+  have hlt : ∀ p ∈ cubeFaces L (k / V L) (k % V L), p < nPlaq L := fun p hp => by simpa using hk'.2 p hp
+  unfold LocalDD at hloc
+  rw [List.all_eq_true] at hloc
+  have hkl := hloc k hk
+  rw [List.all_eq_true] at hkl
+  have hev := hkl l hl
+  simp only [beq_iff_eq] at hev
+  rw [card_filter_fin_eq_length (nPlaq L) _ hnd hlt (fun p => p ∈ linkCobd L l)]
+  have hfilt : (cubeFaces L (k / V L) (k % V L)).filter (fun p => decide (p ∈ linkCobd L l))
+      = (cubeFaces L (k / V L) (k % V L)).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l) := by
+    apply List.filter_congr
+    intro p hp
+    rw [Bool.eq_iff_iff, decide_eq_true_iff]
+    simp only [linkCobd, List.mem_filter, List.mem_range]
+    constructor
+    · intro h
+      exact h.2
+    · intro h
+      exact ⟨hlt p hp, h⟩
+  rw [hfilt, hev]
+  decide
+
+/-- the sheet of the pair q as a list of plaquettes -/
+def sheetList (L q : ℕ) : List ℕ :=
+  ((List.range (V L)).filter (fun s =>
+    (List.range 4).all (fun d => d = Torus4.pairMu q || d = Torus4.pairNu q || coord L s d = 0))).map
+      (fun s => plaq L q s)
+
+theorem sheetMask_eq_maskOf (L q : ℕ) : sheetMask L q = Torus4.maskOf (sheetList L q) := rfl
+
+/-- THE LOCAL FORM OF THE SHEETS' CYCLICITY: every sheet meets every link's plaquettes an even number of times -/
+abbrev LocalSheets (L : ℕ) : Prop :=
+  ((List.range 6).all (fun q => (List.range (nLinks L)).all (fun l =>
+    ((sheetList L q).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l)).length % 2 == 0))) = true
+
+/-- the plaquettes of every sheet are distinct and below the width -/
+abbrev SheetsOK (L : ℕ) : Prop :=
+  ((List.range 6).all (fun q => decide ((sheetList L q).Nodup) && (sheetList L q).all (fun p => p < nPlaq L))) = true
+
+/-- THE MASK FORM OF THE SHEETS' CYCLICITY FROM THE LOCAL FORM -/
+theorem sheets_of_local (L : ℕ) (hloc : LocalSheets L) (hok : SheetsOK L) :
+    ((sheetMasks L).all (fun h => (cobdMasks L).all (fun l => !(parAnd L h l)))) = true := by
+  rw [List.all_eq_true]
+  intro c hc
+  rw [sheetMasks, List.mem_map] at hc
+  obtain ⟨q, hq, rfl⟩ := hc
+  rw [List.all_eq_true]
+  intro m hm
+  rw [cobdMasks, List.mem_map] at hm
+  obtain ⟨l, hl, rfl⟩ := hm
+  unfold cobdMask
+  rw [sheetMask_eq_maskOf, parAnd_maskOf]
+  unfold SheetsOK at hok
+  rw [List.all_eq_true] at hok
+  have hq' := hok q hq
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hq'
+  have hnd : (sheetList L q).Nodup := hq'.1
+  have hlt : ∀ p ∈ sheetList L q, p < nPlaq L := fun p hp => by simpa using hq'.2 p hp
+  unfold LocalSheets at hloc
+  rw [List.all_eq_true] at hloc
+  have hql := hloc q hq
+  rw [List.all_eq_true] at hql
+  have hev := hql l hl
+  simp only [beq_iff_eq] at hev
+  rw [card_filter_fin_eq_length (nPlaq L) _ hnd hlt (fun p => p ∈ linkCobd L l)]
+  have hfilt : (sheetList L q).filter (fun p => decide (p ∈ linkCobd L l))
+      = (sheetList L q).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l) := by
+    apply List.filter_congr
+    intro p hp
+    rw [Bool.eq_iff_iff, decide_eq_true_iff]
+    simp only [linkCobd, List.mem_filter, List.mem_range]
+    constructor
+    · intro h
+      exact h.2
+    · intro h
+      exact ⟨hlt p hp, h⟩
+  rw [hfilt, hev]
+  decide
+
+/-! ## The incident forms: the decides that are LINEAR in the volume
+
+A link off every face of a cube meets its faces zero times, an even count for free; only the links ON the cube's faces
+need their count read.  So the local form is quantified over the cube's own incident links (six faces, four links each)
+and the all-links form follows by a case split -- the certificate at side L decides 24 counts per cube, never 4V. -/
+
+/-- the local form of ∂₂∂₃ = 0 over the INCIDENT links only -/
+abbrev LocalDDInc (L : ℕ) : Prop :=
+  ((List.range (nCubes L)).all (fun k =>
+    ((cubeFaces L (k / V L) (k % V L)).flatMap (fun p => plaqLinks L (p / V L) (p % V L))).all (fun l =>
+      ((cubeFaces L (k / V L) (k % V L)).filter
+        (fun p => (plaqLinks L (p / V L) (p % V L)).contains l)).length % 2 == 0))) = true
+
+/-- THE INCIDENT FORM GIVES THE ALL-LINKS FORM: a link on no face has the empty filter -/
+theorem localDD_of_inc (L : ℕ) (h : LocalDDInc L) : LocalDD L := by
+  unfold LocalDD LocalDDInc at *
+  rw [List.all_eq_true] at h ⊢
+  intro k hk
+  have hk' := h k hk
+  rw [List.all_eq_true] at hk' ⊢
+  intro l _
+  by_cases hmem : l ∈ (cubeFaces L (k / V L) (k % V L)).flatMap (fun p => plaqLinks L (p / V L) (p % V L))
+  · exact hk' l hmem
+  · have hfilt : (cubeFaces L (k / V L) (k % V L)).filter
+        (fun p => (plaqLinks L (p / V L) (p % V L)).contains l) = [] := by
+      rw [List.filter_eq_nil_iff]
+      intro p hp hcont
+      apply hmem
+      rw [List.mem_flatMap]
+      exact ⟨p, hp, by simpa using hcont⟩
+    rw [hfilt]
+    decide
+
+/-- the local form of the sheets' cyclicity over the INCIDENT links only -/
+abbrev LocalSheetsInc (L : ℕ) : Prop :=
+  ((List.range 6).all (fun q =>
+    ((sheetList L q).flatMap (fun p => plaqLinks L (p / V L) (p % V L))).all (fun l =>
+      ((sheetList L q).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l)).length % 2 == 0))) = true
+
+/-- THE INCIDENT FORM GIVES THE ALL-LINKS FORM for the sheets -/
+theorem localSheets_of_inc (L : ℕ) (h : LocalSheetsInc L) : LocalSheets L := by
+  unfold LocalSheets LocalSheetsInc at *
+  rw [List.all_eq_true] at h ⊢
+  intro q hq
+  have hq' := h q hq
+  rw [List.all_eq_true] at hq' ⊢
+  intro l _
+  by_cases hmem : l ∈ (sheetList L q).flatMap (fun p => plaqLinks L (p / V L) (p % V L))
+  · exact hq' l hmem
+  · have hfilt : (sheetList L q).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l) = [] := by
+      rw [List.filter_eq_nil_iff]
+      intro p hp hcont
+      apply hmem
+      rw [List.mem_flatMap]
+      exact ⟨p, hp, by simpa using hcont⟩
+    rw [hfilt]
+    decide
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusSysL.lean b/LEAN/aperanton/Aperanton/TorusSysL.lean
new file mode 100644
index 000000000..6262e681d
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusSysL.lean
@@ -0,0 +1,213 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6 (ADDENDUM I, THE ROAD): THE DUAL SECTOR AS A FACTOR SYSTEM ON THE FOUR-TORUS OF
+  ANY SIDE.
+
+  TorusSys.lean read the side-2 dual sectors as Gibbs measures; here the side L is a parameter: the dual lattice's
+  links are the 4V cubes, its plaquettes the 6V plaquettes, the twist h a shift, the coupling y -- `torusSys L`, a
+  `Z2Sys`.  THE PARITY IS THE DUAL COBOUNDARY SHIFTED BY THE TWIST (`par_eq`), THE WEIGHT y TO THE TWISTED FIELD'S
+  WEIGHT (`W_eq_pow`), THE FIBRE BRIDGE (`sum_W_eq`: the sector's partition function is |ker δ*| times Weak.lean's
+  coset enumerator) and THE SECTOR'S EXPECTATION AS A GIBBS EXPECTATION (`sectorExp_eq_gibbs`).  THE ROW SUM at any
+  side is a DOUBLE COUNT, not a decide over every pair of cubes: with every plaquette on four cubes (`hdeg`) and the
+  cube s carrying six faces (`hsix`) -- two facts each side's instance decides, 6V·4V evaluations against the
+  4V·4V·6V of the pairwise reading -- Σ_{t ≠ s} shared(s, t) = Σ_{i ∈ faces(s)} (4 − 1) = 18 (`shared_row_of`), so
+  Dobrushin's row is at most 18·c₁(y) (`rowsum_le_of`), below one iff y > 17/19 at every side.  THE RANGE OF δ* IS
+  THE BOUNDARY CODE D L (`range_cobdDual_eq_D`) from the decided column fact (`hcol`: each cube's column is its face
+  mask).  W = 0 (a Gibbs measure written as a factor system); the earning is one system for every side.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Z2Slab
+import Aperanton.TorusL
+import Aperanton.TorusLBridge
+import Aperanton.Weak
+import Aperanton.Fibre
+import Aperanton.TorusSys
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- the dual incidence at side L: how many times plaquette i is a face of cube k -/
+def cubeMult (L : ℕ) (i : Fin (nPlaq L)) (k : Fin (nCubes L)) : ℕ :=
+  (cubeFaces L (k.val / V L) (k.val % V L)).count i.val
+
+/-- the dual theory's factor system on T⁴_L: sites the cubes, factors the plaquettes, the twist h, the coupling y -/
+def torusSys (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    Z2Sys (Fin (nCubes L)) (Fin (nPlaq L)) where
+  mult i k := cubeMult L i k
+  shift := h
+  y := y
+  y_pos := hy0
+  y_le := hy1
+
+theorem torusSys_y (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    (torusSys L h y hy0 hy1).y = y := rfl
+
+/-- the dual coboundary δ* : (cubes → F₂) → (plaquettes → F₂) at side L -/
+def cobdDual (L : ℕ) : (Fin (nCubes L) → ZMod 2) →ₗ[ZMod 2] (Fin (nPlaq L) → ZMod 2) where
+  toFun τ := fun i => ∑ k, (cubeMult L i k : ZMod 2) * τ k
+  map_add' := by
+    intro τ τ'
+    funext i
+    simp only [Pi.add_apply, mul_add, sum_add_distrib]
+  map_smul' := by
+    intro c τ
+    funext i
+    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_sum]
+    refine sum_congr rfl fun k _ => ?_
+    ring
+
+/-- the dual coboundary read at a plaquette: the sum over its cubes -/
+theorem cobdDual_apply (L : ℕ) (τ : Fin (nCubes L) → ZMod 2) (i : Fin (nPlaq L)) :
+    cobdDual L τ i = ∑ k, (cubeMult L i k : ZMod 2) * τ k := by
+  simp [cobdDual]
+
+/-- the configuration's additive reading -/
+def toAddConf (L : ℕ) (ω : Fin (nCubes L) → Z2) : Fin (nCubes L) → ZMod 2 := fun k => Multiplicative.toAdd (ω k)
+
+/-- THE PARITY IS THE DUAL COBOUNDARY SHIFTED BY THE TWIST -/
+theorem par_eq (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) : (torusSys L h y hy0 hy1).par i ω = h i + cobdDual L (toAddConf L ω) i := by
+  unfold Z2Sys.par
+  rw [cobdDual_apply]
+  rfl
+
+/-- THE WEIGHT IS y TO THE WEIGHT OF THE TWISTED PLAQUETTE FIELD -/
+theorem W_eq_pow (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (ω : Fin (nCubes L) → Z2) : (torusSys L h y hy0 hy1).W ω = y ^ wt (h + cobdDual L (toAddConf L ω)) := by
+  rw [← TorusSys.prod_ite_eq_pow]
+  unfold Z2Sys.W
+  refine Finset.prod_congr rfl fun i _ => ?_
+  unfold Z2Sys.w
+  rw [par_eq, Pi.add_apply, torusSys_y]
+
+/-- the additive reading is a bijection of configurations -/
+def confEquiv (L : ℕ) : (Fin (nCubes L) → Z2) ≃ (Fin (nCubes L) → ZMod 2) where
+  toFun := toAddConf L
+  invFun σ := fun k => Multiplicative.ofAdd (σ k)
+  left_inv _ := rfl
+  right_inv _ := rfl
+
+theorem confEquiv_apply (L : ℕ) (ω : Fin (nCubes L) → Z2) : confEquiv L ω = toAddConf L ω := rfl
+
+open Classical in
+/-- THE FIBRE BRIDGE: the sector's partition function over cube configurations is |ker δ*| times the coset
+enumerator of the range of δ* at y -/
+theorem sum_W_eq (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    ∑ ω, (torusSys L h y hy0 hy1).W ω =
+      (Fintype.card (LinearMap.ker (cobdDual L)) : ℝ) * enumAt (LinearMap.range (cobdDual L)) h y := by
+  simp only [W_eq_pow]
+  rw [Fintype.sum_equiv (confEquiv L) (fun ω => y ^ wt (h + cobdDual L (toAddConf L ω)))
+    (fun σ => y ^ wt (h + cobdDual L σ)) (fun ω => rfl)]
+  rw [sum_comp_linear (cobdDual L) (fun d => y ^ wt (h + d)), enumAt_eq_sum]
+
+/-- the sector's expectation of the twist-shift observable -/
+noncomputable def shiftObs (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (ω : Fin (nCubes L) → Z2) : ℝ :=
+  (torusSys L (h + s) y hy0 hy1).W ω / (torusSys L h y hy0 hy1).W ω
+
+open Classical in
+/-- THE SECTOR'S EXPECTATION IS A GIBBS EXPECTATION: E_{h+s}(y)/E_h(y) over the cube configurations -/
+theorem sectorExp_eq_gibbs (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    sectorExp (LinearMap.range (cobdDual L)) y h s =
+      gibbs (torusSys L h y hy0 hy1).W (shiftObs L h s y hy0 hy1) := by
+  unfold sectorExp gibbs shiftObs
+  have hnum : ∑ ω, (torusSys L h y hy0 hy1).W ω *
+      ((torusSys L (h + s) y hy0 hy1).W ω / (torusSys L h y hy0 hy1).W ω)
+      = ∑ ω, (torusSys L (h + s) y hy0 hy1).W ω := by
+    refine sum_congr rfl fun ω _ => ?_
+    rw [← mul_div_assoc, mul_div_cancel_left₀ _ ((torusSys L h y hy0 hy1).W_pos ω).ne']
+  rw [hnum, sum_W_eq, sum_W_eq]
+  have hk : (0 : ℝ) < Fintype.card (LinearMap.ker (cobdDual L)) := by
+    exact_mod_cast Fintype.card_pos_iff.mpr ⟨0⟩
+  rw [mul_div_mul_left _ _ hk.ne']
+
+/-! ## The row sum by a double count -/
+
+/-- THE DOUBLE COUNT: with every plaquette on four cubes and the cube s carrying six faces,
+Σ_{t ≠ s} |faces(s) ∩ faces(t)| = Σ_{i ∈ faces(s)} (4 − 1) = 18 -/
+theorem shared_row_of (L : ℕ) (s : Fin (nCubes L))
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6) :
+    ∑ t ∈ univ.erase s, (univ.filter (fun i : Fin (nPlaq L) =>
+      ((cubeMult L i s : ℕ) : ZMod 2) = 1 ∧ ((cubeMult L i t : ℕ) : ZMod 2) = 1)).card = 18 := by
+  have hterm : ∀ t : Fin (nCubes L), (univ.filter (fun i : Fin (nPlaq L) =>
+      ((cubeMult L i s : ℕ) : ZMod 2) = 1 ∧ ((cubeMult L i t : ℕ) : ZMod 2) = 1)).card
+      = ∑ i : Fin (nPlaq L), if ((cubeMult L i s : ℕ) : ZMod 2) = 1 then
+          (if ((cubeMult L i t : ℕ) : ZMod 2) = 1 then 1 else 0) else 0 := by
+    intro t
+    rw [Finset.card_filter]
+    refine sum_congr rfl fun i _ => ?_
+    by_cases h1 : ((cubeMult L i s : ℕ) : ZMod 2) = 1 <;>
+      by_cases h2 : ((cubeMult L i t : ℕ) : ZMod 2) = 1 <;> simp [h1, h2]
+  simp_rw [hterm]
+  rw [Finset.sum_comm]
+  have hcol : ∀ i : Fin (nPlaq L), (∑ t ∈ univ.erase s, if ((cubeMult L i s : ℕ) : ZMod 2) = 1 then
+      (if ((cubeMult L i t : ℕ) : ZMod 2) = 1 then 1 else 0) else 0)
+      = if ((cubeMult L i s : ℕ) : ZMod 2) = 1 then 3 else 0 := by
+    intro i
+    by_cases hA : ((cubeMult L i s : ℕ) : ZMod 2) = 1
+    · simp only [if_pos hA]
+      have h4 := hdeg i
+      rw [Finset.card_filter, ← Finset.add_sum_erase univ _ (mem_univ s), if_pos hA] at h4
+      omega
+    · simp only [if_neg hA, Finset.sum_const_zero]
+  simp_rw [hcol]
+  rw [← Finset.sum_filter, Finset.sum_const, hsix]
+  norm_num
+
+/-- THE ROW SUM OF THE DUAL SYSTEM'S INTERDEPENDENCE IS AT MOST 18·c₁ AT ANY SIDE -/
+theorem rowsum_le_of (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (s : Fin (nCubes L))
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6) :
+    ∑ t, (torusSys L h y hy0 hy1).C s t ≤ 18 * ((1 - y) / (1 + y)) := by
+  set Z := torusSys L h y hy0 hy1 with hZ
+  have hc1 : 0 ≤ (1 - y) / (1 + y) := Z.c1_nonneg
+  have hdiag : Z.C s s = 0 := by unfold Z2Sys.C; simp
+  rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ s), hdiag, zero_add]
+  have hoff : ∀ t ∈ Finset.univ.erase s, Z.C s t = (Z.shared s t : ℝ) * ((1 - y) / (1 + y)) := by
+    intro t ht
+    unfold Z2Sys.C
+    rw [if_neg (Finset.ne_of_mem_erase ht).symm]
+    rfl
+  rw [Finset.sum_congr rfl hoff, ← Finset.sum_mul]
+  apply mul_le_mul_of_nonneg_right _ hc1
+  have h18 : ∑ t ∈ Finset.univ.erase s, Z.shared s t = 18 := shared_row_of L s hdeg hsix
+  exact_mod_cast h18.le
+
+/-! ## The range of the dual coboundary -/
+
+/-- δ* on a cube's indicator is the cube's face mask, given the decided column fact -/
+theorem cobdDual_single (L : ℕ)
+    (hcol : ∀ (k : Fin (nCubes L)) (i : Fin (nPlaq L)), ((cubeMult L i k : ℕ) : ZMod 2) = vecOf L (cubeMask L k.val) i)
+    (k : Fin (nCubes L)) : cobdDual L (Pi.single k 1) = vecOf L (cubeMask L k.val) := by
+  funext i
+  rw [cobdDual_apply, Finset.sum_eq_single k (fun b _ hb => by rw [Pi.single_eq_of_ne hb, mul_zero])
+    (fun hk => absurd (mem_univ k) hk), Pi.single_eq_same, mul_one]
+  exact hcol k i
+
+/-- THE RANGE OF δ* IS THE BOUNDARY CODE D L -/
+theorem range_cobdDual_eq_D (L : ℕ)
+    (hcol : ∀ (k : Fin (nCubes L)) (i : Fin (nPlaq L)), ((cubeMult L i k : ℕ) : ZMod 2) = vecOf L (cubeMask L k.val) i) :
+    LinearMap.range (cobdDual L) = D L := by
+  apply le_antisymm
+  · intro x hx
+    obtain ⟨σ, rfl⟩ := LinearMap.mem_range.mp hx
+    rw [← Finset.univ_sum_single σ, map_sum]
+    refine Submodule.sum_mem _ fun k _ => ?_
+    rcases zmod2_cases (σ k) with h0 | h1
+    · rw [h0, Pi.single_zero, map_zero]
+      exact Submodule.zero_mem _
+    · rw [h1, cobdDual_single L hcol]
+      exact Submodule.subset_span ⟨k, rfl⟩
+  · apply Submodule.span_le.mpr
+    rintro _ ⟨k, rfl⟩
+    exact LinearMap.mem_range.mpr ⟨Pi.single k 1, cobdDual_single L hcol k⟩
+
+end TorusL
+
+end Aperanton
