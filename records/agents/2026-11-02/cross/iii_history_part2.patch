+theorem eater_law_sharp (e : Eater G Q) (z : ℝ) (hz : 1 ≤ z) :
+    z ^ (6 : ℝ) ≤ lamMax (T Q z) (T_herm Q z) ∧
+    lamMax (T Q z) (T_herm Q z) ≤ z ^ (6 : ℝ) * (1 + ((Fintype.card G : ℝ) - 1) * z ^ (-(2 * Q.δ))) ^ 2 ∧
