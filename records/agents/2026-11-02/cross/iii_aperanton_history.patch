+    have hR' : (0 : ℝ) < R := by exact_mod_cast hR
+    have := hlogu R
+    rw [div_add' _ _ _ hR'.ne']
+    apply div_le_div_of_nonneg_right _ hR'.le
+    linarith [this]
+
+end Moments
