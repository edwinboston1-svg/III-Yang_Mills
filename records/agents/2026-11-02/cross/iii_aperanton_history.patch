+/-- each sum as a selection (index mask) of the certificate's basis of the cube faces -/
+def selTrans : List ℕ := [0, 68585259519, 9205357638345294335, 262143, 35115652612607, 4713143110832790438399, 133956095, 17979214137393663, 511, 0, 1165350571647049467718865328606806016, 595494142120324849353943209825850621952, 78142844637338821382306267136, 9322804512398627690487394887060684800, 4763953136901821026780282150865011212288, 564364989047447043316656373760, 74582436038411253472635631354691715072, 8682538293037646820256251904, 0, 19551263673809440356751651444599674357415936, 9990771960566814312515909684102498312718909440, 343004625856305971171081604291222357147648, 156143328014809507098657925864570888581545984, 79925908903158848484371922187127759995473494016, 2477255631184432014013367142103272579399680, 1248879842742810041033908121224340602374586368, 38111625095145107907897956032358039683072, 0, 235072079617315135830159549910845445321776260123698733550403584, 1645504559072629504381148973083828194907331783373897613201899520, 5254270386678539371579433069773787753220953249559871488, 470144157483206809434139309295213200718956602507079717247516672, 3291009116393835546536118155641178699890067649007477476550508544, 8757117311130898952632388449622979588701588749266452480, 940288313214990156642098828063948711513317287273841684641742848, 1751423462226179790526477689924595917740317749853290496, 0, 246490000668487380290645763670360876244393901728447729210168237359104, 1725917074028378739022998216570563109460232201915361644110728849784832, 1441461992213376492927753003920239042364876618295015960293381505024, 492499514006236968416982276339415006141332844584130453100238680883200, 3451353660726019685881687182139819472573009444957958282901359905734656, 2402436653688960821546255006533731737274794363825026600488969175040, 984518540681736144669655301677523265935210730295495900880379567931392, 480487330737792164309251001306746347454958872765005320097793835008, 0, 62115717121115074086912802760493229072059980749533478996462718014193664, 4486135125413866461832591310480066544093