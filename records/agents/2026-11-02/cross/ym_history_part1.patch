+import sys
+import fitz  # PyMuPDF
+
+pdf, outdir, dpi = sys.argv[1], sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else 70
+doc = fitz.open(pdf)
+for i, page in enumerate(doc, start=1):
+    pix = page.get_pixmap(dpi=dpi)
+    pix.save(f"{outdir}/pg-{i:02d}.png")
+print("pages", len(doc))
diff --git a/source/ground/render.ps1 b/source/ground/render.ps1
new file mode 100644
index 0000000..e09becf
--- /dev/null
+++ b/source/ground/render.ps1
@@ -0,0 +1,20 @@
+param([string]$InDocx, [string]$OutPdf, [string]$OutDocx = "")
+# Open a .docx in Word, update the table of contents and every field, save a PDF (and optionally the updated .docx).
+$ErrorActionPreference = "Stop"
+$word = New-Object -ComObject Word.Application
+$word.Visible = $false
+$word.DisplayAlerts = 0
+try {
+  $doc = $word.Documents.Open($InDocx, $false, $false)
+  foreach ($toc in $doc.TablesOfContents) { $toc.Update() }
+  $doc.Fields.Update() | Out-Null
+  foreach ($toc in $doc.TablesOfContents) { $toc.Update() }
+  if ($OutDocx -ne "") { $doc.SaveAs2($OutDocx, 16) }
+  $doc.SaveAs2($OutPdf, 17)
+  $pages = $doc.ComputeStatistics(2)
+  Write-Output "pages=$pages"
+  $doc.Close($false)
+} finally {
+  $word.Quit()
+  [System.Runtime.InteropServices.Marshal]::ReleaseComObject($word) | Out-Null
+}
