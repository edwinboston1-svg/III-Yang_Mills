+ 54086425609737787797192670096043], [0, 0, 0, 0, 0, 0, 0, 0, 2, 2, 2, 1, 0, 0, 0, 0, 2, 0, 2, 2, 1, 0, 0, 1, 1, 0, 2, 1, 1, 0, 0, 2, 0, 0, 1, 1, 0, 1, 1, 0,
+ 0, 2, 1, 1, 0, 1, 2, 0, 0, 1, 2, 1])
+
+/-- the reading at step `s`: the top live at every step `≥ 1`, the linear terms non-attaining from step 101 -/
+def chkGephyrosisClasses3DS36 (s : ℕ) (st : List ℤ × List ℕ) : Bool :=
+  (decide (s = 0) || topLiveB R31lit st) && (decide (s < 101) || naCheck R31lit 3 st.1)
+
+end Gephyrosis
