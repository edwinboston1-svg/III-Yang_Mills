+/-
+  APERANTON -- THE BOUNDLESS, THE TREK T3 (2026-10-28): THE DESIGN THEOREM'S CORE -- carried-integer quaternions over
+  Z[sqrt d], the Hamilton product's associativity and bilinearity as polynomial identities, and THE CLOSURE THEOREM
+  FROM GENERATORS: a finite list of carried quaternions headed by the identity is closed under the product once (a) every
+  member times every generator is four times a member and (b) every later member is a generator times an earlier
+  member, exactly -- two LINEAR certificates (|G|·|S| products and |G| products) in place of the |G|² Cayley table the
+  kernel cannot afford (the 120 × 120 closure of the binary icosahedral group by enumeration ran the kernel past the
+  12 GB cap at 01:1x, measured).  The carried arithmetic: every coordinate four times its value, so a product of carried
+  elements is sixteen times the true product, four times a carried element, and the kernel divides nowhere but by an
+  exact four.  Classical content (Hamilton; the generator argument is the word argument of any finite group); the
+  earning is the certificate shape.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+
+namespace Aperanton
+
+namespace Design
+
+/-- a number p + q sqrt d with integer p, q; the radicand d is a parameter of the arithmetic -/
+structure Zd where
+  p : ℤ
+  q : ℤ
+deriving DecidableEq, Repr
+
+@[simp] theorem Zd.mk_p (p q : ℤ) : (Zd.mk p q).p = p := rfl
+@[simp] theorem Zd.mk_q (p q : ℤ) : (Zd.mk p q).q = q := rfl
+
+theorem Zd.ext_iff' (x y : Zd) : x = y ↔ x.p = y.p ∧ x.q = y.q := by
+  cases x; cases y; simp
+
+instance : Add Zd := ⟨fun x y => ⟨x.p + y.p, x.q + y.q⟩⟩
+instance : Zero Zd := ⟨⟨0, 0⟩⟩
+instance : Neg Zd := ⟨fun x => ⟨-x.p, -x.q⟩⟩
+instance : Sub Zd := ⟨fun x y => ⟨x.p - y.p, x.q - y.q⟩⟩
+
+@[simp] theorem Zd.add_p (x y : Zd) : (x + y).p = x.p + y.p := rfl
+@[simp] theorem Zd.add_q (x y : Zd) : (x + y).q = x.q + y.q := rfl
+@[simp] theorem Zd.sub_p (x y : Zd) : (x - y).p = x.p - y.p := rfl
+@[simp] theorem Zd.sub_q (x y : Zd) : (x - y).q = x.q - y.q := rfl
+@[simp] theorem Zd.neg_p (x : Zd) : (-x).p = -x.p := rfl
+@[simp] theorem Zd.neg_q (x : Zd) : (-x).q = -x.q := rfl
+@[simp] theorem Zd.zero_p : (0 : Zd).p = 0 := rfl
+@[simp] theorem Zd.zero_q : (0 : Zd).q = 0 := rfl
+
+/-- the product in Z[sqrt d] -/
+def zmul (d : ℤ) (x y : Zd) : Zd := ⟨x.p * y.p + d * x.q * y.q, x.p * y.q + x.q * y.p⟩
+
+@[simp] theorem zmul_p (d : ℤ) (x y : Zd) : (zmul d x y).p = x.p * y.p + d * x.q * y.q := rfl
+@[simp] theorem zmul_q (d : ℤ) (x y : Zd) : (zmul d x y).q = x.p * y.q + x.q * y.p := rfl
+
+/-- a quaternion a + b i + c j + e k with coordinates in Z[sqrt d] -/
+structure Quat where
+  a : Zd
+  b : Zd
+  c : Zd
+  e : Zd
+deriving DecidableEq, Repr
+
+theorem Quat.ext_iff' (x y : Quat) : x = y ↔ x.a = y.a ∧ x.b = y.b ∧ x.c = y.c ∧ x.e = y.e := by
+  cases x; cases y; simp
+
+/-- the Hamilton product -/
+def hmul (d : ℤ) (x y : Quat) : Quat :=
+  ⟨zmul d x.a y.a - zmul d x.b y.b - zmul d x.c y.c - zmul d x.e y.e,
+   zmul d x.a y.b + zmul d x.b y.a + zmul d x.c y.e - zmul d x.e y.c,
+   zmul d x.a y.c - zmul d x.b y.e + zmul d x.c y.a + zmul d x.e y.b,
+   zmul d x.a y.e + zmul d x.b y.c - zmul d x.c y.b + zmul d x.e y.a⟩
+
+def conj (x : Quat) : Quat := ⟨x.a, -x.b, -x.c, -x.e⟩
+
+def norm2 (d : ℤ) (x : Quat) : Zd := zmul d x.a x.a + zmul d x.b x.b + zmul d x.c x.c + zmul d x.e x.e
+
+def mul4 (x : Zd) : Zd := ⟨4 * x.p, 4 * x.q⟩
+def div4 (x : Zd) : Zd := ⟨x.p / 4, x.q / 4⟩
+def quarter (x : Quat) : Quat := ⟨div4 x.a, div4 x.b, div4 x.c, div4 x.e⟩
+def times4 (x : Quat) : Quat := ⟨mul4 x.a, mul4 x.b, mul4 x.c, mul4 x.e⟩
+
+/-- the carried identity -/
+def one : Quat := ⟨⟨4, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩, ⟨0, 0⟩⟩
+
+/-- a product of two carried elements (sixteen times the true product) is in the carried list iff it is four times
+a member: divisible by four coordinate-wise with the quarter in the list -/
+def inG (G : List Quat) (z : Quat) : Bool := decide (times4 (quarter z) = z) && decide (quarter z ∈ G)
+
+/-- the carried Chebyshev value V_n = 4^n U_n(a/4) at a carried real part a: V 0 = 1, V 1 = 2a,
+V (n+2) = 2a V (n+1) - 16 V n -- the SU(2) character of spin n/2 at a unit quaternion of real part a/4, times 4^n -/
+def cheb (d : ℤ) (a : Zd) : ℕ → Zd
+  | 0 => ⟨1, 0⟩
+  | 1 => ⟨2 * a.p, 2 * a.q⟩
+  | n + 2 => zmul d ⟨2 * a.p, 2 * a.q⟩ (cheb d a (n + 1)) - ⟨16 * (cheb d a n).p, 16 * (cheb d a n).q⟩
+
+/-- the sum over a list of the carried character of spin n/2 at the real parts -/
+def charSum (d : ℤ) (G : List Quat) (n : ℕ) : Zd := (G.map (fun g => cheb d g.a n)).sum
+
+/-! ## The product's identities -/
+
+theorem hmul_assoc (d : ℤ) (x y z : Quat) : hmul d (hmul d x y) z = hmul d x (hmul d y z) := by
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  obtain ⟨⟨yap, yaq⟩, ⟨ybp, ybq⟩, ⟨ycp, ycq⟩, ⟨yep, yeq⟩⟩ := y
+  obtain ⟨⟨zap, zaq⟩, ⟨zbp, zbq⟩, ⟨zcp, zcq⟩, ⟨zep, zeq⟩⟩ := z
+  simp only [hmul, Quat.ext_iff', Zd.ext_iff', Zd.sub_p, Zd.sub_q, Zd.add_p, Zd.add_q, zmul_p, zmul_q,
+    Zd.mk_p, Zd.mk_q]
+  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> ring
+
+theorem hmul_times4_left (d : ℤ) (x y : Quat) : hmul d (times4 x) y = times4 (hmul d x y) := by
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  obtain ⟨⟨yap, yaq⟩, ⟨ybp, ybq⟩, ⟨ycp, ycq⟩, ⟨yep, yeq⟩⟩ := y
+  simp only [hmul, times4, mul4, Quat.ext_iff', Zd.ext_iff', Zd.sub_p, Zd.sub_q, Zd.add_p, Zd.add_q, zmul_p,
+    zmul_q, Zd.mk_p, Zd.mk_q]
+  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> ring
+
+theorem hmul_times4_right (d : ℤ) (x y : Quat) : hmul d x (times4 y) = times4 (hmul d x y) := by
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  obtain ⟨⟨yap, yaq⟩, ⟨ybp, ybq⟩, ⟨ycp, ycq⟩, ⟨yep, yeq⟩⟩ := y
+  simp only [hmul, times4, mul4, Quat.ext_iff', Zd.ext_iff', Zd.sub_p, Zd.sub_q, Zd.add_p, Zd.add_q, zmul_p,
+    zmul_q, Zd.mk_p, Zd.mk_q]
+  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> ring
+
+theorem hmul_one (d : ℤ) (x : Quat) : hmul d x one = times4 x := by
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  simp only [hmul, one, times4, mul4, Quat.ext_iff', Zd.ext_iff', Zd.sub_p, Zd.sub_q, Zd.add_p, Zd.add_q, zmul_p,
+    zmul_q, Zd.mk_p, Zd.mk_q]
+  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> ring
+
+theorem quarter_times4 (x : Quat) : quarter (times4 x) = x := by
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  simp only [quarter, times4, div4, mul4, Quat.ext_iff', Zd.ext_iff', Zd.mk_p, Zd.mk_q]
+  omega
+
+theorem times4_injective : Function.Injective times4 := by
+  intro x y h
+  obtain ⟨⟨xap, xaq⟩, ⟨xbp, xbq⟩, ⟨xcp, xcq⟩, ⟨xep, xeq⟩⟩ := x
+  obtain ⟨⟨yap, yaq⟩, ⟨ybp, ybq⟩, ⟨ycp, ycq⟩, ⟨yep, yeq⟩⟩ := y
+  simp only [times4, mul4, Quat.ext_iff', Zd.ext_iff', Zd.mk_p, Zd.mk_q] at h ⊢
+  omega
+
+/-! ## The closure theorem from generators -/
+
+/-- (a) every member times every generator is four times a member -/
+def genClosed (d : ℤ) (G S : List Quat) : Bool := G.all (fun x => S.all (fun s => inG G (hmul d x s)))
+
+/-- (b) the list is headed by the identity, and every later member is a generator (on the left) times an earlier
+member, exactly: pred i = (j, k) with j < i, G i = quarter (S k * G j) -/
+def reachCert (d : ℤ) (G S : List Quat) (pred : List (ℕ × ℕ)) : Bool :=
+  decide (G.getD 0 one = one) &&
+  (List.range G.length).all (fun i => decide (i = 0) ||
+    (decide ((pred.getD i (0, 0)).1 < i) && decide ((pred.getD i (0, 0)).2 < S.length) &&
+     decide (times4 (quarter (hmul d (S.getD (pred.getD i (0, 0)).2 one) (G.getD (pred.getD i (0, 0)).1 one)))
+       = hmul d (S.getD (pred.getD i (0, 0)).2 one) (G.getD (pred.getD i (0, 0)).1 one)) &&
+     decide (G.getD i one
+       = quarter (hmul d (S.getD (pred.getD i (0, 0)).2 one) (G.getD (pred.getD i (0, 0)).1 one)))))
+
+/-- THE CLOSURE THEOREM: (a) and (b) make the list closed under the product -- x * y for y = s * y' is (x * s) * y'
+by associativity, x * s a member by (a), and y' earlier, so the induction on the member's index closes -/
+theorem closed_of_gens (d : ℤ) (G S : List Quat) (pred : List (ℕ × ℕ))
+    (hgen : genClosed d G S = true) (hreach : reachCert d G S pred = true) :
+    ∀ x ∈ G, ∀ y ∈ G, inG G (hmul d x y) = true := by
+  unfold reachCert at hreach
+  rw [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hreach
+  obtain ⟨h0, hstep⟩ := hreach
+  unfold genClosed at hgen
+  rw [List.all_eq_true] at hgen
+  have main : ∀ i, i < G.length → ∀ x ∈ G, inG G (hmul d x (G.getD i one)) = true := by
+    intro i
+    induction i using Nat.strong_induction_on with
+    | _ i ih =>
+      intro hi x hx
+      have hs := hstep i (List.mem_range.mpr hi)
+      rw [Bool.or_eq_true, decide_eq_true_eq] at hs
+      rcases hs with hi0 | hs
+      · subst hi0
+        rw [h0, hmul_one]
+        unfold inG
+        simp [quarter_times4, hx]
+      · simp only [Bool.and_eq_true, decide_eq_true_eq] at hs
+        obtain ⟨⟨⟨hj, hk⟩, hex⟩, hGi⟩ := hs
+        have hsmem : S.getD (pred.getD i (0, 0)).2 one ∈ S := by
+          rw [List.getD_eq_getElem _ _ hk]
+          exact List.getElem_mem hk
+        have hxs := hgen x hx
+        rw [List.all_eq_true] at hxs
+        have hxs := hxs _ hsmem
+        unfold inG at hxs
+        rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hxs
+        obtain ⟨hxs_ex, hxs_mem⟩ := hxs
+        have hIH := ih _ hj (by omega) _ hxs_mem
+        have e1 : times4 (hmul d x (G.getD i one))
+            = hmul d x (hmul d (S.getD (pred.getD i (0, 0)).2 one) (G.getD (pred.getD i (0, 0)).1 one)) := by
+          rw [hGi, ← hmul_times4_right, hex]
+        have e2 : hmul d x (hmul d (S.getD (pred.getD i (0, 0)).2 one) (G.getD (pred.getD i (0, 0)).1 one))
+            = hmul d (times4 (quarter (hmul d x (S.getD (pred.getD i (0, 0)).2 one))))
+                (G.getD (pred.getD i (0, 0)).1 one) := by
+          rw [← hmul_assoc, hxs_ex]
+        have key : times4 (hmul d x (G.getD i one))
+            = times4 (hmul d (quarter (hmul d x (S.getD (pred.getD i (0, 0)).2 one)))
+                (G.getD (pred.getD i (0, 0)).1 one)) := by
+          rw [e1, e2, hmul_times4_left]
+        rw [times4_injective key]
+        exact hIH
+  intro x hx y hy
+  obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hy
+  have := main i hi x hx
+  rwa [List.getD_eq_getElem _ _ hi] at this
+
+end Design
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/EchelonList.lean b/LEAN/aperanton/Aperanton/EchelonList.lean
new file mode 100644
index 000000000..7e8e118cb
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/EchelonList.lean
@@ -0,0 +1,118 @@
+/-
+  APERANTON -- THE BOUNDLESS, THE EVERY-L STEP (2026-10-28): THE LIST-FORM ECHELON CERTIFICATE -- every check a fold
+  over the lists, no `List.get`, no `Fin` enumeration, so the kernel's cost is LINEAR in the data.
+
+  Echelon.lean states a certificate in Fin-indexed form: `hit` and `miss` index the basis by `List.get` (cost i each)
+  over every pair (r² pairs), and a selection `xorSel` indexes the basis by `getD` inside a fold over `range r`: the
+  kernel's cost is r³ for the miss check and G·r² for the selections -- at side 3 (r = 240) the certificate ran the
+  kernel past 18 GB and was killed (01:09); at side 4 (r = 765) the Fin form is hopeless.  Here the same facts are
+  stated as folds: the hit check over `basis.zip piv`, the miss check as a double `all` with the element compared by
+  value (so the basis must be `Nodup`), the selection `xorSelL` as ONE fold over the basis carrying the index, and the
+  selection checks over `gens.zip sel`.  THE BRIDGES carry the list forms to Echelon.lean's `EchelonCert` and to the
+  selection hypotheses its consumers (`finrank_gens_eq`, `card_gens_eq`) take, unchanged: the certificate files decide
+  the list forms and apply the bridges.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Echelon
+
+namespace Aperanton
+
+namespace EchelonList
+
+/-! ## The linear selection -/
+
+/-- the selection as one fold over the basis, the index carried: the xor of the basis masks whose index bit is set -/
+def xorSelAux (m : ℕ) : List ℕ → ℕ → ℕ → ℕ
+  | [], _, acc => acc
+  | b :: l, k, acc => xorSelAux m l (k + 1) (if Nat.testBit m k then Nat.xor acc b else acc)
+
+def xorSelL (m : ℕ) (basis : List ℕ) : ℕ := xorSelAux m basis 0 0
+
+/-- the fold with the index carried is the range fold with the list indexed, from any start -/
+theorem xorSelAux_eq (m : ℕ) (l : List ℕ) (k acc : ℕ) :
+    xorSelAux m l k acc
+      = (List.range' k l.length).foldl
+          (fun a i => if Nat.testBit m i then Nat.xor a (l.getD (i - k) 0) else a) acc := by
+  induction l generalizing k acc with
+  | nil => rfl
+  | cons b l ih =>
+    rw [xorSelAux, ih, List.length_cons, List.range'_succ, List.foldl_cons, Nat.sub_self]
+    simp only [List.getD_cons_zero]
+    apply List.foldl_ext
+    intro a i hi
+    rw [List.mem_range'] at hi
+    have h1 : i - k = (i - (k + 1)) + 1 := by omega
+    rw [h1, List.getD_cons_succ]
+
+/-- THE BRIDGE: the linear selection is Echelon.lean's selection -/
+theorem xorSelL_eq (m : ℕ) (basis : List ℕ) : xorSelL m basis = xorSel m basis := by
+  unfold xorSelL xorSel
+  rw [xorSelAux_eq, List.range_eq_range']
+  apply List.foldl_ext
+  intro a i _
+  rw [Nat.sub_zero]
+
+/-! ## The list-form checks -/
+
+/-- every basis element has its pivot bit set -/
+def hitL (basis piv : List ℕ) : Bool := (basis.zip piv).all (fun bp => Nat.testBit bp.1 bp.2)
+
+/-- every OTHER basis element has the pivot bit clear (the element compared by value: the basis is nodup) -/
+def missL (basis piv : List ℕ) : Bool :=
+  (basis.zip piv).all (fun bp => basis.all (fun b' => (b' == bp.1) || !Nat.testBit b' bp.2))
+
+/-- every generator is the linear selection of the basis by its mask -/
+def selL (gens sel basis : List ℕ) : Bool := (gens.zip sel).all (fun gs => gs.1 == xorSelL gs.2 basis)
+
+/-! ## The bridges to the Fin forms -/
+
+theorem zip_getElem_mem {α β : Type*} (l₁ : List α) (l₂ : List β) (i : ℕ) (h₁ : i < l₁.length)
+    (h₂ : i < l₂.length) : (l₁[i], l₂[i]) ∈ l₁.zip l₂ := by
+  have h : i < (l₁.zip l₂).length := by rw [List.length_zip]; omega
+  have := List.getElem_mem h
+  rwa [List.getElem_zip] at this
+
+/-- THE CERTIFICATE FROM THE LIST FORMS -/
+theorem echelonCert_of_lists (basis piv : List ℕ) (hlen : piv.length = basis.length) (hnd : basis.Nodup)
+    (hhit : hitL basis piv = true) (hmiss : missL basis piv = true) : EchelonCert basis piv := by
+  refine ⟨hlen, ?_, ?_⟩
+  · intro i
+    have hi : i.val < piv.length := by rw [hlen]; exact i.isLt
+    have hmem := zip_getElem_mem basis piv i.val i.isLt hi
+    unfold hitL at hhit
+    rw [List.all_eq_true] at hhit
+    have := hhit _ hmem
+    rw [List.getD_eq_getElem _ _ hi]
+    simpa [List.get_eq_getElem] using this
+  · intro i j hij
+    have hi : i.val < piv.length := by rw [hlen]; exact i.isLt
+    have hmem := zip_getElem_mem basis piv i.val i.isLt hi
+    unfold missL at hmiss
+    rw [List.all_eq_true] at hmiss
+    have hrow := hmiss _ hmem
+    rw [List.all_eq_true] at hrow
+    have hj := hrow _ (List.getElem_mem j.isLt)
+    simp only [Bool.or_eq_true, beq_iff_eq, Bool.not_eq_true'] at hj
+    rcases hj with hj | hj
+    · exfalso
+      apply hij
+      exact Fin.ext ((List.Nodup.getElem_inj_iff hnd).mp hj.symm)
+    · rw [List.getD_eq_getElem _ _ hi]
+      simpa [List.get_eq_getElem] using hj
+
+/-- THE SELECTION HYPOTHESIS FROM THE LIST FORM -/
+theorem sel_of_list (gens sel basis : List ℕ) (hlen : sel.length = gens.length) (h : selL gens sel basis = true) :
+    ∀ i : Fin gens.length, gens.get i = xorSel (sel.getD i.val 0) basis := by
+  intro i
+  have hi : i.val < sel.length := by rw [hlen]; exact i.isLt
+  have hmem := zip_getElem_mem gens sel i.val i.isLt hi
+  unfold selL at h
+  rw [List.all_eq_true] at h
+  have := h _ hmem
+  simp only [beq_iff_eq] at this
+  rw [List.getD_eq_getElem _ _ hi, ← xorSelL_eq, List.get_eq_getElem]
+  exact this
+
+end EchelonList
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusDecay.lean b/LEAN/aperanton/Aperanton/TorusDecay.lean
new file mode 100644
index 000000000..93cb22ff9
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusDecay.lean
@@ -0,0 +1,72 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6 (ADDENDUM I, THE ROAD): THE WEAK-COUPLING CLAUSE'S ENGINE AT ANY SIDE --
+  EVERY DUAL SECTOR'S CORRELATIONS DECAY ALONG THE WALL LEVEL AS (18 c₁(y))^R.
+
+  The dual sector h of the Z₂ theory on T⁴_L at the dual coupling y is the Gibbs measure `torusSys L h y`
+  (TorusSysL.lean); its interdependence has row sums at most α = 18·c₁(y) (`rowsum_le_of`, the double count) and
+  range one along the wall level (`rangeOne_of`, TorusLevels.lean).  Dobrushin's covariance bound `cov_le`
+  (Dobrushin.lean) then reads, in every sector and at every side: an observable f whose oscillation mass sits at
+  levels ≤ a and a positive observable g read at levels ≥ a + R have
+      |⟨f g⟩ − ⟨f⟩⟨g⟩| ≤ ⟨g⟩ · (#reads)(Σ d) α^R/(1 − α),
+  with α < 1 iff y > 17/19 (`alpha_lt_one_iff`).  In the original coupling, y = (1 − y*)/(1 + y*) < 1/18: the
+  weak-coupling clause of the three-clause theorem holds for β > ½ ln 18 = 1.445 at every side, against the
+  self-dual β_c = 0.4407 -- the clause's engine, the mixture over the 64 twists and the between-sector term being
+  the assembly (T3).  The constants are the sector's own: no dependence on L enters α, so the decay is uniform in
+  the side.  W = 0 (Dobrushin 1968 on a gauge theory's dual); the earning is the exact coefficient on the torus.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Dobrushin
+import Aperanton.Z2Slab
+import Aperanton.TorusL
+import Aperanton.TorusSysL
+import Aperanton.TorusLevels
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- the sector's Dobrushin coefficient: 18 c₁(y) = 18 (1 − y)/(1 + y) -/
+noncomputable def alpha (y : ℝ) : ℝ := 18 * ((1 - y) / (1 + y))
+
+theorem alpha_nonneg (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) : 0 ≤ alpha y := by
+  unfold alpha
+  have : 0 ≤ (1 - y) / (1 + y) := div_nonneg (by linarith) (by linarith)
+  linarith
+
+/-- 18 c₁(y) < 1 iff y > 17/19 -/
+theorem alpha_lt_one_iff (y : ℝ) (hy0 : 0 < y) : alpha y < 1 ↔ (17 : ℝ) / 19 < y := by
+  unfold alpha
+  have h1 : (0 : ℝ) < 1 + y := by linarith
+  rw [← mul_div_assoc, div_lt_one h1]
+  constructor <;> intro h <;> linarith
+
+/-- THE SECTOR DECAY AT ANY SIDE: in the dual sector h, an observable f with oscillation mass d at levels ≤ a and a
+positive observable g read at levels ≥ a + R have covariance at most ⟨g⟩ · (#reads)(Σ d) α^R/(1 − α), α = 18 c₁(y),
+for y > 17/19 -/
+theorem sector_cov_le (L mu : ℕ) (hadj : AdjList L mu)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (hy : (17 : ℝ) / 19 < y)
+    (f : (Fin (nCubes L) → Z2) → ℝ) (d : Fin (nCubes L) → ℝ) (hf : OscBound f d) (a R : ℕ)
+    (hd : ∀ t, a < levelAt L mu t → d t = 0)
+    (g : (Fin (nCubes L) → Z2) → ℝ) (hg : ∀ ω, 0 < g ω) (reads : Fin (nCubes L) → Prop) [DecidablePred reads]
+    (hfree : ∀ s, ¬ reads s → ∀ ω x, g (Function.update ω s x) = g ω)
+    (hreads : ∀ t, levelAt L mu t < a + R → ¬ reads t) :
+    |gibbs (torusSys L h y hy0 hy1).W (fun ω => f ω * g ω) -
+        gibbs (torusSys L h y hy0 hy1).W f * gibbs (torusSys L h y hy0 hy1).W g| ≤
+      gibbs (torusSys L h y hy0 hy1).W g *
+        ((∑ t, if reads t then (1 : ℝ) else 0) * (∑ t, d t) * alpha y ^ R / (1 - alpha y)) := by
+  have hα1 : alpha y < 1 := (alpha_lt_one_iff y hy0).mpr hy
+  exact cov_le (torusSys L h y hy0 hy1).W (torusSys L h y hy0 hy1).W_pos (torusSys L h y hy0 hy1).C
+    (torusSys L h y hy0 hy1).C_nonneg (torusSys L h y hy0 hy1).interdep (alpha y) (alpha_nonneg y hy0 hy1) hα1
+    (fun s => rowsum_le_of L h y hy0 hy1 s hdeg (hsix s)) (levelAt L mu) (rangeOne_of L mu hadj h y hy0 hy1)
+    f d hf a R hd g hg reads hfree hreads
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusL.lean b/LEAN/aperanton/Aperanton/TorusL.lean
new file mode 100644
index 000000000..db9202c0e
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusL.lean
@@ -0,0 +1,173 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6 (ADDENDUM I, THE ROAD): THE FOUR-TORUS OF ANY SIDE -- ITS CELLS, INCIDENCES,
+  SHEETS AND CODES WITH THE SIDE L A PARAMETER, AND THE TWO BRIDGE LEMMAS (B1, B2) AT EVERY SIDE.
+
+  Torus4.lean built the side-2 torus with bit arithmetic (a coordinate a bit, a step a flip); here a site s < L⁴ is
+  read in base L (`coord`: its μ-th digit; `stepP`: that digit advanced modulo L), and every cell, incidence, mask and
+  code of Torus4.lean is restated with L explicit -- at L = 2 the masks coincide digit for digit with Torus4's, which
+  the side-L emitter re-run at L = 2 shows byte for byte against the side-2 certificate (a sighted control of the
+  generalization).  B1 (`dot_vecOf`): the dot product of two mask vectors is the parity of their and, at every side
+  (Bridge.lean's bit-sum lemma, generic in the width).  B2 (`D_le_orth_K`, `sheet_mem_orth_K`): from the facts
+  ∂₂∂₃ = 0 and "the sheets are cycles" at a side -- hypotheses here, decided by each side's certificate
+  (TorusLCert<L>.lean) -- the boundary code and the six sheets lie in the plaquette code's dual.  The sector split at
+  a side is the proposition `TorusLSplit L`; TorusLBridge.lean proves it from a certificate's numbers.  W = 0 (the
+  cubical complex of a torus); the earning is one geometry for every side.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Duality
+import Aperanton.Torus4
+import Aperanton.Echelon
+import Aperanton.Bridge
+
+open Finset Matrix
+
+namespace Aperanton
+
+namespace TorusL
+
+/-! ## The cells of (ℤ/L)^4 -/
+
+def V (L : ℕ) : ℕ := L ^ 4
+def nLinks (L : ℕ) : ℕ := 4 * V L
+def nPlaq (L : ℕ) : ℕ := 6 * V L
+def nCubes (L : ℕ) : ℕ := 4 * V L
+
+/-- the coordinate of a site in direction μ: the μ-th base-L digit of s -/
+def coord (L s mu : ℕ) : ℕ := (s / L ^ mu) % L
+
+/-- the step in direction μ: that digit advanced modulo L -/
+def stepP (L s mu : ℕ) : ℕ := s - coord L s mu * L ^ mu + ((coord L s mu + 1) % L) * L ^ mu
+
+def link (L mu s : ℕ) : ℕ := mu * V L + s
+def plaq (L q s : ℕ) : ℕ := q * V L + s
+def cube (L c s : ℕ) : ℕ := c * V L + s
+
+/-- the four links of the plaquette (μν) at s: (μ, s), (ν, s + e_μ), (μ, s + e_ν), (ν, s) -/
+def plaqLinks (L q s : ℕ) : List ℕ :=
+  let mu := Torus4.pairMu q
+  let nu := Torus4.pairNu q
+  [link L mu s, link L nu (stepP L s mu), link L mu (stepP L s nu), link L nu s]
+
+/-- the six faces of the cube (μνρ) at s -/
+def cubeFaces (L c s : ℕ) : List ℕ :=
+  let a := Torus4.tripA c
+  let b := Torus4.tripB c
+  let d := Torus4.tripC c
+  [plaq L (Torus4.pairIdx a b) s, plaq L (Torus4.pairIdx a b) (stepP L s d),
+   plaq L (Torus4.pairIdx a d) s, plaq L (Torus4.pairIdx a d) (stepP L s b),
+   plaq L (Torus4.pairIdx b d) s, plaq L (Torus4.pairIdx b d) (stepP L s a)]
+
+/-- the plaquettes containing a link: the coboundary δ¹ -/
+def linkCobd (L l : ℕ) : List ℕ :=
+  (List.range (nPlaq L)).filter (fun p => (plaqLinks L (p / V L) (p % V L)).contains l)
+
+/-! ## Masks: one bit per plaquette -/
+
+def cobdMask (L l : ℕ) : ℕ := Torus4.maskOf (linkCobd L l)
+def cubeMask (L k : ℕ) : ℕ := Torus4.maskOf (cubeFaces L (k / V L) (k % V L))
+
+/-- the sheet of the pair q: the (μν)-plaquettes at the two other coordinates zero -- L² plaquettes, a two-torus -/
+def sheetMask (L q : ℕ) : ℕ :=
+  let mu := Torus4.pairMu q
+  let nu := Torus4.pairNu q
+  Torus4.maskOf (((List.range (V L)).filter (fun s =>
+    (List.range 4).all (fun d => d = mu || d = nu || coord L s d = 0))).map (fun s => plaq L q s))
+
+def parAnd (L a b : ℕ) : Bool := Torus4.par (nPlaq L) (Nat.land a b)
+
+def cobdMasks (L : ℕ) : List ℕ := (List.range (nLinks L)).map (cobdMask L)
+def cubeMasks (L : ℕ) : List ℕ := (List.range (nCubes L)).map (cubeMask L)
+def sheetMasks (L : ℕ) : List ℕ := (List.range 6).map (sheetMask L)
+
+/-! ## The codes -/
+
+/-- a mask as a vector of F₂^(6V) -/
+def vecOf (L m : ℕ) : Fin (nPlaq L) → ZMod 2 := vecOfN (nPlaq L) m
+
+/-- the plaquette code: the span of δ¹'s columns -/
+def K (L : ℕ) : Submodule (ZMod 2) (Fin (nPlaq L) → ZMod 2) :=
+  Submodule.span (ZMod 2) (Set.range (fun l : Fin (nLinks L) => vecOf L (cobdMask L l.val)))
+
+/-- the boundary code: the span of ∂₃'s columns -/
+def D (L : ℕ) : Submodule (ZMod 2) (Fin (nPlaq L) → ZMod 2) :=
+  Submodule.span (ZMod 2) (Set.range (fun k : Fin (nCubes L) => vecOf L (cubeMask L k.val)))
+
+/-- the span of the six sheets -/
+def S (L : ℕ) : Submodule (ZMod 2) (Fin (nPlaq L) → ZMod 2) :=
+  Submodule.span (ZMod 2) (Set.range (fun q : Fin 6 => vecOf L (sheetMask L q.val)))
+
+/-- the 64 't Hooft twists: the sums of subsets of the six sheets -/
+noncomputable def H (L : ℕ) : Finset (Fin (nPlaq L) → ZMod 2) :=
+  (Finset.univ : Finset (Finset (Fin 6))).image (fun T => ∑ q ∈ T, vecOf L (sheetMask L q.val))
+
+/-- the sector split of the four-torus of side L -/
+def TorusLSplit (L : ℕ) : Prop := SectorSplit (K L) (D L) (H L)
+
+/-! ## B1 and B2 at every side -/
+
+/-- B1: THE DOT PRODUCT OF MASK VECTORS IS THE PARITY OF THE AND -/
+theorem dot_vecOf (L a b : ℕ) : vecOf L a ⬝ᵥ vecOf L b = if parAnd L a b then 1 else 0 := by
+  unfold vecOf vecOfN parAnd dotProduct
+  have hpt : ∀ i : Fin (nPlaq L), (if Nat.testBit a i.val then (1 : ZMod 2) else 0)
+      * (if Nat.testBit b i.val then (1 : ZMod 2) else 0)
+      = if Nat.testBit (Nat.land a b) i.val then 1 else 0 := by
+    intro i
+    have hland : Nat.land a b = a &&& b := rfl
+    rw [hland, Nat.testBit_land]
+    cases Nat.testBit a i.val <;> cases Nat.testBit b i.val <;> simp
+  simp_rw [hpt]
+  exact sum_testBit_eq_par (nPlaq L) (Nat.land a b)
+
+theorem parAnd_comm (L a b : ℕ) : parAnd L a b = parAnd L b a := by
+  unfold parAnd
+  show Torus4.par (nPlaq L) (a &&& b) = Torus4.par (nPlaq L) (b &&& a)
+  rw [Nat.land_comm]
+
+/-- a decided `List.all` over the mask lists reads as a statement about every pair -/
+theorem parAnd_cube_cobd (L : ℕ)
+    (hdd : ((cubeMasks L).all (fun c => (cobdMasks L).all (fun l => !(parAnd L c l)))) = true)
+    (k l : ℕ) (hk : k < nCubes L) (hl : l < nLinks L) : parAnd L (cubeMask L k) (cobdMask L l) = false := by
+  rw [List.all_eq_true] at hdd
+  have hc : cubeMask L k ∈ cubeMasks L := List.mem_map.mpr ⟨k, List.mem_range.mpr hk, rfl⟩
+  have h2 := hdd _ hc
+  rw [List.all_eq_true] at h2
+  have hl' : cobdMask L l ∈ cobdMasks L := List.mem_map.mpr ⟨l, List.mem_range.mpr hl, rfl⟩
+  have h3 := h2 _ hl'
+  simpa using h3
+
+theorem parAnd_sheet_cobd (L : ℕ)
+    (hsh : ((sheetMasks L).all (fun h => (cobdMasks L).all (fun l => !(parAnd L h l)))) = true)
+    (q l : ℕ) (hq : q < 6) (hl : l < nLinks L) : parAnd L (sheetMask L q) (cobdMask L l) = false := by
+  rw [List.all_eq_true] at hsh
+  have hs : sheetMask L q ∈ sheetMasks L := List.mem_map.mpr ⟨q, List.mem_range.mpr hq, rfl⟩
+  have h2 := hsh _ hs
+  rw [List.all_eq_true] at h2
+  have hl' : cobdMask L l ∈ cobdMasks L := List.mem_map.mpr ⟨l, List.mem_range.mpr hl, rfl⟩
+  have h3 := h2 _ hl'
+  simpa using h3
+
+/-- B2 (first half): THE BOUNDARY CODE LIES IN THE PLAQUETTE CODE'S DUAL, at a side where ∂₂∂₃ = 0 is decided -/
+theorem D_le_orth_K (L : ℕ)
+    (hdd : ((cubeMasks L).all (fun c => (cobdMasks L).all (fun l => !(parAnd L c l)))) = true) :
+    D L ≤ orth (K L) := by
+  unfold D K
+  rw [Submodule.span_le]
+  rintro _ ⟨k, rfl⟩
+  rw [SetLike.mem_coe, mem_orth_span_iff]
+  rintro _ ⟨l, rfl⟩
+  rw [dot_vecOf, parAnd_comm, parAnd_cube_cobd L hdd k.val l.val k.isLt l.isLt]
+  simp
+
+/-- B2 (second half): THE SIX SHEETS LIE IN THE PLAQUETTE CODE'S DUAL, at a side where they are decided cycles -/
+theorem sheet_mem_orth_K (L : ℕ)
+    (hsh : ((sheetMasks L).all (fun h => (cobdMasks L).all (fun l => !(parAnd L h l)))) = true)
+    (q : Fin 6) : vecOf L (sheetMask L q.val) ∈ orth (K L) := by
+  unfold K
+  rw [mem_orth_span_iff]
+  rintro _ ⟨l, rfl⟩
+  rw [dot_vecOf, parAnd_comm, parAnd_sheet_cobd L hsh q.val l.val q.isLt l.isLt]
+  simp
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusL3.lean b/LEAN/aperanton/Aperanton/TorusL3.lean
