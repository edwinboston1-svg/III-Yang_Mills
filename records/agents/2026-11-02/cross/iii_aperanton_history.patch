+    rw [Real.log_pow] at hlog
+    rw [div_le_iff₀ (Nat.cast_pos.mpr hR)]
+    have : Real.log (1 / y) = -Real.log y := by rw [one_div, Real.log_inv]
+    rw [this]
+    push_cast at hlog ⊢
+    nlinarith [hlog]
+
