extern @abi(c-msvc-x64) fn sfx_bound() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wblockdim(chi: u64, wpar: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wblockfill(p: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_lx() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_ly() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wblockint() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wentbits() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wrowbits() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wtraces() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wstable(chi: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_wchi(chi: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_b1(i: u64, j: u64) -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_err() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_norb() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn sfx_nrep() -> u64 from "strophinx.iii"
extern @abi(c-msvc-x64) fn ca_reset(n: i64) -> i32 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_set(i: i64, j: i64, v: i64) -> i32 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_charpoly() -> i32 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_coeff_sgn(i: i64) -> i64 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_coeff_len(i: i64) -> i64 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_coeff_limb(i: i64, j: i64) -> u64 from "charpoly.iii"
extern @abi(c-msvc-x64) fn ca_load_chain(build: i64) -> i32 from "charpoly.iii"
extern @abi(c-msvc-x64) fn root_count2(an: i64, ad: i64, bn: i64, bd: i64) -> i64 from "sturm_big.iii"

const TOM_NMAX : u64 = 704u64
const TOM_PMAX : u64 = 2048u64
const TOM_IW : u64 = 4097u64                 /* words per coefficient image: the header, then up to 4096 limbs */
const TOM_LO : u64 = 1073610752u64           /* 2^30 - 131072: the sieve segment's base */
const TOM_HI : u64 = 1073741824u64           /* 2^30 */
const TOM_MASK : u64 = 4294967295u64
/* ΜΕΓΕΘΟΣ registers (ΣΤΡΟΦΙΓΞ holds 1..86 and 100..106) */
const R_ACC : u64 = 110u64
const R_M : u64 = 111u64
const R_T : u64 = 112u64
const R_CI : u64 = 113u64
const R_V : u64 = 114u64
const R_SV : u64 = 115u64
const R_Q : u64 = 116u64
const R_P : u64 = 117u64
const R_X : u64 = 118u64
const R_T2 : u64 = 119u64
const R_T3 : u64 = 120u64
const R_ONE : u64 = 121u64
const R_M1 : u64 = 122u64
const R_A : u64 = 123u64
const R_B : u64 = 124u64
const R_MID : u64 = 125u64
const R_SC : u64 = 126u64                    /* 2^32 */
const R_TEN : u64 = 127u64                   /* 10^12 */
const R_TWO : u64 = 128u64
const R_NS : u64 = 130u64                    /* p_k at 130 + k */
const R_ES : u64 = 140u64                    /* e_k at 140 + k */
const R_L0LO : u64 = 150u64
const R_L0HI : u64 = 151u64
const R_L1LO : u64 = 152u64
const R_L1HI : u64 = 153u64
const R_MULO : u64 = 154u64
const R_MUHI : u64 = 155u64
const R_NULO : u64 = 156u64
const R_NUHI : u64 = 157u64
const R_RHLO : u64 = 158u64
const R_RHHI : u64 = 159u64
const R_CLO : u64 = 160u64
const R_CHI : u64 = 161u64
const R_BLO : u64 = 162u64
const R_BHI : u64 = 163u64

var TOM_PR : [u64; 2048]
var TOM_NP : u64 = 0u64
var TOM_NPALL : u64 = 0u64                   /* primes found by the sieve */
var TOM_SIEVE : [u8; 131072]
var TOM_SMALL : [u64; 4096]
var TOM_NSMALL : u64 = 0u64
var TOM_H : [u64; 495616]                    /* the block mod p, Hessenberg in place, n x n */
var TOM_PC : [u64; 705]                      /* the charpoly mod p */
var TOM_PP : [u64; 497025]                   /* the recurrence's polynomials p_m at m * 641 */
var TOM_CR : [u64; 1443840]                  /* residues: coefficient k, prime l at k * TOM_PMAX + l */
var TOM_TAB : [u64; 4194304]                 /* Garner: Q_j mod p_i at j * TOM_PMAX + i */
var TOM_INV : [u64; 2048]
var TOM_TD : [u64; 2048]
var TOM_C : [u64; 2888385]                   /* the exact coefficients as images, k * TOM_IW */
var TOM_W : [u64; 2888385]                   /* the Taylor cascade's images */
var TOM_IMG : [u64; 4200]
var TOM_IMG2 : [u64; 4200]
var TOM_DEC : [u8; 16400]
var TOM_N : u64 = 0u64
var TOM_M0 : u64 = 0u64
var TOM_GK : u64 = 0u64
var TOM_YK : u64 = 2u64
var TOM_CHI : u64 = 0u64
var TOM_WPAR : u64 = 0u64
var TOM_ROWBITS : u64 = 0u64
var TOM_ERR : u64 = 0u64
var TOM_MISS : u64 = 0u64
var TOM_ITER : u64 = 0u64
var TOM_MULT : u64 = 0u64                    /* the multiplicity of the top root: Budan-Fourier count at lo minus at hi (0 when not read) */
var TOM_SECOND : u64 = 0u64                  /* how the second root was found: 1 nu-path, 2 rho-path, 3 count bisection */
var TOM_NB : u64 = 0u64                      /* blocks recorded */
var TOM_RINFO : [u64; 1024]                  /* block b: chi, wpar, n, cert at b * 4 */
var TOM_RLO : [u64; 512]                     /* block b: the top root's lower end as an image at b * 8 */
var TOM_RHI : [u64; 512]

fn s(x: u64) -> u64 { krx_s(x)   return 0u64 }
fn u(v: u64) -> u64 { krx_u(v)   return 0u64 }
fn nl() -> u64 { krx_nl()   return 0u64 }
fn met(ok: u64) -> u64 { if ok == 1u64 { s("  [MET]" as u64) } else { s("  [MISS]" as u64)   TOM_MISS = TOM_MISS + 1u64 }   nl()   return ok }
fn tom_err() -> u64 @export { return TOM_ERR }
fn tom_miss() -> u64 @export { return TOM_MISS }
fn tom_n() -> u64 @export { return TOM_N }
fn tom_np() -> u64 @export { return TOM_NP }
fn tom_second() -> u64 @export { return TOM_SECOND }
fn tom_w0() -> u64 @export { return 0u64 }
fn tom_selfprove() -> u64 @export { return 0u64 }
fn mulmod(a: u64, b: u64, p: u64) -> u64 { return (a * b) % p }
fn powmod(a: u64, e: u64, p: u64) -> u64 {
    let mut r : u64 = 1u64
    let mut b : u64 = a % p
    let mut k : u64 = e
    while k > 0u64 { if (k & 1u64) == 1u64 { r = mulmod(r, b, p) }   b = mulmod(b, b, p)   k = k >> 1u64 }
    return r
}
fn invmod(a: u64, p: u64) -> u64 { return powmod(a, p - 2u64, p) }
fn signcode(r: u64) -> u64 { if mgs_iszero(r) == 1u64 { return 0u64 }   if mgs_sign(r) == 0u64 { return 1u64 }   return 2u64 }
fn consts() -> u64 {
    mgs_setu(R_SC, 4294967296u64)
    mgs_setu(R_TEN, 1000000000000u64)
    mgs_setu(R_ONE, 1u64)
    mgs_setu(R_TWO, 2u64)
    return 0u64
}

/* ---- primes: the small primes to 32768, a segmented sieve on [2^30 - 131072, 2^30), the np largest collected, each re-verified ---- */
fn isprime(p: u64) -> u64 {
    if p < 2u64 { return 0u64 }
    let mut d : u64 = 2u64
    while d * d <= p { if p % d == 0u64 { return 0u64 }   d = d + 1u64 }
    return 1u64
}
fn smallprimes() -> u64 {
    let mut i : u64 = 0u64
    while i < 32769u64 { TOM_SIEVE[i] = 0u8   i = i + 1u64 }
    TOM_NSMALL = 0u64
    i = 2u64
    while i < 32769u64 {
        if TOM_SIEVE[i] == 0u8 {
            TOM_SMALL[TOM_NSMALL] = i   TOM_NSMALL = TOM_NSMALL + 1u64
            let mut m : u64 = i * i
            while m < 32769u64 { TOM_SIEVE[m] = 1u8   m = m + i }
        }
        i = i + 1u64
    }
    return TOM_NSMALL
}
fn segment() -> u64 {
    let mut i : u64 = 0u64
    while i < 131072u64 { TOM_SIEVE[i] = 0u8   i = i + 1u64 }
    let mut k : u64 = 0u64
    while k < TOM_NSMALL {
        let q : u64 = TOM_SMALL[k]
        let mut m : u64 = ((TOM_LO + q - 1u64) / q) * q
        while m < TOM_HI { TOM_SIEVE[m - TOM_LO] = 1u8   m = m + q }
        k = k + 1u64
    }
    return 0u64
}
fn tom_primes(np: u64) -> u64 @export {
    if np > TOM_PMAX { TOM_ERR = 1u64   return 0u64 }
    smallprimes()
    segment()
    TOM_NPALL = 0u64
    let mut cand : u64 = TOM_HI - 1u64
    while TOM_NPALL < np {
        if cand < TOM_LO { TOM_ERR = 2u64   return 0u64 }
        if TOM_SIEVE[cand - TOM_LO] == 0u8 { TOM_PR[TOM_NPALL] = cand   TOM_NPALL = TOM_NPALL + 1u64 }
        cand = cand - 1u64
    }
    let mut i : u64 = 0u64
    while i < TOM_NPALL { if isprime(TOM_PR[i]) == 0u64 { s("TOM-REFUSED modulus " as u64)   u(TOM_PR[i])   s(" is composite" as u64)   nl()   TOM_ERR = 8u64   return 0u64 }   i = i + 1u64 }
    return TOM_NPALL
}

/* ---- the block ---- */
fn tom_prepare(gk: u64, yk: u64) -> u64 @export {
    consts()
    TOM_GK = gk   TOM_YK = yk   TOM_NB = 0u64
    if sfx_setgroup(gk) == 0u64 { return 0u64 }
    if sfx_setcoupling(yk) == 0u64 { return 0u64 }
    if sfx_orbits() == 0u64 { return 0u64 }
    if sfx_sym() == 0u64 { return 0u64 }
    if sfx_fillks() == 0u64 { return 0u64 }
    if sfx_primes() == 0u64 { return 0u64 }
    if sfx_bound() == 0u64 { return 0u64 }
    if sfx_err() != 0u64 { return 0u64 }
    return 1u64
}
/* the block's rows, its infinity-norm bound and the prime count it needs: n (rowbits + 1) + 64 bits, 29 per prime (law 13) */
fn tom_block(chi: u64, wpar: u64) -> u64 @export {
    TOM_CHI = chi   TOM_WPAR = wpar
    let n : u64 = sfx_wblockdim(chi, wpar)
    TOM_N = n
    if sfx_err() != 0u64 { TOM_ERR = 3u64   return 0u64 }
    if n == 0u64 { return 0u64 }
    if n > TOM_NMAX { TOM_ERR = 3u64   return 0u64 }
    TOM_ROWBITS = sfx_wrowbits()
    let bits : u64 = n * (TOM_ROWBITS + 1u64) + 64u64
    TOM_NP = bits / 29u64 + 2u64
    if TOM_NP > TOM_NPALL { TOM_ERR = 4u64   s("TOM-REFUSED the block needs " as u64)   u(TOM_NP)   s(" primes, " as u64)   u(TOM_NPALL)   s(" held" as u64)   nl()   return 0u64 }
    return n
}

/* ---- the Hessenberg characteristic polynomial modulo one prime ---- */
fn hfill(p: u64) -> u64 {
    let n : u64 = TOM_N
    sfx_wblockfill(p)
    let mut i : u64 = 0u64
    while i < n {
        let mut j : u64 = 0u64
        while j < n { TOM_H[i * n + j] = sfx_b1(i, j)   j = j + 1u64 }
        i = i + 1u64
    }
    return 0u64
}
fn hswap(n: u64, a: u64, b: u64) -> u64 {                   /* rows a <-> b, then columns a <-> b */
    let mut c : u64 = 0u64
    while c < n { let t : u64 = TOM_H[a * n + c]   TOM_H[a * n + c] = TOM_H[b * n + c]   TOM_H[b * n + c] = t   c = c + 1u64 }
    c = 0u64
    while c < n { let t : u64 = TOM_H[c * n + a]   TOM_H[c * n + a] = TOM_H[c * n + b]   TOM_H[c * n + b] = t   c = c + 1u64 }
    return 0u64
}
fn helim(n: u64, p: u64, m: u64, i: u64, uu: u64) -> u64 {  /* row_i -= uu row_m ; col_m += uu col_i */
    let mut c : u64 = 0u64
    while c < n { TOM_H[i * n + c] = (TOM_H[i * n + c] + p - mulmod(uu, TOM_H[m * n + c], p)) % p   c = c + 1u64 }
    let mut r : u64 = 0u64
    while r < n { TOM_H[r * n + m] = (TOM_H[r * n + m] + mulmod(uu, TOM_H[r * n + i], p)) % p   r = r + 1u64 }
    return 0u64
}
fn hstep(n: u64, p: u64, m: u64) -> u64 {                    /* clear column m - 1 below row m */
    if TOM_H[m * n + m - 1u64] == 0u64 {
        let mut i : u64 = m + 1u64
        let mut found : u64 = n
        while i < n { if found == n { if TOM_H[i * n + m - 1u64] != 0u64 { found = i } }   i = i + 1u64 }
        if found == n { return 0u64 }
        hswap(n, m, found)
    }
    let inv : u64 = invmod(TOM_H[m * n + m - 1u64], p)
    let mut i : u64 = m + 1u64
    while i < n {
        if TOM_H[i * n + m - 1u64] != 0u64 { helim(n, p, m, i, mulmod(TOM_H[i * n + m - 1u64], inv, p)) }
        i = i + 1u64
    }
    return 0u64
}
fn hreduce(n: u64, p: u64) -> u64 {
    let mut m : u64 = 1u64
    while m + 1u64 < n { hstep(n, p, m)   m = m + 1u64 }
    return 0u64
}
/* p_m(x) = (x - h_mm) p_{m-1}(x) - sum_{i=1}^{m-1} h_im (prod_{j=i}^{m-1} h_{j+1,j}) p_{i-1}(x), 1-indexed h = TOM_H[a-1][b-1] */
fn hpoly_m(n: u64, p: u64, m: u64) -> u64 {
    let hmm : u64 = TOM_H[(m - 1u64) * n + (m - 1u64)]
    let mut k : u64 = 0u64
    while k <= m { TOM_PP[m * 705u64 + k] = 0u64   k = k + 1u64 }
    k = 0u64
    while k < m {
        let c : u64 = TOM_PP[(m - 1u64) * 705u64 + k]
        TOM_PP[m * 705u64 + k + 1u64] = (TOM_PP[m * 705u64 + k + 1u64] + c) % p
        TOM_PP[m * 705u64 + k] = (TOM_PP[m * 705u64 + k] + p - mulmod(hmm, c, p)) % p
        k = k + 1u64
    }
    let mut prod : u64 = 1u64
    let mut i : u64 = m - 1u64
    while i >= 1u64 {
        prod = mulmod(prod, TOM_H[i * n + (i - 1u64)], p)
        let coef : u64 = mulmod(TOM_H[(i - 1u64) * n + (m - 1u64)], prod, p)
        if coef != 0u64 {
            k = 0u64
            while k < i { TOM_PP[m * 705u64 + k] = (TOM_PP[m * 705u64 + k] + p - mulmod(coef, TOM_PP[(i - 1u64) * 705u64 + k], p)) % p   k = k + 1u64 }
        }
        i = i - 1u64
    }
    return 0u64
}
fn hpoly(n: u64, p: u64) -> u64 {
    TOM_PP[0u64] = 1u64
    let mut m : u64 = 1u64
    while m <= n { hpoly_m(n, p, m)   m = m + 1u64 }
    let mut k : u64 = 0u64
    while k <= n { TOM_PC[k] = TOM_PP[n * 705u64 + k]   k = k + 1u64 }
    return 0u64
}
/* ---- Garner: the table Q_j mod p_i, the digits, the centred value, the image ---- */
fn gtable() -> u64 {
    let mut i : u64 = 0u64
    while i < TOM_NP {
        let pi : u64 = TOM_PR[i]
        let mut q : u64 = 1u64
        let mut j : u64 = 0u64
        while j <= i { TOM_TAB[j * TOM_PMAX + i] = q   q = mulmod(q, TOM_PR[j] % pi, pi)   j = j + 1u64 }
        TOM_INV[i] = invmod(TOM_TAB[i * TOM_PMAX + i], pi)
        i = i + 1u64
    }
    mgs_setu(R_P, 1u64)
    i = 0u64
    while i < TOM_NP { mgs_setu(R_T, TOM_PR[i])   mgs_mul(R_T2, R_P, R_T)   mgs_copy(R_P, R_T2)   i = i + 1u64 }
    return 0u64
}
fn gdigits(k: u64) -> u64 {
    let mut i : u64 = 0u64
    while i < TOM_NP {
        let pi : u64 = TOM_PR[i]
        let mut x : u64 = 0u64
        let mut j : u64 = 0u64
        while j < i { x = (x + mulmod(TOM_TD[j], TOM_TAB[j * TOM_PMAX + i], pi)) % pi   j = j + 1u64 }
        TOM_TD[i] = mulmod((TOM_CR[k * TOM_PMAX + i] + pi - x) % pi, TOM_INV[i], pi)
        i = i + 1u64
    }
    return 0u64
}
fn cimg(k: u64) -> u64 { return ((&TOM_C) as u64) + k * TOM_IW * 8u64 }
fn wimg(k: u64) -> u64 { return ((&TOM_W) as u64) + k * TOM_IW * 8u64 }
fn gvalue(k: u64) -> u64 {
    mgs_setu(R_X, TOM_TD[TOM_NP - 1u64])
    let mut j : u64 = TOM_NP - 1u64
    while j > 0u64 {
        j = j - 1u64
        mgs_setu(R_T, TOM_PR[j])   mgs_mul(R_T2, R_X, R_T)   mgs_setu(R_T, TOM_TD[j])   mgs_add(R_X, R_T2, R_T)
    }
    mgs_add(R_T, R_X, R_X)
    if mgs_cmp(R_T, R_P) == 2u64 { mgs_sub(R_T2, R_X, R_P)   mgs_copy(R_X, R_T2) }
    mgs_store(R_X, cimg(k))
    return 0u64
}
fn tom_charpoly() -> u64 @export {
    let n : u64 = TOM_N
    let mut l : u64 = 0u64
    while l < TOM_NP {
        let p : u64 = TOM_PR[l]
        hfill(p)
        hreduce(n, p)
        hpoly(n, p)
        let mut k : u64 = 0u64
        while k <= n { TOM_CR[k * TOM_PMAX + l] = TOM_PC[k]   k = k + 1u64 }
        l = l + 1u64
    }
    gtable()
    let mut k : u64 = 0u64
    while k <= n { gdigits(k)   gvalue(k)   k = k + 1u64 }
    return 1u64
}
/* ---- the coefficient images ---- */
fn csign(k: u64) -> u64 {                                     /* 0 zero, 1 positive, 2 negative */
    let hdr : u64 = TOM_C[k * TOM_IW]
    if (hdr & TOM_MASK) == 0u64 { return 0u64 }
    if (hdr >> 32u64) == 0u64 { return 1u64 }
    return 2u64
}
fn cload(r: u64, k: u64) -> u64 { mgs_load(r, cimg(k))   return 0u64 }
/* the image at src shifted left by sh limbs into TOM_IMG, loaded into r */
fn imgshift(r: u64, src: u64, sh: u64) -> u64 {
    let p : *u64 = src as *u64
    let hdr : u64 = p[0u64]
    let len : u64 = hdr & TOM_MASK
    if len == 0u64 { TOM_IMG[0u64] = 0u64   mgs_load(r, (&TOM_IMG) as u64)   return 0u64 }
    if len + sh > 4096u64 { TOM_ERR = 9u64   return 0u64 }
    TOM_IMG[0u64] = ((hdr >> 32u64) << 32u64) | (len + sh)
    let mut i : u64 = 0u64
    while i < sh { TOM_IMG[1u64 + i] = 0u64   i = i + 1u64 }
    i = 0u64
    while i < len { TOM_IMG[1u64 + sh + i] = p[1u64 + i]   i = i + 1u64 }
    mgs_load(r, (&TOM_IMG) as u64)
    return 0u64
}
fn cshift(r: u64, k: u64, sh: u64) -> u64 { return imgshift(r, cimg(k), sh) }
fn shiftreg(r: u64, sh: u64) -> u64 { mgs_store(r, (&TOM_IMG2) as u64)   return imgshift(r, (&TOM_IMG2) as u64, sh) }
/* ---- Descartes on the coefficient signs: V and the multiplicity of the root 0 ---- */
fn tom_descartes() -> u64 @export {
    let n : u64 = TOM_N
    let mut k : u64 = 0u64
    TOM_M0 = 0u64
    while k <= n { if csign(k) == 0u64 { if TOM_M0 == k { TOM_M0 = k + 1u64 } }   k = k + 1u64 }
    let mut v : u64 = 0u64
    let mut last : u64 = 0u64
    k = 0u64
    while k <= n {
        let sg : u64 = csign(k)
        if sg != 0u64 { if last != 0u64 { if sg != last { v = v + 1u64 } }   last = sg }
        k = k + 1u64
    }
    return v
}
fn tom_m0() -> u64 @export { return TOM_M0 }
/* ---- P^(d)(m / 2^32) · 2^{32 (n - d)} into R_V (Horner on limb-shifted images); returns its sign code ---- */
fn falling(i: u64, d: u64) -> u64 { let mut f : u64 = 1u64   let mut t : u64 = 0u64   while t < d { f = f * (i - t)   t = t + 1u64 }   return f }
fn tom_eval(d: u64, mreg: u64) -> u64 {
    let n : u64 = TOM_N
    mgs_zero(R_ACC)
    let mut i : u64 = n + 1u64
    while i > d {
        i = i - 1u64
        mgs_mul(R_T, R_ACC, mreg)
        if d == 0u64 { cshift(R_CI, i, n - i) } else { cload(R_CI, i)   mgs_setu(R_T2, falling(i, d))   mgs_mul(R_T3, R_CI, R_T2)   mgs_copy(R_CI, R_T3)   shiftreg(R_CI, n - i) }
        mgs_add(R_ACC, R_T, R_CI)
    }
    mgs_copy(R_V, R_ACC)
    return signcode(R_V)
}
/* m = 2^(bits + 32): the start of every descent, above every root (the infinity norm is below 2^bits) */
fn setstart(bits: u64) -> u64 {
    let b : u64 = bits + 32u64
    let idx : u64 = b / 32u64
    TOM_IMG[0u64] = idx + 1u64
    let mut i : u64 = 0u64
    while i < idx { TOM_IMG[1u64 + i] = 0u64   i = i + 1u64 }
    TOM_IMG[1u64 + idx] = 1u64 << (b % 32u64)
    mgs_load(R_M, (&TOM_IMG) as u64)
    return 0u64
}
/* Newton from above on P^(d): the bracket (rlo, rhi] of its largest root in units of 2^-32; 1 found, 0 refused by name */
fn newtonstep(d: u64) -> u64 {                                /* 0 moved, 1 bracket closed, 2 exact root, 3 refused */
    let sv : u64 = tom_eval(d, R_M)
    if sv == 0u64 { return 2u64 }
    if sv == 2u64 { TOM_ERR = 5u64   return 3u64 }
    mgs_copy(R_SV, R_V)
    if tom_eval(d + 1u64, R_M) != 1u64 {
        /* P > 0 and P' <= 0 here: above every root P' > 0, so M is BELOW the top root r; Newton from above never crosses r (all roots real),
         *   so M was reached from R_PREV = M + 1 by the unit step and r lies in (M, M + 1] -- an EVEN-multiplicity root, where P keeps its sign
         *   (10-27: Z4 at e != 0 doubles every eigenvalue; the old refusal err 6 was this).  A start point below the roots is still refused. */
        mgs_sub(R_T, R_PREV, R_M)
        if mgs_cmp(R_T, R_ONE) == 1u64 { mgs_copy(R_M1, R_M)   mgs_copy(R_M, R_PREV)   return 1u64 }
        TOM_ERR = 6u64   return 3u64
    }
    mgs_divmod(R_Q, R_T, R_SV, R_V)
    mgs_copy(R_PREV, R_M)
    if mgs_iszero(R_Q) == 0u64 { mgs_sub(R_T, R_M, R_Q)   mgs_copy(R_M, R_T)   return 0u64 }
    mgs_sub(R_M1, R_M, R_ONE)
    let s1 : u64 = tom_eval(d, R_M1)
    if s1 == 2u64 { return 1u64 }
    if s1 == 0u64 { mgs_copy(R_M, R_M1)   return 2u64 }
    mgs_copy(R_M, R_M1)
    return 0u64
}
fn tom_newton(d: u64, bits: u64, rlo: u64, rhi: u64) -> u64 {
    setstart(bits)
    mgs_copy(R_PREV, R_M)
    TOM_ITER = 0u64
    TOM_MULT = 0u64
    let mut st : u64 = 0u64
    while st == 0u64 {
        st = newtonstep(d)
        TOM_ITER = TOM_ITER + 1u64
        if TOM_ITER > 400000u64 { TOM_ERR = 7u64   st = 3u64 }
    }
    if st == 3u64 { return 0u64 }
    if st == 2u64 { mgs_copy(rlo, R_M)   mgs_copy(rhi, R_M) } else { mgs_copy(rlo, R_M1)   mgs_copy(rhi, R_M) }
    /* the multiplicity of the root in (lo, hi]: the Budan-Fourier count above lo minus the count above hi (exact on a real-rooted P); an exact
     *   dyadic root is counted on (lo - 1, hi] */
    if d == 0u64 {
        if st == 2u64 { mgs_sub(R_X, rlo, R_ONE)   TOM_MULT = tom_count(R_X) - tom_count(rhi) } else { TOM_MULT = tom_count(rlo) - tom_count(rhi) }
    }
    return 1u64
}
/* ---- Budan-Fourier: the number of roots of P above m / 2^32 -- the sign changes of the Taylor coefficients at m of P(x / 2^32) 2^{32 n} ---- */
fn tom_count(mreg: u64) -> u64 {
    let n : u64 = TOM_N
    let mut i : u64 = 0u64
    while i <= n { cshift(R_T, i, n - i)   mgs_store(R_T, wimg(i))   i = i + 1u64 }
    let mut k : u64 = 0u64
    while k < n {
        i = n
        while i > k {
            i = i - 1u64
            mgs_load(R_T, wimg(i + 1u64))   mgs_mul(R_T2, R_T, mreg)   mgs_load(R_T3, wimg(i))   mgs_add(R_T, R_T3, R_T2)   mgs_store(R_T, wimg(i))
        }
        k = k + 1u64
    }
    let mut v : u64 = 0u64
    let mut last : u64 = 0u64
    i = 0u64
    while i <= n {
        mgs_load(R_T, wimg(i))
        let sgw : u64 = signcode(R_T)
        if sgw != 0u64 { if last != 0u64 { if sgw != last { v = v + 1u64 } }   last = sgw }
        i = i + 1u64
    }
    return v
}
/* ---- the second root: sign bisection between a (P > 0) and b (P < 0), both in units of 2^-32 ---- */
fn signbisect() -> u64 {                                      /* R_A, R_B in; the bracket in (R_L1LO, R_L1HI] */
    let mut go : u64 = 1u64
    while go == 1u64 {
        mgs_sub(R_T, R_B, R_A)
        if mgs_cmp(R_T, R_ONE) != 2u64 { go = 0u64 } else {
            mgs_add(R_T, R_A, R_B)   mgs_divmod(R_MID, R_T2, R_T, R_TWO)
            let sg : u64 = tom_eval(0u64, R_MID)
            if sg == 2u64 { mgs_copy(R_B, R_MID) }
            if sg == 1u64 { mgs_copy(R_A, R_MID) }
            if sg == 0u64 { mgs_copy(R_A, R_MID)   mgs_copy(R_B, R_MID)   go = 0u64 }
        }
    }
    mgs_copy(R_L1LO, R_A)   mgs_copy(R_L1HI, R_B)
    return 1u64
}
/* count bisection: the largest a with at least two roots above it, between R_A (count >= 2) and R_B (count <= 1) */
fn countbisect() -> u64 {
    let mut go : u64 = 1u64
    while go == 1u64 {
        mgs_sub(R_T, R_B, R_A)
        if mgs_cmp(R_T, R_ONE) != 2u64 { go = 0u64 } else {
            mgs_add(R_T, R_A, R_B)   mgs_divmod(R_MID, R_T2, R_T, R_TWO)
            if tom_count(R_MID) >= 2u64 { mgs_copy(R_A, R_MID) } else { mgs_copy(R_B, R_MID) }
        }
    }
    mgs_copy(R_L1LO, R_A)   mgs_copy(R_L1HI, R_B)
    return 1u64
}
/* the second-largest root of P: the nu path (P'' above lambda_2 by interlacing), the rho path, then the count bisection; certified by two counts */
fn tom_secondroot() -> u64 @export {
    TOM_SECOND = 0u64
    if tom_newton(1u64, TOM_ROWBITS, R_MULO, R_MUHI) == 0u64 { return 0u64 }
    if tom_eval(0u64, R_MULO) != 2u64 { TOM_SECOND = 3u64 } else {
        if tom_newton(2u64, TOM_ROWBITS, R_NULO, R_NUHI) == 0u64 { return 0u64 }
        if tom_eval(0u64, R_NULO) == 1u64 { TOM_SECOND = 1u64   mgs_copy(R_A, R_NULO) } else {
            if TOM_N >= 4u64 { if tom_newton(3u64, TOM_ROWBITS, R_RHLO, R_RHHI) == 0u64 { return 0u64 }   if tom_eval(0u64, R_RHLO) == 1u64 { TOM_SECOND = 2u64   mgs_copy(R_A, R_RHLO) } }
        }
        if TOM_SECOND == 0u64 { TOM_SECOND = 3u64 } else { mgs_copy(R_B, R_MULO)   signbisect() }
    }
    if TOM_SECOND != 3u64 {
        let c1 : u64 = tom_count(R_L1LO)
        let c2 : u64 = tom_count(R_L1HI)
        if c1 != 2u64 { TOM_SECOND = 3u64 }
        if c2 != 1u64 { TOM_SECOND = 3u64 }
    }
    if TOM_SECOND == 3u64 {
        mgs_zero(R_A)   mgs_copy(R_B, R_L0LO)
        if tom_count(R_A) < 2u64 { TOM_ERR = 10u64   return 0u64 }
        if tom_count(R_B) != 1u64 { TOM_ERR = 11u64   return 0u64 }
        countbisect()
    }
    return 1u64
}
/* ---- Newton's identities: p_1..p_6 from the coefficients into R_NS + k; e_k = (-1)^k c_{n-k} ---- */
fn newtonsums() -> u64 {
    let n : u64 = TOM_N
    let mut k : u64 = 1u64
    while k <= 6u64 {
        if k > n { mgs_zero(R_ES + k) } else { cload(R_ES + k, n - k)   if (k & 1u64) == 1u64 { mgs_neg(R_ES + k) } }
        k = k + 1u64
    }
    k = 1u64
    while k <= 6u64 {
        mgs_setu(R_T, k)   mgs_mul(R_T2, R_ES + k, R_T)
        if (k & 1u64) == 0u64 { mgs_neg(R_T2) }
        mgs_copy(R_NS + k, R_T2)
        let mut i : u64 = 1u64
        while i < k {
            mgs_mul(R_T2, R_ES + i, R_NS + k - i)
            if (i & 1u64) == 0u64 { mgs_neg(R_T2) }
            mgs_add(R_T3, R_NS + k, R_T2)   mgs_copy(R_NS + k, R_T3)
            i = i + 1u64
        }
        k = k + 1u64
    }
    return 0u64
}
fn tom_newtoncheck() -> u64 @export {                         /* the power sums against ΣΤΡΟΦΙΓΞ's traces of the same block (registers 81..86) */
    sfx_wtraces()
    newtonsums()
    let mut ok : u64 = 1u64
    let mut k : u64 = 1u64
    while k <= 6u64 { if mgs_cmp(R_NS + k, 80u64 + k) != 1u64 { ok = 0u64 }   k = k + 1u64 }
    return ok
}
/* ---- printing ---- */
fn say(r: u64) -> u64 { if mgs_sign(r) == 1u64 { if mgs_iszero(r) == 0u64 { s("-" as u64) } }   let n : u64 = mgs_todec(r, (&TOM_DEC) as u64, 16000u64)   TOM_DEC[n] = 0u8   s((&TOM_DEC) as u64)   return 0u64 }
fn dyadic(r: u64) -> u64 {                                    /* m / 2^32 to twelve decimals */
    mgs_divmod(R_T, R_T2, r, R_SC)
    say(R_T)   s("." as u64)
    mgs_mul(R_T3, R_T2, R_TEN)   mgs_divmod(R_T, R_T2, R_T3, R_SC)
    let f : u64 = mgs_get64(R_T)
    let mut pw : u64 = 100000000000u64
    let mut fr : u64 = f
    while pw > 0u64 { u(fr / pw)   fr = fr % pw   pw = pw / 10u64 }
    return 0u64
}
fn gname() -> u64 { if TOM_GK == 0u64 { s("Z2" as u64) }   if TOM_GK == 1u64 { s("S3" as u64) }   if TOM_GK == 2u64 { s("Q8" as u64) }   if TOM_GK == 3u64 { s("Z4" as u64) }   if TOM_GK == 4u64 { s("Z6" as u64) }   return 0u64 }
fn latt() -> u64 { if sfx_lx() != 2u64 { s(" L=" as u64)   u(sfx_lx())   s("x" as u64)   u(sfx_ly())   return 0u64 }   if sfx_ly() != 2u64 { s(" L=" as u64)   u(sfx_lx())   s("x" as u64)   u(sfx_ly()) }   return 0u64 }   /* the carrier when it is not the 2x2 (Addendum I); every 2x2 line unchanged */
fn head() -> u64 { s("TOM G=" as u64)   gname()   if TOM_YK == 0u64 { s(" y=locus" as u64) } else { s(" y=1/" as u64)   u(TOM_YK) }   latt()   s(" chi=" as u64)   u(TOM_CHI)   s(" e=" as u64)   u(TOM_CHI & 1u64)   u((TOM_CHI >> 1u64) & 1u64)   s(" k=" as u64)   u((TOM_CHI >> 2u64) & 1u64)   u((TOM_CHI >> 3u64) & 1u64)   s(" w=" as u64)   u(TOM_WPAR)   return 0u64 }
fn tom_printpoly() -> u64 @export {                           /* the exact polynomial, highest power first */
    head()   s(" P(x) =" as u64)
    let mut k : u64 = TOM_N + 1u64
    while k > 0u64 { k = k - 1u64   s(" " as u64)   cload(R_T, k)   say(R_T)   s(" x^" as u64)   u(k) }
    nl()
    return 0u64
}
/* ---- road B: ΧΑΡΑΚΤΗΡ's charpoly and sturm_big's count, where their envelope admits the block ---- */
fn caimg(k: u64) -> u64 {                                     /* ΧΑΡΑΚΤΗΡ's coefficient k as an image in TOM_IMG (64-bit limbs split in two) */
    let ln : u64 = ca_coeff_len(k as i64) as u64
    let sg : i64 = ca_coeff_sgn(k as i64)
    let mut sign : u64 = 0u64
    if sg < 0i64 { sign = 1u64 }
    TOM_IMG[0u64] = (sign << 32u64) | (2u64 * ln)
    if sg == 0i64 { TOM_IMG[0u64] = 0u64 }
    let mut j : u64 = 0u64
    while j < ln { let w : u64 = ca_coeff_limb(k as i64, j as i64)   TOM_IMG[1u64 + 2u64 * j] = w & TOM_MASK   TOM_IMG[2u64 + 2u64 * j] = w >> 32u64   j = j + 1u64 }
    mgs_load(R_T, (&TOM_IMG) as u64)
    return 0u64
}
fn tom_roadb() -> u64 @export {                               /* 1 EQUAL, 0 PART, 2 refused by the envelope (said) */
    let n : u64 = TOM_N
    if n > 64u64 { head()   s(" ROADB REFUSED-BY-ENVELOPE n=" as u64)   u(n)   nl()   return 2u64 }
    if sfx_wblockint() == 0u64 { head()   s(" ROADB REFUSED-BY-ENVELOPE entries past 2^60" as u64)   nl()   return 2u64 }
    ca_reset(n as i64)
    let mut i : u64 = 0u64
    while i < n {
        let mut j : u64 = 0u64
        while j < n {
            let v : i64 = sfx_b1(i, j) as i64
            if v > 1048576i64 { head()   s(" ROADB REFUSED-BY-ENVELOPE an entry past 2^20" as u64)   nl()   return 2u64 }
            if v < (0i64 - 1048576i64) { head()   s(" ROADB REFUSED-BY-ENVELOPE an entry past 2^20" as u64)   nl()   return 2u64 }
            ca_set(i as i64, j as i64, v)
            j = j + 1u64
        }
        i = i + 1u64
    }
    if ca_charpoly() != 0i32 { head()   s(" ROADB ca_charpoly refused" as u64)   met(0u64)   return 0u64 }
    let mut eq : u64 = 0u64
    let mut k : u64 = 0u64
    while k <= n { caimg(k)   cload(R_CI, k)   if mgs_cmp(R_T, R_CI) == 1u64 { eq = eq + 1u64 }   k = k + 1u64 }
    head()   s(" ROADB CHARAKTER coefficients equal " as u64)   u(eq)   s(" of " as u64)   u(n + 1u64)
    let mut ok : u64 = 0u64
    if eq == n + 1u64 { ok = 1u64 }
    met(ok)
    if ca_load_chain(1i64) != 0i32 { head()   s(" ROADB sturm chain refused" as u64)   met(0u64)   return 0u64 }
    mgs_divmod(R_T, R_T2, R_L0LO, R_SC)   let mut lo : u64 = mgs_get64(R_T)   if lo > 0u64 { lo = lo - 1u64 }
    mgs_add(R_T3, R_L0HI, R_SC)   mgs_sub(R_T2, R_T3, R_ONE)   mgs_divmod(R_T, R_T3, R_T2, R_SC)   let hi : u64 = mgs_get64(R_T)
    let cnt : i64 = root_count2(lo as i64, 1i64, hi as i64, 1i64)
    head()   s(" ROADB sturm roots in (" as u64)   u(lo)   s(", " as u64)   u(hi)   s("] around the top root=" as u64)   u(cnt as u64)   s(" against 1" as u64)
    let mut ok2 : u64 = 0u64
    if cnt == 1i64 { ok2 = 1u64 }
    met(ok2)
    return ok
}
/* ---- the recorded brackets ---- */
fn record(chi: u64, wpar: u64, n: u64, cert: u64) -> u64 {
    let b : u64 = TOM_NB
    TOM_RINFO[b * 4u64] = chi   TOM_RINFO[b * 4u64 + 1u64] = wpar   TOM_RINFO[b * 4u64 + 2u64] = n   TOM_RINFO[b * 4u64 + 3u64] = cert
    mgs_store(R_L0LO, ((&TOM_RLO) as u64) + b * 64u64)
    mgs_store(R_L0HI, ((&TOM_RHI) as u64) + b * 64u64)
    TOM_NB = b + 1u64
    return b
}
fn tom_nb() -> u64 @export { return TOM_NB }
fn tom_rchi(b: u64) -> u64 @export { return TOM_RINFO[b * 4u64] }
fn tom_rwpar(b: u64) -> u64 @export { return TOM_RINFO[b * 4u64 + 1u64] }
fn tom_rload(b: u64) -> u64 @export { mgs_load(R_BLO, ((&TOM_RLO) as u64) + b * 64u64)   mgs_load(R_BHI, ((&TOM_RHI) as u64) + b * 64u64)   return 0u64 }
/* ---- the per-block driver: charpoly, certificate, Newton sums, the top root, the second root when asked ---- */
fn tom_runblock(chi: u64, wpar: u64, second: u64) -> u64 @export {
    let n : u64 = tom_block(chi, wpar)
    if n == 0u64 { if TOM_ERR == 0u64 { head()   s(" EMPTY: no rows in this block" as u64)   nl()   return 2u64 }   s("TOM-REFUSED block chi=" as u64)   u(chi)   s(" w=" as u64)   u(wpar)   s(" err=" as u64)   u(TOM_ERR)   nl()   return 0u64 }
    tom_charpoly()
    let v : u64 = tom_descartes()
    let mut cert : u64 = 0u64
    if v == n - TOM_M0 { cert = 1u64 }
    head()   s(" n=" as u64)   u(n)   s(" primes=" as u64)   u(TOM_NP)   s(" rowbits=" as u64)   u(TOM_ROWBITS)   s(" coeffbits=" as u64)   cload(R_T, 0u64)   u(mgs_bits(R_T))   s(" V=" as u64)   u(v)   s(" m0=" as u64)   u(TOM_M0)   s(" real-rooted" as u64)   met(cert)
    let nc : u64 = tom_newtoncheck()
    head()   s(" Newton sums p_1..p_6 equal the traces" as u64)   met(nc)
    if tom_newton(0u64, TOM_ROWBITS, R_L0LO, R_L0HI) == 0u64 { head()   s(" TOP REFUSED err=" as u64)   u(TOM_ERR)   nl()   return 0u64 }
    head()   s(" TOP iterations=" as u64)   u(TOM_ITER)   s(" lo=" as u64)   dyadic(R_L0LO)   s(" hi=" as u64)   dyadic(R_L0HI)   s(" mult=" as u64)   u(TOM_MULT)   nl()
    if chi == 0u64 { if wpar <= 1u64 { head()   s(" Perron root simple (mult=1, ΑΠΕΡΑΝΤΟΝ perron_symmetric)" as u64)   let mut ps : u64 = 0u64   if TOM_MULT == 1u64 { ps = 1u64 }   met(ps) } }
    record(chi, wpar, n, cert)
    if second == 1u64 {
        if n < 2u64 { head()   s(" SECOND none: the block has one root" as u64)   nl()   return 1u64 }
        if tom_secondroot() == 0u64 { head()   s(" SECOND REFUSED err=" as u64)   u(TOM_ERR)   nl()   return 0u64 }
        head()   s(" SECOND path=" as u64)   u(TOM_SECOND)   s(" lo=" as u64)   dyadic(R_L1LO)   s(" hi=" as u64)   dyadic(R_L1HI)   nl()
    }
    return 1u64
}
fn tom_l0lo() -> u64 @export { return R_L0LO }
fn tom_l0hi() -> u64 @export { return R_L0HI }
fn tom_l1lo() -> u64 @export { return R_L1LO }
fn tom_l1hi() -> u64 @export { return R_L1HI }
fn tom_dyadic(r: u64) -> u64 @export { return dyadic(r) }
/* ---- the block itself (the author's request, 06:3x): the integer entries row-major, the scale named -- w(+1) = 1/y, w(-1) = 1 per plaquette,
 *      twelve plaquettes per step (four spatial in D, eight temporal in K), so B = yk^6 · B_true with B_true on e^{beta chi} weights ---- */
fn tom_printblock() -> u64 @export {
    let n : u64 = TOM_N
    if n > 8u64 { return 0u64 }
    if sfx_wblockint() == 0u64 { head()   s(" BLOCK REFUSED-BY-SIZE: an entry past 2^60" as u64)   nl()   return 0u64 }
    head()   s(" n=" as u64)   u(n)   s(" scale=" as u64)   u(TOM_YK)   s("^6 B = [" as u64)
    let mut i : u64 = 0u64
    while i < n {
        if i > 0u64 { s("," as u64) }
        s("[" as u64)
        let mut j : u64 = 0u64
        while j < n {
            if j > 0u64 { s("," as u64) }
            let v : i64 = sfx_b1(i, j) as i64
            if v < 0i64 { s("-" as u64)   u((0i64 - v) as u64) } else { u(v as u64) }
            j = j + 1u64
        }
        s("]" as u64)
        i = i + 1u64
    }
    s("]" as u64)   nl()
    return 1u64
}
/* ---- the inversion test (the author's reading of the self-reciprocity, 06:3x): the spectrum is closed under lambda -> mu^2/lambda iff
 *      x^n P(mu^2/x) = (-1)^n mu^n P(x), i.e. c_0 = (-1)^n mu^n and c_i = (-1)^n mu^(n-2i) c_(n-i) for every i < n/2 -- exact, decided
 *      before any root is bracketed: mu the integer n-th root of |c_0| by bisection, refused by name when |c_0| is no n-th power ---- */
const R_MU : u64 = 164u64
const R_MUP : u64 = 165u64
const R_MU2 : u64 = 166u64
const R_PREV : u64 = 167u64                   /* the Newton iterate before the last move (10-27: an even-multiplicity top root is bracketed, not refused) */
fn bigpow(dst: u64, base: u64, e: u64) -> u64 {
    mgs_setu(dst, 1u64)
    let mut k : u64 = 0u64
    while k < e { mgs_mul(R_T2, dst, base)   mgs_copy(dst, R_T2)   k = k + 1u64 }
    return 0u64
}
fn introot(n: u64) -> u64 {                                   /* |c_0| in R_T3; mu into R_MU and mu^n into R_MUP; 1 exact, 0 not an n-th power */
    let bits : u64 = mgs_bits(R_T3)
    mgs_setu(R_A, 1u64)
    setstart(bits / n + 1u64)                                 /* R_M = 2^(bits/n + 33) > the root */
    mgs_copy(R_B, R_M)
    let mut go : u64 = 1u64
    while go == 1u64 {
        mgs_sub(R_T, R_B, R_A)
        if mgs_cmp(R_T, R_ONE) != 2u64 { go = 0u64 } else {
            mgs_add(R_T, R_A, R_B)   mgs_divmod(R_MID, R_T2, R_T, R_TWO)
            bigpow(R_MUP, R_MID, n)
            let c : u64 = mgs_cmp(R_MUP, R_T3)
            if c == 1u64 { mgs_copy(R_A, R_MID)   mgs_copy(R_B, R_MID)   go = 0u64 }
            if c == 0u64 { mgs_copy(R_A, R_MID) }
            if c == 2u64 { mgs_copy(R_B, R_MID) }
        }
    }
    mgs_copy(R_MU, R_A)
    bigpow(R_MUP, R_MU, n)
    if mgs_cmp(R_MUP, R_T3) == 1u64 { return 1u64 }
    return 0u64
}
fn tom_recip() -> u64 @export {                               /* 1 the spectrum is closed under lambda -> mu^2/lambda (said with mu), 0 not (said why) */
    let n : u64 = TOM_N
    if csign(0u64) == 0u64 { head()   s(" RECIPROCAL: NO (c_0 = 0, a zero eigenvalue)" as u64)   nl()   return 0u64 }
    cload(R_T3, 0u64)
    if mgs_sign(R_T3) == 1u64 { mgs_neg(R_T3) }
    if introot(n) == 0u64 { head()   s(" RECIPROCAL: NO (|c_0| is not an n-th power)" as u64)   nl()   return 0u64 }
    mgs_mul(R_MU2, R_MU, R_MU)
    let mut i : u64 = 0u64
    while 2u64 * i < n {
        cload(R_T, n - i)
        mgs_mul(R_T2, R_T, R_MUP)
        if (n & 1u64) == 1u64 { mgs_neg(R_T2) }
        cload(R_CI, i)
        if mgs_cmp(R_T2, R_CI) != 1u64 { head()   s(" RECIPROCAL: NO (mu=" as u64)   say(R_MU)   s(", coefficient " as u64)   u(i)   s(" parts from its mirror)" as u64)   nl()   return 0u64 }
        mgs_divmod(R_T, R_T2, R_MUP, R_MU2)   mgs_copy(R_MUP, R_T)
        i = i + 1u64
    }
    head()   s(" RECIPROCAL: YES mu=" as u64)   say(R_MU)   s(" -- the spectrum is closed under lambda -> mu^2/lambda" as u64)   nl()
    return 1u64
}
/* ---- the locus road (Addendum I): the group set, the weights handed in by the harness through sfx_setw, then the rest ---- */
fn tom_prepare_group(gk: u64) -> u64 @export {
    consts()
    TOM_GK = gk   TOM_YK = 0u64   TOM_NB = 0u64
    if sfx_setgroup(gk) == 0u64 { return 0u64 }
    return 1u64
}
fn tom_prepare_rest() -> u64 @export {
    if sfx_orbits() == 0u64 { return 0u64 }
    if sfx_sym() == 0u64 { return 0u64 }
    if sfx_fillks() == 0u64 { return 0u64 }
    if sfx_primes() == 0u64 { return 0u64 }
    if sfx_bound() == 0u64 { return 0u64 }
    if sfx_err() != 0u64 { return 0u64 }
    return 1u64
}
