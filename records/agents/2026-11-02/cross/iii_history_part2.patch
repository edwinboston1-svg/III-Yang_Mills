+    intro s
+    exact row_bound_sharp Q z hz (fun s s' => -(qP Q s) - qP Q s')
+      (fun s s' => by have := qP_ge Q s; have := qP_ge Q s'; linarith) s
+
+end TwistEaterGeneral
