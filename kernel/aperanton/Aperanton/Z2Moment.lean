/-
  APERANTON -- THE BOUNDLESS, stage A8: THE SPECTRAL LAW OF THE WILSON LOOP ON THE 2 x 2 TORUS OF Z2, IN THE KERNEL.

  Emitted by STDLIB/scripts/aperanton_emit_mom.sh from the orbit dump of ΣΤΡΟΦΙΓΞ at y = 1/2 and y = 1/4: M = D K
  the transfer matrix over the 32 Gauss-law orbits, S the parity character, y = Lambda^-1 1 the end vector of the
  symmetrizer Lambda derived from M itself (Lambda_o / Lambda_0 = M(0,o) / M(o,0), consistent on every pair).
  N_a(R) = 1^T M^a S M^R S M^a y is <w, M_s^R w> for the symmetric positive semidefinite M_s = Lambda^1/2 M Lambda^-1/2
  and w = S M_s^a Lambda^1/2 y, so Spectral.lean makes it a moment sequence: nonnegative and LOG-CONVEX in R.
  The kernel decides N_a(R) >= 0 and N_a(R+1)^2 <= N_a(R) N_a(R+2) for a = 0, 1, 2 and R = 0..4 at both couplings
  (a cross-sections of vacuum on either side of the two insertions at distance R), pins the N values, and decides
  THE SIGHTED CONTROL: with mismatched ends (a left end that is not the right end conjugated by Lambda) the
  sandwich carries negative masses and the inequality FAILS at the R the emitter found.  No import, no axiom,
  no sorry, no native_decide; decide +kernel the only proof term.
-/

namespace Z2Mom

abbrev Mat := List (List Int)

def dot : List Int → List Int → Int
  | [], _ => 0
  | _, [] => 0
  | a :: as, b :: bs => a * b + dot as bs

/-- M v -/
def mv (m : Mat) (v : List Int) : List Int := m.map (fun r => dot r v)

/-- the diagonal S applied: pointwise product -/
def sv (s v : List Int) : List Int := List.zipWith (· * ·) s v

def mvPow (m : Mat) : Nat → List Int → List Int
  | 0, v => v
  | k + 1, v => mvPow m k (mv m v)

/-- N(R) = x^T M^a S M^R S M^a y -/
def sandwich (m : Mat) (s x y : List Int) (a R : Nat) : Int :=
  dot x (mvPow m a (sv s (mvPow m R (sv s (mvPow m a y)))))

/-- nonnegativity and log-convexity at R: N(R) >= 0 and N(R+1)^2 <= N(R) N(R+2) -/
def lc (N : Nat → Int) (R : Nat) : Prop := 0 ≤ N R ∧ N (R + 1) * N (R + 1) ≤ N R * N (R + 2)

instance (N : Nat → Int) (R : Nat) : Decidable (lc N R) := by unfold lc; infer_instance

