+            Real.log (∑ j, (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω) ⬝ᵥ
+              (transfer (plaqWeight sq (wilsonW R' β')) (tensorKernel (linkKernel (wilsonW R β))) ^ Rr *ᵥ
+                (diagonal (fun c => φ j (lineHol (ℓ₀ :: rest) c)) *ᵥ Ω))) / Rr) atTop (𝓝 s)) := by
