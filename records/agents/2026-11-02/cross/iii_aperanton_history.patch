index 000000000..9ef71b20d
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusT3.lean
@@ -0,0 +1,112 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W7′ (ADDENDUM I, THE ROAD): THE ASSEMBLY OF THE WEAK-COUPLING CLAUSE -- THE
+  GENERIC LAYER.
+
+  Weak.lean splits the vacuum sector's connected two-point function into the mass-weighted sectors' connected
+  two-point functions plus a between-sector term (`vacuum_cov_le`); TorusTwoPoint.lean bounds every sector's term
+  by α^R (`sector_two_point_enum`).  THE BETWEEN-SECTOR TERM is the sectors' disagreement about one observable,
+  |⟨shift s⟩_{h+t} − ⟨shift s⟩_h| over the twists t, and it is THE SAME TWO-POINT THEOREM READ WITH THE TWIST AS
+  THE FAR OBSERVABLE: a coset enumerator does not change under a shift by a code element (`enumAt_add_mem`, so a
+  twist may be read at any representative, `sectorExp_add_mem`), and with the twist's representative t′ placed
+  R levels past the wall, ⟨shift s⟩_{h+t′} = ⟨shift (t′ + s)⟩_h / ⟨shift t′⟩_h, whose distance from ⟨shift s⟩_h is
+  the two-point bound divided by ⟨shift t′⟩_h (`sector_dev_le`).  A sector's distance from the vacuum mixture is
+  at most the mass-weighted sum of its distances from the sectors (`dev_le_mixture`).  What remains per side is
+  GEOMETRY: a representative of every twist far from the wall (the sheets translated, their slabs' boundaries in D)
+  -- the per-L facts the instance files decide.  W = 0; the earning is the between-sector term as a corollary of
+  the two-point theorem, uniform in the side.  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Duality
+import Aperanton.Weak
+import Aperanton.TorusL
+import Aperanton.TorusSysL
+import Aperanton.TorusLevels
+import Aperanton.TorusDecay
+import Aperanton.TorusTwoPoint
+
+open Finset
+
+namespace Aperanton
+
+section EnumInvariance
+
+variable {ι : Type*} [Fintype ι] [DecidableEq ι]
+
+/-- a vector of F₂^ι added to itself vanishes -/
+theorem add_self_vec' (v : ι → ZMod 2) : v + v = 0 := by
+  funext i
+  exact CharTwo.add_self_eq_zero (v i)
+
+open Classical in
+/-- THE COSET ENUMERATOR IS INVARIANT UNDER A SHIFT BY A CODE ELEMENT: a twist may be read at any representative -/
+theorem enumAt_add_mem (D : Submodule (ZMod 2) (ι → ZMod 2)) (h d : ι → ZMod 2) (hd : d ∈ D) (y : ℝ) :
+    enumAt D (h + d) y = enumAt D h y := by
+  rw [enumAt_eq_sum, enumAt_eq_sum]
+  have hdd : d + d = 0 := add_self_vec' d
+  refine Finset.sum_nbij' (fun c => c + d) (fun c => c + d) ?_ ?_ ?_ ?_ ?_
+  · intro c hc
+    rw [Finset.mem_filter] at hc ⊢
+    exact ⟨Finset.mem_univ _, Submodule.add_mem _ hc.2 hd⟩
+  · intro c hc
+    rw [Finset.mem_filter] at hc ⊢
+    exact ⟨Finset.mem_univ _, Submodule.add_mem _ hc.2 hd⟩
+  · intro c _
+    rw [add_assoc, hdd, add_zero]
+  · intro c _
+    rw [add_assoc, hdd, add_zero]
+  · intro c _
+    rw [show h + d + c = h + (c + d) by abel]
+
+/-- the sector expectation is invariant under a shift of the twist by a code element -/
+theorem sectorExp_add_mem (D : Submodule (ZMod 2) (ι → ZMod 2)) (h d : ι → ZMod 2) (hd : d ∈ D) (y : ℝ)
+    (s : ι → ZMod 2) : sectorExp D y (h + d) s = sectorExp D y h s := by
+  unfold sectorExp
+  rw [show h + d + s = h + s + d by abel, enumAt_add_mem D (h + s) d hd, enumAt_add_mem D h d hd]
+
+end EnumInvariance
+
+section MixtureDeviation
+
+variable {H : Type*} [Fintype H]
+
+/-- a member's distance from the mixture is at most the mass-weighted sum of its distances from the members -/
+theorem dev_le_mixture (p F : H → ℝ) (hp0 : ∀ h, 0 ≤ p h) (hp : ∑ h, p h = 1) (h₀ : H) :
+    |F h₀ - ∑ k, p k * F k| ≤ ∑ k, p k * |F h₀ - F k| := by
+  have hsplit : F h₀ - ∑ k, p k * F k = ∑ k, p k * (F h₀ - F k) := by
+    simp only [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hp, one_mul]
+  rw [hsplit]
+  calc |∑ k, p k * (F h₀ - F k)| ≤ ∑ k, |p k * (F h₀ - F k)| := Finset.abs_sum_le_sum_abs _ _
+    _ = ∑ k, p k * |F h₀ - F k| := Finset.sum_congr rfl fun k _ => by rw [abs_mul, abs_of_nonneg (hp0 k)]
+
+end MixtureDeviation
+
+namespace TorusL
+
+open Classical in
+/-- THE BETWEEN-SECTOR DEVIATION AT ANY SIDE: a twist's representative t placed R levels past the wall changes the
+sector's reading of a plaquette set s near the wall by at most (#cubes of t)(Σ dOf s) α^R/(1 − α) -/
+theorem sector_dev_le (L mu : ℕ) (hadj : AdjList L mu)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (hy : (17 : ℝ) / 19 < y)
+    (t s : Fin (nPlaq L) → ZMod 2) (hdisj : ∀ i, t i = 0 ∨ s i = 0) (a R : ℕ)
+    (hnear : ∀ k, (∃ i, s i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L mu k ≤ a)
+    (hfar : ∀ k, (∃ i, t i ≠ 0 ∧ cubeMult L i k ≠ 0) → a + R ≤ levelAt L mu k) :
+    |sectorExp (LinearMap.range (cobdDual L)) y (h + t) s - sectorExp (LinearMap.range (cobdDual L)) y h s| ≤
+      (∑ k, if (∃ i, t i ≠ 0 ∧ cubeMult L i k ≠ 0) then (1 : ℝ) else 0) * (∑ k, dOf L s y k) *
+        alpha y ^ R / (1 - alpha y) := by
+  have hT := sector_two_point_enum L mu hadj hdeg hsix h y hy0 hy1 hy t s hdisj a R hnear hfar
+  have hY : 0 < sectorExp (LinearMap.range (cobdDual L)) y h t :=
+    div_pos (enumAt_pos _ _ _ hy0) (enumAt_pos _ _ _ hy0)
+  have hXY : sectorExp (LinearMap.range (cobdDual L)) y (h + t) s =
+      sectorExp (LinearMap.range (cobdDual L)) y h (t + s) / sectorExp (LinearMap.range (cobdDual L)) y h t := by
+    unfold sectorExp
+    rw [div_div_div_cancel_right₀ (enumAt_pos _ h y hy0).ne', add_assoc]
+  rw [hXY, div_sub' hY.ne', abs_div, abs_of_pos hY, div_le_iff₀ hY]
+  linarith [hT]
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusT3Assembly.lean b/LEAN/aperanton/Aperanton/TorusT3Assembly.lean
new file mode 100644
index 000000000..e6f25f168
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusT3Assembly.lean
@@ -0,0 +1,287 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W7′ (ADDENDUM I, THE ROAD): THE WEAK-COUPLING CLAUSE ASSEMBLED AT ANY SIDE --
+  THE VACUUM TWO-POINT FUNCTION OF THE Z₂ THEORY ON T⁴_L AT WEAK COUPLING.
+
+  THE STATEMENT (`vacuum_two_point_le`).  On the four-torus of side L at the original coupling y₀ (so the dual
+  coupling y* = (1 − y₀)/(1 + y₀) exceeds 17/19, i.e. y₀ < 1/18, β > ½ ln 18), for two disjoint plaquette sets s₂
+  near a wall and s₁ R levels past it, and with every twist given a representative far from both (the sheets
+  translated, one wall direction per sheet, R′ levels past it):
+      |⟨(−1)^{s₁+s₂}⟩_vac − ⟨(−1)^{s₁}⟩_vac ⟨(−1)^{s₂}⟩_vac|
+        ≤ (1/y*)^{|s₁|} · (#cubes of s₁)(Σ dOf s₂) α^R/(1 − α)  +  (2 Σ_q B_q(s₁)) (2 Σ_q B_q(s₂)),
+  B_q(s) = (#cubes of the far sheet q)(Σ dOf s) α^{R′}/(1 − α), α = 18 c₁(y*).  THE PIECES: Weak.lean's split of
+  the vacuum covariance into the sectors' terms and the between-sector term (`vacuum_cov_le`); each sector's term
+  by THE TWO-POINT FACTORIZATION (`sector_two_point_enum`, TorusTwoPoint.lean) with the sector expectation's sup
+  (1/y*)^{|s₁|}; the between-sector term by the mixture deviation (`dev_le_mixture'`), THE TELESCOPING OF A TWIST
+  OVER ITS SHEETS (`sectorExp_twist_sub_le`: a twist is a subset sum of the six sheets, each step one sheet) and
+  THE BETWEEN-SECTOR DEVIATION per sheet (`step_bound`: the sheet read at its far translate by `sectorExp_add_mem`,
+  then `sector_dev_le`).  The per-side facts enter as hypotheses: the five incidence facts (`hadj` along the wall
+  directions used, `hdeg`, `hsix`, `hcol`), the split, the far translates with their memberships, disjointness and
+  levels -- at side 3 all decided (TorusL3, TorusT3L3), the levels there at most one.  W = 0 (Dobrushin on the dual
+  of a gauge theory, through Wegner's duality); the earning is the clause as one theorem uniform in the side.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Dobrushin
+import Aperanton.Duality
+import Aperanton.Weak
+import Aperanton.TorusL
+import Aperanton.TorusLBridge
+import Aperanton.TorusSysL
+import Aperanton.TorusLevels
+import Aperanton.TorusDecay
+import Aperanton.TorusTwoPoint
+import Aperanton.TorusT3
+
+open Finset
+
+namespace Aperanton
+
+section Helpers
+
+variable {S : Type*} [Fintype S] [DecidableEq S] {G : Type*} [Fintype G] [DecidableEq G] [Nonempty G]
+
+end Helpers
+
+section MixtureFinset
+
+variable {ι : Type*}
+
+/-- a member's distance from a finset mixture is at most the mass-weighted sum of its distances from the members -/
+theorem dev_le_mixture' (p F : ι → ℝ) (H : Finset ι) (hp0 : ∀ h ∈ H, 0 ≤ p h) (hp : ∑ h ∈ H, p h = 1)
+    (h₀ : ι) : |F h₀ - ∑ k ∈ H, p k * F k| ≤ ∑ k ∈ H, p k * |F h₀ - F k| := by
+  have hsplit : F h₀ - ∑ k ∈ H, p k * F k = ∑ k ∈ H, p k * (F h₀ - F k) := by
+    simp only [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hp, one_mul]
+  rw [hsplit]
+  calc |∑ k ∈ H, p k * (F h₀ - F k)| ≤ ∑ k ∈ H, |p k * (F h₀ - F k)| := Finset.abs_sum_le_sum_abs _ _
+    _ = ∑ k ∈ H, p k * |F h₀ - F k| := Finset.sum_congr rfl fun k hk => by rw [abs_mul, abs_of_nonneg (hp0 k hk)]
+
+end MixtureFinset
+
+section Telescoping
+
+variable {ι : Type*} [Fintype ι] [DecidableEq ι]
+
+/-- THE TELESCOPING OF A TWIST OVER ITS SHEETS: if every single-sheet step moves a sector's reading by at most b q,
+a subset sum of sheets moves it by at most the sum of the b's -/
+theorem sectorExp_twist_sub_le (D : Submodule (ZMod 2) (ι → ZMod 2)) (y : ℝ) (s : ι → ZMod 2)
+    (sh : Fin 6 → (ι → ZMod 2)) (b : Fin 6 → ℝ)
+    (hstep : ∀ (h' : ι → ZMod 2) (q : Fin 6), |sectorExp D y (h' + sh q) s - sectorExp D y h' s| ≤ b q)
+    (h : ι → ZMod 2) (T : Finset (Fin 6)) :
+    |sectorExp D y (h + ∑ q ∈ T, sh q) s - sectorExp D y h s| ≤ ∑ q ∈ T, b q := by
+  induction T using Finset.induction_on with
+  | empty => simp
+  | insert q T hq ih =>
+    rw [Finset.sum_insert hq, Finset.sum_insert hq,
+      show h + (sh q + ∑ r ∈ T, sh r) = h + ∑ r ∈ T, sh r + sh q by abel]
+    calc |sectorExp D y (h + ∑ r ∈ T, sh r + sh q) s - sectorExp D y h s|
+        ≤ |sectorExp D y (h + ∑ r ∈ T, sh r + sh q) s - sectorExp D y (h + ∑ r ∈ T, sh r) s|
+          + |sectorExp D y (h + ∑ r ∈ T, sh r) s - sectorExp D y h s| :=
+            abs_sub_le (sectorExp D y (h + ∑ r ∈ T, sh r + sh q) s) (sectorExp D y (h + ∑ r ∈ T, sh r) s)
+              (sectorExp D y h s)
+      _ ≤ b q + ∑ r ∈ T, b r := add_le_add (hstep _ q) ih
+
+end Telescoping
+
+namespace TorusL
+
+/-- the number of cubes adjacent to a plaquette set -/
+noncomputable def cnt (L : ℕ) (t : Fin (nPlaq L) → ZMod 2) : ℝ :=
+  ∑ k, if (∃ i, t i ≠ 0 ∧ cubeMult L i k ≠ 0) then (1 : ℝ) else 0
+
+theorem dualVar_le_one (y₀ : ℝ) (hy0 : 0 < y₀) : dualVar y₀ ≤ 1 := by
+  unfold dualVar
+  rw [div_le_one (by linarith)]
+  linarith
+
+open Classical in
+/-- the sector expectation of a shift is at most (1/y)^|supp s| -/
+theorem sectorExp_le (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    sectorExp (LinearMap.range (cobdDual L)) y h s ≤ (1 / y) ^ wt s := by
+  rw [sectorExp_eq_gibbs L h s y hy0 hy1]
+  exact gibbs_le_of_le _ (torusSys L h y hy0 hy1).W_pos _ _ (shiftObs_le L h s y hy0 hy1)
+
+open Classical in
+/-- THE BETWEEN-SECTOR STEP: one sheet, read at its far translate, moves a sector's reading of s by at most
+cnt(far)(Σ dOf s) α^{R′}/(1 − α) -/
+theorem step_bound (L : ℕ) (mu : ℕ) (hadj : AdjList L mu)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (hy : (17 : ℝ) / 19 < y) (s sheet far : Fin (nPlaq L) → ZMod 2)
+    (hmem : far + sheet ∈ LinearMap.range (cobdDual L)) (hdisj : ∀ i, far i = 0 ∨ s i = 0) (a' R' : ℕ)
+    (hnear : ∀ k, (∃ i, s i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L mu k ≤ a')
+    (hfarlev : ∀ k, (∃ i, far i ≠ 0 ∧ cubeMult L i k ≠ 0) → a' + R' ≤ levelAt L mu k) (h' : Fin (nPlaq L) → ZMod 2) :
+    |sectorExp (LinearMap.range (cobdDual L)) y (h' + sheet) s - sectorExp (LinearMap.range (cobdDual L)) y h' s| ≤
+      cnt L far * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+  have hrep : sectorExp (LinearMap.range (cobdDual L)) y (h' + sheet) s =
+      sectorExp (LinearMap.range (cobdDual L)) y (h' + far) s := by
+    rw [← sectorExp_add_mem (LinearMap.range (cobdDual L)) (h' + sheet) (far + sheet) hmem y s]
+    congr 1
+    rw [show h' + sheet + (far + sheet) = h' + far + (sheet + sheet) by abel, add_self_vec', add_zero]
+  rw [hrep]
+  exact sector_dev_le L mu hadj hdeg hsix h' y hy0 hy1 hy far s hdisj a' R' hnear hfarlev
+
+open Classical in
+/-- THE WEAK-COUPLING CLAUSE AT ANY SIDE: the vacuum two-point function of the Z₂ theory on T⁴_L at the original
+coupling y₀ with dual coupling above 17/19, for disjoint plaquette sets separated by R wall levels, with every sheet
+given a far translate (R′ levels past its own wall) -/
+theorem vacuum_two_point_le (L : ℕ) (hadj : ∀ mu : Fin 4, AdjList L mu.val)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (hcol : ∀ (k : Fin (nCubes L)) (i : Fin (nPlaq L)), ((cubeMult L i k : ℕ) : ZMod 2) = vecOf L (cubeMask L k.val) i)
+    (hs : TorusLSplit L) (y₀ : ℝ) (hy0 : 0 < y₀) (hy1 : y₀ < 1) (hstar : (17 : ℝ) / 19 < dualVar y₀)
+    (s₁ s₂ : Fin (nPlaq L) → ZMod 2) (hdisj : ∀ i, s₁ i = 0 ∨ s₂ i = 0) (mu : Fin 4) (a R : ℕ)
+    (hnear : ∀ k, (∃ i, s₂ i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L mu.val k ≤ a)
+    (hfar : ∀ k, (∃ i, s₁ i ≠ 0 ∧ cubeMult L i k ≠ 0) → a + R ≤ levelAt L mu.val k)
+    (far : Fin 6 → (Fin (nPlaq L) → ZMod 2)) (dir : Fin 6 → Fin 4) (a' R' : ℕ)
+    (hfarmem : ∀ q, far q + vecOf L (sheetMask L q.val) ∈ D L)
+    (hfardisj₁ : ∀ q i, far q i = 0 ∨ s₁ i = 0) (hfardisj₂ : ∀ q i, far q i = 0 ∨ s₂ i = 0)
+    (hnear₁ : ∀ q k, (∃ i, s₁ i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L (dir q).val k ≤ a')
+    (hnear₂ : ∀ q k, (∃ i, s₂ i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L (dir q).val k ≤ a')
+    (hfarlev : ∀ q k, (∃ i, far q i ≠ 0 ∧ cubeMult L i k ≠ 0) → a' + R' ≤ levelAt L (dir q).val k) :
+    |vacExp (K L) y₀ (s₁ + s₂) - vacExp (K L) y₀ s₁ * vacExp (K L) y₀ s₂| ≤
+      (1 / dualVar y₀) ^ wt s₁ * (cnt L s₁ * (∑ k, dOf L s₂ (dualVar y₀) k) * alpha (dualVar y₀) ^ R /
+          (1 - alpha (dualVar y₀)))
+        + (2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s₁ (dualVar y₀) k) * alpha (dualVar y₀) ^ R' /
+            (1 - alpha (dualVar y₀)))
+          * (2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s₂ (dualVar y₀) k) * alpha (dualVar y₀) ^ R' /
+            (1 - alpha (dualVar y₀))) := by
+  set y := dualVar y₀ with hy
+  have hy0' : 0 < y := dualVar_pos y₀ hy0 hy1
+  have hy1' : y ≤ 1 := dualVar_le_one y₀ hy0
+  have hR : LinearMap.range (cobdDual L) = D L := range_cobdDual_eq_D L hcol
+  unfold TorusLSplit at hs
+  have hH : (H L).Nonempty := hs.nonempty
+  have hmass0 : ∀ h ∈ H L, 0 ≤ sectorMass (D L) (H L) y h := fun h _ => sectorMass_nonneg (D L) (H L) y hy0' h
+  have hmass1 : ∑ h ∈ H L, sectorMass (D L) (H L) y h = 1 := sectorMass_sum (D L) (H L) hH y hy0'
+  -- the sector terms
+  set B₁ : ℝ := (1 / y) ^ wt s₁ * (cnt L s₁ * (∑ k, dOf L s₂ y k) * alpha y ^ R / (1 - alpha y)) with hB₁
+  have hsector : ∀ h ∈ H L,
+      |sectorExp (D L) y h (s₁ + s₂) - sectorExp (D L) y h s₁ * sectorExp (D L) y h s₂| ≤ B₁ := by
+    intro h _
+    rw [← hR]
+    have h2 := sector_two_point_enum L mu.val (hadj mu) hdeg hsix h y hy0' hy1' hstar s₁ s₂ hdisj a R hnear hfar
+    have hle := sectorExp_le L h s₁ y hy0' hy1'
+    have hc : 0 ≤ cnt L s₁ * (∑ k, dOf L s₂ y k) * alpha y ^ R / (1 - alpha y) := by
+      have hα1 : alpha y < 1 := (alpha_lt_one_iff y hy0').mpr hstar
+      have hcnt : 0 ≤ cnt L s₁ := Finset.sum_nonneg fun k _ => by split_ifs <;> norm_num
+      have hd : 0 ≤ ∑ k, dOf L s₂ y k := Finset.sum_nonneg fun k _ => by
+        unfold dOf; split_ifs <;> positivity
+      have hα0 : 0 ≤ alpha y := alpha_nonneg y hy0' hy1'
+      apply div_nonneg _ (by linarith)
+      exact mul_nonneg (mul_nonneg hcnt hd) (pow_nonneg hα0 R)
+    calc _ ≤ sectorExp (LinearMap.range (cobdDual L)) y h s₁ *
+          (cnt L s₁ * (∑ k, dOf L s₂ y k) * alpha y ^ R / (1 - alpha y)) := h2
+      _ ≤ B₁ := mul_le_mul_of_nonneg_right hle hc
+  -- the between-sector deviations: every sector's reading is within 2 Σ_q b q of every other's
+  have hstep : ∀ (s : Fin (nPlaq L) → ZMod 2), (∀ q i, far q i = 0 ∨ s i = 0) →
+      (∀ q k, (∃ i, s i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L (dir q).val k ≤ a') →
+      ∀ (h' : Fin (nPlaq L) → ZMod 2) (q : Fin 6),
+        |sectorExp (D L) y (h' + vecOf L (sheetMask L q.val)) s - sectorExp (D L) y h' s| ≤
+          cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+    intro s hd hn h' q
+    rw [← hR]
+    have hmem : far q + vecOf L (sheetMask L q.val) ∈ LinearMap.range (cobdDual L) := by rw [hR]; exact hfarmem q
+    exact step_bound L (dir q).val (hadj (dir q)) hdeg hsix y hy0' hy1' hstar s (vecOf L (sheetMask L q.val)) (far q)
+      hmem (hd q) a' R' (hn q) (hfarlev q) h'
+  have hdev : ∀ (s : Fin (nPlaq L) → ZMod 2), (∀ q i, far q i = 0 ∨ s i = 0) →
+      (∀ q k, (∃ i, s i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L (dir q).val k ≤ a') →
+      ∀ h ∈ H L, ∀ k ∈ H L, |sectorExp (D L) y h s - sectorExp (D L) y k s| ≤
+        2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+    intro s hd hn h hh k hk
+    unfold H at hh hk
+    rw [Finset.mem_image] at hh hk
+    obtain ⟨T, _, rfl⟩ := hh
+    obtain ⟨T', _, rfl⟩ := hk
+    have hT := sectorExp_twist_sub_le (D L) y s (fun q => vecOf L (sheetMask L q.val))
+      (fun q => cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y)) (hstep s hd hn) 0 T
+    have hT' := sectorExp_twist_sub_le (D L) y s (fun q => vecOf L (sheetMask L q.val))
+      (fun q => cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y)) (hstep s hd hn) 0 T'
+    simp only [zero_add] at hT hT'
+    have hb0 : ∀ q, 0 ≤ cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+      intro q
+      have hα1 : alpha y < 1 := (alpha_lt_one_iff y hy0').mpr hstar
+      have hcnt : 0 ≤ cnt L (far q) := Finset.sum_nonneg fun k _ => by split_ifs <;> norm_num
+      have hdd : 0 ≤ ∑ k, dOf L s y k := Finset.sum_nonneg fun k _ => by
+        unfold dOf; split_ifs <;> positivity
+      apply div_nonneg _ (by linarith)
+      exact mul_nonneg (mul_nonneg hcnt hdd) (pow_nonneg (alpha_nonneg y hy0' hy1') R')
+    have hsub : ∀ U : Finset (Fin 6), ∑ q ∈ U, cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y)
+        ≤ ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) :=
+      fun U => Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ U) (fun q _ _ => hb0 q)
+    calc |sectorExp (D L) y (∑ q ∈ T, vecOf L (sheetMask L q.val)) s -
+            sectorExp (D L) y (∑ q ∈ T', vecOf L (sheetMask L q.val)) s|
+        ≤ |sectorExp (D L) y (∑ q ∈ T, vecOf L (sheetMask L q.val)) s - sectorExp (D L) y 0 s|
+          + |sectorExp (D L) y 0 s - sectorExp (D L) y (∑ q ∈ T', vecOf L (sheetMask L q.val)) s| :=
+            abs_sub_le _ _ _
+      _ ≤ (∑ q ∈ T, cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y))
+          + ∑ q ∈ T', cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+            rw [abs_sub_comm (sectorExp (D L) y 0 s)]
+            exact add_le_add hT hT'
+      _ ≤ 2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s y k) * alpha y ^ R' / (1 - alpha y) := by
+            have := hsub T
+            have := hsub T'
+            linarith
+  set Δ₁ : ℝ := 2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s₁ y k) * alpha y ^ R' / (1 - alpha y) with hΔ₁
+  set Δ₂ : ℝ := 2 * ∑ q : Fin 6, cnt L (far q) * (∑ k, dOf L s₂ y k) * alpha y ^ R' / (1 - alpha y) with hΔ₂
+  have hΔ₁0 : 0 ≤ Δ₁ := by
+    rw [hΔ₁]
+    apply mul_nonneg (by norm_num)
+    apply Finset.sum_nonneg
+    intro q _
+    have hα1 : alpha y < 1 := (alpha_lt_one_iff y hy0').mpr hstar
+    have hcnt : 0 ≤ cnt L (far q) := Finset.sum_nonneg fun k _ => by split_ifs <;> norm_num
+    have hdd : 0 ≤ ∑ k, dOf L s₁ y k := Finset.sum_nonneg fun k _ => by
+      unfold dOf; split_ifs <;> positivity
+    apply div_nonneg _ (by linarith)
+    exact mul_nonneg (mul_nonneg hcnt hdd) (pow_nonneg (alpha_nonneg y hy0' hy1') R')
+  have hΔ₂0 : 0 ≤ Δ₂ := by
+    rw [hΔ₂]
+    apply mul_nonneg (by norm_num)
+    apply Finset.sum_nonneg
+    intro q _
+    have hα1 : alpha y < 1 := (alpha_lt_one_iff y hy0').mpr hstar
+    have hcnt : 0 ≤ cnt L (far q) := Finset.sum_nonneg fun k _ => by split_ifs <;> norm_num
+    have hdd : 0 ≤ ∑ k, dOf L s₂ y k := Finset.sum_nonneg fun k _ => by
+      unfold dOf; split_ifs <;> positivity
+    apply div_nonneg _ (by linarith)
+    exact mul_nonneg (mul_nonneg hcnt hdd) (pow_nonneg (alpha_nonneg y hy0' hy1') R')
+  -- a sector's distance from the vacuum mixture
+  have hvac : ∀ (s : Fin (nPlaq L) → ZMod 2) (Δ : ℝ), 0 ≤ Δ →
+      (∀ h ∈ H L, ∀ k ∈ H L, |sectorExp (D L) y h s - sectorExp (D L) y k s| ≤ Δ) →
+      ∀ h ∈ H L, |sectorExp (D L) y h s - vacExp (K L) y₀ s| ≤ Δ := by
+    intro s Δ hΔ hpair h hh
+    rw [vacExp_eq_mixture (K L) (D L) (H L) hs s y₀ hy0 hy1]
+    calc |sectorExp (D L) y h s - ∑ k ∈ H L, sectorMass (D L) (H L) y k * sectorExp (D L) y k s|
+        ≤ ∑ k ∈ H L, sectorMass (D L) (H L) y k * |sectorExp (D L) y h s - sectorExp (D L) y k s| :=
+          dev_le_mixture' (sectorMass (D L) (H L) y) (fun k => sectorExp (D L) y k s) (H L) hmass0 hmass1 h
+      _ ≤ ∑ k ∈ H L, sectorMass (D L) (H L) y k * Δ :=
+          Finset.sum_le_sum fun k hk => mul_le_mul_of_nonneg_left (hpair h hh k hk) (hmass0 k hk)
+      _ = Δ := by rw [← Finset.sum_mul, hmass1, one_mul]
+  have hvac₁ := hvac s₁ Δ₁ hΔ₁0 (hdev s₁ hfardisj₁ hnear₁)
+  have hvac₂ := hvac s₂ Δ₂ hΔ₂0 (hdev s₂ hfardisj₂ hnear₂)
+  -- the assembly
+  have hcov := vacuum_cov_le (K L) (D L) (H L) hs s₁ s₂ y₀ hy0 hy1
+  rw [← hy] at hcov
+  have hterm1 : ∑ h ∈ H L, sectorMass (D L) (H L) y h *
+      |sectorExp (D L) y h (s₁ + s₂) - sectorExp (D L) y h s₁ * sectorExp (D L) y h s₂| ≤ B₁ := by
+    calc _ ≤ ∑ h ∈ H L, sectorMass (D L) (H L) y h * B₁ :=
+          Finset.sum_le_sum fun h hh => mul_le_mul_of_nonneg_left (hsector h hh) (hmass0 h hh)
+      _ = B₁ := by rw [← Finset.sum_mul, hmass1, one_mul]
+  have hterm2 : ∑ h ∈ H L, sectorMass (D L) (H L) y h *
+      (|sectorExp (D L) y h s₁ - vacExp (K L) y₀ s₁| * |sectorExp (D L) y h s₂ - vacExp (K L) y₀ s₂|) ≤ Δ₁ * Δ₂ := by
+    calc _ ≤ ∑ h ∈ H L, sectorMass (D L) (H L) y h * (Δ₁ * Δ₂) := by
+          apply Finset.sum_le_sum
+          intro h hh
+          apply mul_le_mul_of_nonneg_left _ (hmass0 h hh)
+          exact mul_le_mul (hvac₁ h hh) (hvac₂ h hh) (abs_nonneg _) hΔ₁0
+      _ = Δ₁ * Δ₂ := by rw [← Finset.sum_mul, hmass1, one_mul]
+  calc |vacExp (K L) y₀ (s₁ + s₂) - vacExp (K L) y₀ s₁ * vacExp (K L) y₀ s₂| ≤ _ := hcov
+    _ ≤ B₁ + Δ₁ * Δ₂ := add_le_add hterm1 hterm2
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusT3L3.lean b/LEAN/aperanton/Aperanton/TorusT3L3.lean
new file mode 100644
index 000000000..fb3ca7b28
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusT3L3.lean
@@ -0,0 +1,50 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W7′ (ADDENDUM I, THE ROAD): THE TWIST TRANSLATIONS AT SIDE THREE -- EVERY SHEET'S
+  TRANSLATE IS ANOTHER REPRESENTATIVE OF ITS TWIST.
+
+  The side-3 translation certificate (TorusLTrans3.lean, emitted and decided) says each of the 54 sums "sheet at
+  (c₁, c₂) plus sheet at (0, 0)" is a selection of the side-3 echelon basis of the cube faces and is the xor of the
+  two sheets as TorusLTrans.lean defines them; here the selection is read as membership in the boundary code D 3
+  (`trans_mem_D3`, through Echelon.lean and the certificate's two-way selections) and the sum as the sum of the two
+  sheets' vectors (`sheet_translate_mem_D3`), so a twist's sector may be read at any translate of its sheet
+  (`sectorExp_add_mem`, TorusT3.lean) -- the geometric fact the between-sector deviation needs, at side three.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.TorusL
+import Aperanton.TorusLBridge
+import Aperanton.TorusLCert3
+import Aperanton.TorusL3
+import Aperanton.TorusLTrans
+import Aperanton.TorusLTrans3
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- every translation sum lies in D 3 -/
+theorem trans_mem_D3 (j : Fin TorusLTrans3.transMasks.length) : vecOf 3 (TorusLTrans3.transMasks.get j) ∈ D 3 :=
+  mem_D_of_sel 3 TorusLCert3.basisBd3 TorusLCert3.pivBd3 TorusLCert3.selGBd3 TorusLCert3.selBBd3
+    TorusLCert3.Bd3_cert piv_lt_Bd3_3 TorusLCert3.Bd3_selG TorusLCert3.Bd3_selB _ _ (TorusLTrans3.trans_sel j)
+
+/-- THE TRANSLATE IS A REPRESENTATIVE: the (μν)-sheet at the complementary coordinates (c₁, c₂) plus the sheet at
+(0, 0) is a boundary, at side three -/
+theorem sheet_translate_mem_D3 (q c₁ c₂ : ℕ) (hq : q < 6) (h1 : c₁ < 3) (h2 : c₂ < 3) :
+    vecOf 3 (sheetAtMask 3 q c₁ c₂) + vecOf 3 (sheetAtMask 3 q 0 0) ∈ D 3 := by
+  have hj : q * 9 + c₁ * 3 + c₂ < TorusLTrans3.transMasks.length := by
+    rw [TorusLTrans3.trans_len]
+    omega
+  have h := trans_mem_D3 ⟨q * 9 + c₁ * 3 + c₂, hj⟩
+  rw [TorusLTrans3.trans_eq] at h
+  simp only at h
+  have e1 : (q * 9 + c₁ * 3 + c₂) / 9 = q := by omega
+  have e2 : (q * 9 + c₁ * 3 + c₂) % 9 / 3 = c₁ := by omega
+  have e3 : (q * 9 + c₁ * 3 + c₂) % 3 = c₂ := by omega
+  rw [e1, e2, e3, vecOf_eq, vecOfN_xor, ← vecOf_eq, ← vecOf_eq] at h
+  exact h
+
+end TorusL
+
+end Aperanton
diff --git a/LEAN/aperanton/Aperanton/TorusTwoPoint.lean b/LEAN/aperanton/Aperanton/TorusTwoPoint.lean
new file mode 100644
index 000000000..30fb4d547
--- /dev/null
+++ b/LEAN/aperanton/Aperanton/TorusTwoPoint.lean
@@ -0,0 +1,219 @@
+/-
+  APERANTON -- THE BOUNDLESS, stage W6 (ADDENDUM I, THE ROAD): THE SECTOR TWO-POINT FACTORIZATION AT ANY SIDE --
+  THE WEAK-COUPLING CLAUSE'S OBSERVABLE.
+
+  A dual sector's expectation of the shift observable, ⟨shiftObs h s⟩_h = E_{h+s}(y)/E_h(y) (`sectorExp_eq_gibbs`),
+  is the sector's reading of the plaquette set supp s.  Here the observable is taken apart: it is the product of
+  one ratio per plaquette (`shiftObs_eq_prod`), each ratio one outside supp s (`ratioAt_of_zero`), unchanged when a
+  cube adjacent to no plaquette of supp s is updated (`shiftObs_update_of_far`, Dobrushin's `hfree`), at most 1/y per
+  plaquette of supp s (`shiftObs_le`, the oscillation mass `dOf`), and MULTIPLICATIVE over disjoint supports
+  (`shiftObs_add`).  Dobrushin's covariance bound in the sector (`sector_cov_le`) then reads, for two plaquette sets
+  s₂ near the wall (its cubes at levels ≤ a) and s₁ far from it (its cubes at levels ≥ a + R):
+      |⟨shiftObs (s₁ + s₂)⟩ − ⟨shiftObs s₁⟩⟨shiftObs s₂⟩| ≤ ⟨shiftObs s₁⟩ · (#cubes of s₁)(Σ dOf s₂) α^R/(1 − α),
+  and through the fibre bridge the same for the enumerators (`sector_two_point_enum`): E_{h+s₁+s₂}/E_h factorizes
+  as (E_{h+s₁}/E_h)(E_{h+s₂}/E_h) up to α^R, α = 18 c₁(y) -- THE SECTOR TWO-POINT FACTORIZATION, uniform in the side,
+  the clause's observable; the vacuum sector's mixture over the 64 twists and the between-sector term are the
+  assembly.  W = 0 (Dobrushin on a gauge theory's dual); the earning is the exact statement about the enumerators.
+  No sorry, no axiom, no native_decide.
+-/
+import Mathlib
+import Aperanton.Dobrushin
+import Aperanton.Z2Slab
+import Aperanton.TorusL
+import Aperanton.TorusSysL
+import Aperanton.TorusLevels
+import Aperanton.TorusDecay
+
+open Finset
+
+namespace Aperanton
+
+namespace TorusL
+
+/-- the parity of the twisted system is the untwisted parity plus the shift -/
+theorem par_shift (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) :
+    (torusSys L (h + s) y hy0 hy1).par i ω = (torusSys L h y hy0 hy1).par i ω + s i := by
+  rw [par_eq, par_eq, Pi.add_apply]
+  ring
+
+/-- a cube adjacent to no plaquette i leaves the parity at i unchanged -/
+theorem par_update_far (L : ℕ) (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (i : Fin (nPlaq L)) (k : Fin (nCubes L)) (hm : cubeMult L i k = 0) (ω : Fin (nCubes L) → Z2) (x : Z2) :
+    (torusSys L h y hy0 hy1).par i (Function.update ω k x) = (torusSys L h y hy0 hy1).par i ω := by
+  rw [Z2Sys.par_update]
+  have hz : ((torusSys L h y hy0 hy1).mult i k : ZMod 2) = 0 := by
+    show ((cubeMult L i k : ℕ) : ZMod 2) = 0
+    rw [hm, Nat.cast_zero]
+  rw [hz, zero_mul, add_zero]
+
+/-- the factor ratio at a plaquette: the twisted factor over the untwisted one -/
+noncomputable def ratioAt (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (i : Fin (nPlaq L)) (ω : Fin (nCubes L) → Z2) : ℝ :=
+  (torusSys L (h + s) y hy0 hy1).w i ω / (torusSys L h y hy0 hy1).w i ω
+
+/-- the ratio in terms of the untwisted parity and the shift -/
+theorem ratioAt_eq (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) :
+    ratioAt L h s y hy0 hy1 i ω = (if (torusSys L h y hy0 hy1).par i ω + s i = 1 then y else 1) /
+      (if (torusSys L h y hy0 hy1).par i ω = 1 then y else 1) := by
+  unfold ratioAt Z2Sys.w
+  rw [par_shift, torusSys_y, torusSys_y]
+
+theorem ratioAt_pos (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) : 0 < ratioAt L h s y hy0 hy1 i ω :=
+  div_pos ((torusSys L (h + s) y hy0 hy1).w_pos i ω) ((torusSys L h y hy0 hy1).w_pos i ω)
+
+/-- THE SHIFT OBSERVABLE IS THE PRODUCT OF THE RATIOS -/
+theorem shiftObs_eq_prod (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (ω : Fin (nCubes L) → Z2) : shiftObs L h s y hy0 hy1 ω = ∏ i, ratioAt L h s y hy0 hy1 i ω := by
+  unfold shiftObs ratioAt Z2Sys.W
+  rw [Finset.prod_div_distrib]
+
+theorem shiftObs_pos (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (ω : Fin (nCubes L) → Z2) : 0 < shiftObs L h s y hy0 hy1 ω :=
+  div_pos ((torusSys L (h + s) y hy0 hy1).W_pos ω) ((torusSys L h y hy0 hy1).W_pos ω)
+
+/-- outside the support the ratio is one -/
+theorem ratioAt_of_zero (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (i : Fin (nPlaq L)) (ω : Fin (nCubes L) → Z2) (hs : s i = 0) : ratioAt L h s y hy0 hy1 i ω = 1 := by
+  rw [ratioAt_eq, hs, add_zero]
+  have hpos : 0 < (if (torusSys L h y hy0 hy1).par i ω = 1 then y else 1) := by split_ifs <;> linarith
+  exact div_self hpos.ne'
+
+/-- a cube adjacent to no plaquette of the support leaves the ratio at every plaquette unchanged -/
+theorem ratioAt_update_far (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (k : Fin (nCubes L)) (hk : ∀ i, s i ≠ 0 → cubeMult L i k = 0) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) (x : Z2) :
+    ratioAt L h s y hy0 hy1 i (Function.update ω k x) = ratioAt L h s y hy0 hy1 i ω := by
+  by_cases hs : s i = 0
+  · rw [ratioAt_of_zero L h s y hy0 hy1 i _ hs, ratioAt_of_zero L h s y hy0 hy1 i ω hs]
+  · rw [ratioAt_eq, ratioAt_eq, par_update_far L h y hy0 hy1 i k (hk i hs)]
+
+/-- Dobrushin's `hfree`: THE SHIFT OBSERVABLE IS UNCHANGED BY A FAR CUBE'S UPDATE -/
+theorem shiftObs_update_of_far (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (k : Fin (nCubes L)) (hk : ∀ i, s i ≠ 0 → cubeMult L i k = 0) (ω : Fin (nCubes L) → Z2) (x : Z2) :
+    shiftObs L h s y hy0 hy1 (Function.update ω k x) = shiftObs L h s y hy0 hy1 ω := by
+  rw [shiftObs_eq_prod, shiftObs_eq_prod]
+  exact Finset.prod_congr rfl fun i _ => ratioAt_update_far L h s y hy0 hy1 k hk i ω x
+
+/-- a ratio is at most one outside the support and at most 1/y on it -/
+theorem ratioAt_le (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (i : Fin (nPlaq L))
+    (ω : Fin (nCubes L) → Z2) : ratioAt L h s y hy0 hy1 i ω ≤ if s i = 0 then 1 else 1 / y := by
+  by_cases hs : s i = 0
+  · rw [if_pos hs, ratioAt_of_zero L h s y hy0 hy1 i ω hs]
+  · rw [if_neg hs, ratioAt_eq]
+    have hnum : (if (torusSys L h y hy0 hy1).par i ω + s i = 1 then y else 1) ≤ 1 := by split_ifs <;> linarith
+    have hden : y ≤ (if (torusSys L h y hy0 hy1).par i ω = 1 then y else 1) := by split_ifs <;> linarith
+    have hdpos : 0 < (if (torusSys L h y hy0 hy1).par i ω = 1 then y else 1) := by split_ifs <;> linarith
+    rw [div_le_div_iff₀ hdpos hy0]
+    nlinarith [mul_le_mul_of_nonneg_right hnum hy0.le, hden]
+
+/-- THE SHIFT OBSERVABLE IS AT MOST (1/y)^|supp s| -/
+theorem shiftObs_le (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (ω : Fin (nCubes L) → Z2) : shiftObs L h s y hy0 hy1 ω ≤ (1 / y) ^ wt s := by
+  rw [shiftObs_eq_prod]
+  calc ∏ i, ratioAt L h s y hy0 hy1 i ω ≤ ∏ i, (if s i = 0 then (1 : ℝ) else 1 / y) :=
+        Finset.prod_le_prod₀ (fun i _ => (ratioAt_pos L h s y hy0 hy1 i ω).le)
+          (fun i _ => ratioAt_le L h s y hy0 hy1 i ω)
+    _ = (1 / y) ^ wt s := by
+        rw [Finset.prod_ite, Finset.prod_const_one, one_mul, Finset.prod_const]
+        congr 1
+
+/-- the oscillation mass of the shift observable: 2 (1/y)^|supp s| at every cube adjacent to the support, 0 elsewhere -/
+noncomputable def dOf (L : ℕ) (s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (k : Fin (nCubes L)) : ℝ :=
+  if ∃ i, s i ≠ 0 ∧ cubeMult L i k ≠ 0 then 2 * (1 / y) ^ wt s else 0
+
+/-- Dobrushin's `OscBound` for the shift observable -/
+theorem shiftObs_oscBound (L : ℕ) (h s : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) :
+    OscBound (shiftObs L h s y hy0 hy1) (dOf L s y) := by
+  intro k ω g g'
+  unfold dOf
+  split_ifs with hadj
+  · have ha := shiftObs_le L h s y hy0 hy1 (Function.update ω k g)
+    have hb := shiftObs_le L h s y hy0 hy1 (Function.update ω k g')
+    have ha0 := (shiftObs_pos L h s y hy0 hy1 (Function.update ω k g)).le
+    have hb0 := (shiftObs_pos L h s y hy0 hy1 (Function.update ω k g')).le
+    calc |shiftObs L h s y hy0 hy1 (Function.update ω k g) - shiftObs L h s y hy0 hy1 (Function.update ω k g')|
+        ≤ |shiftObs L h s y hy0 hy1 (Function.update ω k g)| + |shiftObs L h s y hy0 hy1 (Function.update ω k g')| :=
+          abs_sub _ _
+      _ ≤ 2 * (1 / y) ^ wt s := by
+          rw [abs_of_nonneg ha0, abs_of_nonneg hb0]
+          linarith
+  · push_neg at hadj
+    rw [shiftObs_update_of_far L h s y hy0 hy1 k hadj, shiftObs_update_of_far L h s y hy0 hy1 k hadj, sub_self,
+      abs_zero]
+
+/-- THE SHIFT OBSERVABLE IS MULTIPLICATIVE OVER DISJOINT SUPPORTS -/
+theorem shiftObs_add (L : ℕ) (h s₁ s₂ : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1)
+    (hdisj : ∀ i, s₁ i = 0 ∨ s₂ i = 0) (ω : Fin (nCubes L) → Z2) :
+    shiftObs L h (s₁ + s₂) y hy0 hy1 ω = shiftObs L h s₁ y hy0 hy1 ω * shiftObs L h s₂ y hy0 hy1 ω := by
+  rw [shiftObs_eq_prod, shiftObs_eq_prod, shiftObs_eq_prod, ← Finset.prod_mul_distrib]
+  refine Finset.prod_congr rfl fun i _ => ?_
+  have hpos : 0 < (if (torusSys L h y hy0 hy1).par i ω = 1 then y else 1) := by split_ifs <;> linarith
+  rcases hdisj i with h1 | h2
+  · rw [ratioAt_eq, ratioAt_eq, ratioAt_eq, Pi.add_apply, h1, zero_add, add_zero, div_self hpos.ne', one_mul]
+  · rw [ratioAt_eq, ratioAt_eq, ratioAt_eq, Pi.add_apply, h2, add_zero, add_zero, div_self hpos.ne', mul_one]
+
+/-- THE SECTOR TWO-POINT DECAY AT ANY SIDE: for plaquette sets s₂ near the wall (its cubes at levels ≤ a) and s₁ far
+(its cubes at levels ≥ a + R), disjoint, the sector's shift expectation factorizes up to α^R -/
+theorem sector_two_point (L mu : ℕ) (hadj : AdjList L mu)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (hy : (17 : ℝ) / 19 < y)
+    (s₁ s₂ : Fin (nPlaq L) → ZMod 2) (hdisj : ∀ i, s₁ i = 0 ∨ s₂ i = 0) (a R : ℕ)
+    (hnear : ∀ k, (∃ i, s₂ i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L mu k ≤ a)
+    (hfar : ∀ k, (∃ i, s₁ i ≠ 0 ∧ cubeMult L i k ≠ 0) → a + R ≤ levelAt L mu k) :
+    |gibbs (torusSys L h y hy0 hy1).W (shiftObs L h (s₁ + s₂) y hy0 hy1) -
+        gibbs (torusSys L h y hy0 hy1).W (shiftObs L h s₁ y hy0 hy1) *
+          gibbs (torusSys L h y hy0 hy1).W (shiftObs L h s₂ y hy0 hy1)| ≤
+      gibbs (torusSys L h y hy0 hy1).W (shiftObs L h s₁ y hy0 hy1) *
+        ((∑ t, if (∃ i, s₁ i ≠ 0 ∧ cubeMult L i t ≠ 0) then (1 : ℝ) else 0) * (∑ t, dOf L s₂ y t) *
+          alpha y ^ R / (1 - alpha y)) := by
+  have hprod : (fun ω => shiftObs L h s₂ y hy0 hy1 ω * shiftObs L h s₁ y hy0 hy1 ω)
+      = shiftObs L h (s₁ + s₂) y hy0 hy1 := by
+    funext ω
+    rw [shiftObs_add L h s₁ s₂ y hy0 hy1 hdisj ω, mul_comm]
+  have hmain := sector_cov_le L mu hadj hdeg hsix h y hy0 hy1 hy (shiftObs L h s₂ y hy0 hy1) (dOf L s₂ y)
+    (shiftObs_oscBound L h s₂ y hy0 hy1) a R
+    (fun t ht => by
+      have hne : ¬ ∃ i, s₂ i ≠ 0 ∧ cubeMult L i t ≠ 0 := fun hex => by
+        have := hnear t hex
+        omega
+      simp [dOf, hne])
+    (shiftObs L h s₁ y hy0 hy1) (shiftObs_pos L h s₁ y hy0 hy1) (fun t => ∃ i, s₁ i ≠ 0 ∧ cubeMult L i t ≠ 0)
+    (fun t ht ω x => by
+      push_neg at ht
+      exact shiftObs_update_of_far L h s₁ y hy0 hy1 t ht ω x)
+    (fun t ht hex => by
+      have := hfar t hex
+      omega)
+  rw [hprod, mul_comm (gibbs (torusSys L h y hy0 hy1).W (shiftObs L h s₂ y hy0 hy1))] at hmain
+  exact hmain
+
+open Classical in
+/-- THE SECTOR TWO-POINT FACTORIZATION OF THE ENUMERATORS: E_{h+s₁+s₂}/E_h parts from (E_{h+s₁}/E_h)(E_{h+s₂}/E_h) by
+at most (E_{h+s₁}/E_h)(#cubes of s₁)(Σ dOf s₂) α^R/(1 − α) -/
+theorem sector_two_point_enum (L mu : ℕ) (hadj : AdjList L mu)
+    (hdeg : ∀ i : Fin (nPlaq L),
+      (univ.filter (fun k : Fin (nCubes L) => ((cubeMult L i k : ℕ) : ZMod 2) = 1)).card = 4)
+    (hsix : ∀ s : Fin (nCubes L),
+      (univ.filter (fun i : Fin (nPlaq L) => ((cubeMult L i s : ℕ) : ZMod 2) = 1)).card = 6)
+    (h : Fin (nPlaq L) → ZMod 2) (y : ℝ) (hy0 : 0 < y) (hy1 : y ≤ 1) (hy : (17 : ℝ) / 19 < y)
+    (s₁ s₂ : Fin (nPlaq L) → ZMod 2) (hdisj : ∀ i, s₁ i = 0 ∨ s₂ i = 0) (a R : ℕ)
+    (hnear : ∀ k, (∃ i, s₂ i ≠ 0 ∧ cubeMult L i k ≠ 0) → levelAt L mu k ≤ a)
+    (hfar : ∀ k, (∃ i, s₁ i ≠ 0 ∧ cubeMult L i k ≠ 0) → a + R ≤ levelAt L mu k) :
+    |sectorExp (LinearMap.range (cobdDual L)) y h (s₁ + s₂) -
+        sectorExp (LinearMap.range (cobdDual L)) y h s₁ * sectorExp (LinearMap.range (cobdDual L)) y h s₂| ≤
+      sectorExp (LinearMap.range (cobdDual L)) y h s₁ *
+        ((∑ t, if (∃ i, s₁ i ≠ 0 ∧ cubeMult L i t ≠ 0) then (1 : ℝ) else 0) * (∑ t, dOf L s₂ y t) *
+          alpha y ^ R / (1 - alpha y)) := by
+  rw [sectorExp_eq_gibbs L h (s₁ + s₂) y hy0 hy1, sectorExp_eq_gibbs L h s₁ y hy0 hy1,
+    sectorExp_eq_gibbs L h s₂ y hy0 hy1]
+  exact sector_two_point L mu hadj hdeg hsix h y hy0 hy1 hy s₁ s₂ hdisj a R hnear hfar
+
+end TorusL
+
+end Aperanton
