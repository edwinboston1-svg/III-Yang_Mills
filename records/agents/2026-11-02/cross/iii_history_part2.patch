+          rw [hE, Real.exp_sub, Real.exp_neg]
+          field_simp
+      _ ≤ 2 * tv p q * (Real.exp (2 * o) - 1) * ptiltZ p ρ := by
+          apply mul_le_mul_of_nonneg_left hZplo
