  (List.range N).foldl (fun c w12 => (List.range N).foldl (fun c w13 => (List.range N).foldl (fun c w14 =>
    (List.range N).foldl (fun c w23 => (List.range N).foldl (fun c w24 => (List.range N).foldl (fun c w34 =>
      if (w12 * w34 + (N - 1) * w13 * w24 + w14 * w23) % N == 0 then c + 1 else c) c) c) c) c) c) 0
